# OPTIONAL override for the live GitHub stats endpoint. The deployed worker URL
# is already baked into GithubStats.tsx as the default, so you only need this to
# point at a different worker (e.g. a local `wrangler dev` instance).
PUBLIC_GITHUB_STATS_URL=https://snazzie-github-stats.snazzieops.workers.dev

# OPTIONAL override for the live traffic stats endpoint (Cloudflare Web
# Analytics, served by the same worker at /traffic). Defaults to the deployed
# worker URL baked into useTraffic.ts. Point at a local `wrangler dev` instance
# to test, e.g. http://localhost:8787/traffic.
PUBLIC_TRAFFIC_STATS_URL=https://snazzie-github-stats.snazzieops.workers.dev/traffic
