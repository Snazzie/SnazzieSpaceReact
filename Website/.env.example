# OPTIONAL overrides for the live stats endpoints. The deployed worker URL is
# already baked into the components as the default, so you only need these to
# point at a different worker (e.g. a local `wrangler dev` instance).
#
# Both feeds are served by the one `snazzie-github-stats` worker (Hono-routed):
#   /ghstats    -> GitHub profile stats
#   /analytics  -> snazzie.space traffic
PUBLIC_GITHUB_STATS_URL=https://snazzie-github-stats.snazzieops.workers.dev/ghstats
PUBLIC_TRAFFIC_STATS_URL=https://snazzie-github-stats.snazzieops.workers.dev/analytics
