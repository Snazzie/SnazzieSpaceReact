---
import TagList from './TagList.astro';

export interface Props {
  title: string;
  excerpt: string;
  date: Date;
  tags: string[];
  slug: string;
  heroImage?: string;
}

const { title, excerpt, date, tags, slug, heroImage } = Astro.props;

const formattedDate = date.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="group">
  <a href={`/articles/${slug}/`} class="block" aria-label={title}>
    {heroImage && (
      <div class="aspect-[16/9] rounded-xl overflow-hidden mb-4 border border-white/10">
        <img
          src={heroImage}
          alt={`Cover image for ${title}`}
          class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
          loading="lazy"
        />
      </div>
    )}
    <div class="space-y-2">
      <time class="text-xs text-white/50" datetime={date.toISOString()}>
        {formattedDate}
      </time>
      <h2 class="text-base font-semibold text-white group-hover:text-white/80 transition-colors leading-snug">
        {title}
      </h2>
      <p class="text-sm text-white/60 leading-relaxed line-clamp-2">
        {excerpt}
      </p>
    </div>
  </a>
  <div class="mt-3">
    <TagList tags={tags} />
  </div>
</article>
