---
// All 14 microbenchmark results, higher is better (throughput).
// Source: RepoFlow "Node.js vs Deno vs Bun Performance Benchmarks", Feb 2026.
// RUNTIME_BENCH_DATA scraped from the source page. Order: [Node, Deno, Bun].
const runtimes = [
  { name: 'Node', colour: '#339933' },
  { name: 'Deno', colour: '#60A5FA' },
  { name: 'Bun', colour: '#FF6164' },
];

const tests = [
  { label: 'HTTP GET throughput', unit: 'req/s', v: [29741, 32632, 146328] },
  { label: 'JSON.parse 1KB', unit: 'ops/s', v: [1665362, 1712171, 3401606] },
  { label: 'JSON.parse 100KB', unit: 'ops/s', v: [34915, 35114, 150249] },
  { label: 'JSON.stringify small', unit: 'ops/s', v: [3939425, 4269232, 3685125] },
  { label: 'JSON.stringify medium', unit: 'ops/s', v: [81640, 82826, 134716] },
  { label: 'SHA-256 1KB', unit: 'ops/s', v: [89542, 78944, 87877] },
  { label: 'SHA-256 64KB', unit: 'ops/s', v: [13254, 14295, 15209] },
  { label: 'Buffer copy 64KB', unit: 'ops/s', v: [806057, 823959, 804862] },
  { label: 'Array map + reduce', unit: 'ops/s', v: [1008, 1005, 2634] },
  { label: 'String concat', unit: 'ops/s', v: [49795106, 57551191, 106847139] },
  { label: 'Integer loop arithmetic', unit: 'ops/s', v: [1347072721, 1442651876, 1341857852] },
  { label: 'Integer loop randomized', unit: 'ops/s', v: [90651992, 90395696, 93172946] },
  { label: 'Microtask chain', unit: 'ops/s', v: [56989, 60535, 42022] },
  { label: 'Async / await', unit: 'ops/s', v: [13171723, 14448474, 12032246] },
];

function fmt(n: number): string {
  if (n >= 1e9) return (n / 1e9).toFixed(n >= 1e10 ? 0 : 2) + 'B';
  if (n >= 1e6) return (n / 1e6).toFixed(n >= 1e8 ? 0 : 1) + 'M';
  if (n >= 1e3) return (n / 1e3).toFixed(n >= 1e5 ? 0 : 1) + 'k';
  return String(n);
}

const chartW = 660;
const labelW = 150;
const trackX = labelW + 8;
const valW = 60;
const trackW = chartW - trackX - valW;
const barH = 9;
const barGap = 3;
const groupGap = 14;
const groupH = runtimes.length * (barH + barGap) - barGap;
const padT = 6;
const rowH = groupH + groupGap;
const chartH = padT + tests.length * rowH;
---

<figure
  class="my-8 not-prose rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-5"
  role="img"
  aria-label="Grouped bar chart of all 14 microbenchmarks, throughput per runtime (Node, Deno, Bun). Bars are normalised to the fastest runtime in each test. Bun wins 8, Deno 5, Node 1."
>
  <div class="mb-3 flex items-center justify-between gap-4">
    <div class="text-sm font-medium text-white/80">All 14 results <span class="text-white/45">(higher is better)</span></div>
    <div class="flex flex-wrap gap-x-3 gap-y-1 text-xs">
      {runtimes.map((r) => (
        <span class="inline-flex items-center gap-1.5 text-white/70">
          <span class="inline-block h-2 w-2.5 rounded-sm" style={`background:${r.colour}`}></span>{r.name}
        </span>
      ))}
    </div>
  </div>

  <svg viewBox={`0 0 ${chartW} ${chartH}`} class="w-full h-auto select-none" xmlns="http://www.w3.org/2000/svg">
    {tests.map((t, ti) => {
      const top = padT + ti * rowH;
      const max = Math.max(...t.v);
      const winIdx = t.v.indexOf(max);
      return (
        <g>
          <text x={0} y={top + groupH / 2 + 4} fill="rgba(255,255,255,0.8)" font-size="12" font-family="system-ui, sans-serif">{t.label}</text>
          {t.v.map((val, ri) => {
            const by = top + ri * (barH + barGap);
            const w = Math.max((val / max) * trackW, 1.5);
            const isWin = ri === winIdx;
            return (
              <g>
                <rect x={trackX} y={by} width={trackW} height={barH} rx={2} fill="rgba(255,255,255,0.04)" />
                <rect x={trackX} y={by} width={w} height={barH} rx={2} fill={runtimes[ri].colour} opacity={isWin ? 1 : 0.55} />
                <text x={trackX + w + 5} y={by + barH - 1} fill={isWin ? 'rgba(255,255,255,0.95)' : 'rgba(255,255,255,0.5)'} font-size="9.5" font-family="system-ui, monospace" font-weight={isWin ? 600 : 400}>{fmt(val)}</text>
              </g>
            );
          })}
        </g>
      );
    })}
  </svg>

  <figcaption class="mt-3 text-center text-sm text-white/55">
    Throughput per test, bars normalised to the fastest runtime in each row. Apple M4. Node 25.6.1, Deno 2.6.9, Bun 1.3.9. Source: <a
      href="https://www.repoflow.io/blog/node-js-vs-deno-vs-bun-performance-benchmarks"
      class="underline underline-offset-2 hover:text-white/80">RepoFlow, Feb 2026</a>.
  </figcaption>
</figure>
