---
// Tests won (of 14 microbenchmarks) per runtime.
// Source: RepoFlow, "Node.js vs Deno vs Bun Performance Benchmarks", Feb 2026.
// Conditions: Apple M4, Node 25.6.1 / Deno 2.6.9 / Bun 1.3.9, p50 of 15 runs.
const TOTAL = 14;
const rows = [
  { name: 'Bun', wins: 8, colour: '#f9c80e' },
  { name: 'Deno', wins: 5, colour: '#7dd3fc' },
  { name: 'Node', wins: 1, colour: '#6ee7b7' },
];

const chartW = 660;
const rowH = 56;
const padT = 16;
const padB = 8;
const labelW = 64;
const valW = 92;
const trackX = labelW + 12;
const trackW = chartW - trackX - valW;
const chartH = padT + rows.length * rowH + padB;
---

<figure
  class="my-8 not-prose rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-5"
  role="img"
  aria-label="Bar chart: microbenchmark tests won out of 14. Bun won 8, Deno won 5, Node won 1. Source: RepoFlow, February 2026."
>
  <div class="mb-4 text-sm font-medium text-white/80">Microbenchmark tests won (of {TOTAL})</div>

  <svg viewBox={`0 0 ${chartW} ${chartH}`} class="w-full h-auto select-none" xmlns="http://www.w3.org/2000/svg">
    {rows.map((r, i) => {
      const cy = padT + i * rowH;
      const barH = 30;
      const barY = cy + (rowH - barH) / 2 - padB;
      const w = (r.wins / TOTAL) * trackW;
      return (
        <g>
          <text
            x={labelW}
            y={barY + barH / 2 + 5}
            text-anchor="end"
            fill="rgba(255,255,255,0.85)"
            font-size="15"
            font-family="system-ui, sans-serif"
            font-weight="600"
          >{r.name}</text>
          <rect x={trackX} y={barY} width={trackW} height={barH} rx={6} fill="rgba(255,255,255,0.05)" />
          <rect x={trackX} y={barY} width={w} height={barH} rx={6} fill={r.colour} />
          <text
            x={trackX + w + 12}
            y={barY + barH / 2 + 5}
            fill="rgba(255,255,255,0.9)"
            font-size="14"
            font-family="system-ui, monospace"
          >{r.wins} / {TOTAL}</text>
        </g>
      );
    })}
  </svg>

  <figcaption class="mt-3 text-center text-sm text-white/55">
    14 microbenchmarks, same code, Apple M4. Node 25.6.1, Deno 2.6.9, Bun 1.3.9. Source: <a
      href="https://www.repoflow.io/blog/node-js-vs-deno-vs-bun-performance-benchmarks"
      class="underline underline-offset-2 hover:text-white/80">RepoFlow, Feb 2026</a>.
  </figcaption>
</figure>
