        <!-- A2: mobile app feed -->
        <svg viewBox="0 0 160 210" style="width:100%;display:block;opacity:.18" aria-hidden="true"><rect x="22" y="0" width="116" height="210" rx="14" fill="none" stroke="rgba(255,255,255,.4)" stroke-width="1"/><rect x="62" y="5" width="36" height="3" rx="1.5" fill="rgba(255,255,255,.14)"/><rect x="30" y="16" width="40" height="6" rx="2" fill="rgba(198,244,50,.5)"/><circle cx="124" cy="19" r="5" fill="none" stroke="rgba(255,255,255,.14)" stroke-width="1"/><line x1="30" y1="30" x2="130" y2="30" stroke="rgba(255,255,255,.08)" stroke-width="1"/><circle cx="38" cy="44" r="7" fill="none" stroke="rgba(255,255,255,.14)" stroke-width="1"/><rect x="50" y="40" width="44" height="4" rx="2" fill="rgba(255,255,255,.14)"/><rect x="50" y="47" width="30" height="3" rx="1.5" fill="rgba(255,255,255,.07)"/><rect x="30" y="58" width="100" height="40" rx="4" fill="rgba(255,255,255,.03)" stroke="rgba(255,255,255,.12)" stroke-width="1"/><line x1="30" y1="58" x2="130" y2="98" stroke="rgba(255,255,255,.1)" stroke-width="1"/><line x1="130" y1="58" x2="30" y2="98" stroke="rgba(255,255,255,.1)" stroke-width="1"/><rect x="30" y="104" width="80" height="4" rx="2" fill="rgba(255,255,255,.1)"/><rect x="30" y="111" width="60" height="4" rx="2" fill="rgba(255,255,255,.06)"/><circle cx="35" cy="124" r="3" fill="rgba(198,244,50,.5)"/><circle cx="46" cy="124" r="3" fill="none" stroke="rgba(255,255,255,.12)" stroke-width="1"/><circle cx="57" cy="124" r="3" fill="none" stroke="rgba(255,255,255,.12)" stroke-width="1"/><line x1="30" y1="136" x2="130" y2="136" stroke="rgba(255,255,255,.06)" stroke-width="1"/><circle cx="38" cy="150" r="7" fill="none" stroke="rgba(255,255,255,.14)" stroke-width="1"/><rect x="50" y="146" width="50" height="4" rx="2" fill="rgba(255,255,255,.14)"/><rect x="50" y="153" width="34" height="3" rx="1.5" fill="rgba(255,255,255,.07)"/><rect x="30" y="164" width="100" height="24" rx="4" fill="rgba(255,255,255,.03)" stroke="rgba(255,255,255,.1)" stroke-width="1"/><line x1="30" y1="196" 