    <div id="snz-wbg" style="position:absolute;inset:0;z-index:0;pointer-events:none;display:flex;gap:18px;padding:0 14px;align-items:flex-start;opacity:0.12;overflow:hidden">
      <div style="position:absolute;inset:0;background:linear-gradient(to bottom,#0b0b0b 0%,transparent 12%,transparent 88%,#0b0b0b 100%);z-index:1;pointer-events:none"></div>
      <!-- col A -->
      <div class="snz-bf-col snz-bf-col-a" style="margin-top:-40px">
