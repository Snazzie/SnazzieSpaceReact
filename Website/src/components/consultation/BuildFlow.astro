          <line x1="92" y1="196" x2="908" y2="196" stroke="rgba(255,255,255,.1)" stroke-width="1"></line>
          <line x1="500" y1="210" x2="500" y2="556" stroke="rgba(255,255,255,.08)" stroke-width="1"></line>
