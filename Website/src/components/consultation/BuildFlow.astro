<script>
  // Scroll-driven flow animation for THE BUILD. Ported from the design prototype,
  // driven off window scroll position over the tall #snz-build section.
  type El = HTMLElement & SVGElement;
  const $ = (id: string) => document.getElementById(id) as unknown as El | null;

  const sec = $('snz-build');
  const svg = $('snz-flow');
  if (sec && svg) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const wfStroke = Array.from(svg.querySelectorAll('#fWire [data-wf]')) as unknown as El[];
    const wfPop = Array.from(svg.querySelectorAll('#fWire [data-wfp]')) as unknown as El[];
    wfStroke.forEach((e) => { e.style.strokeDasharray = '1'; });

    const camera = $('camera');
    const wire = $('fWire'), phone = $('fPhone'), gCore = $('gCore'), gApi = $('gApi'), gApiCard = $('gApiCard'), gDb = $('gDb'), gCache = $('gCache');
    const apiBox = $('apiBox');
    const mAcc = $('mAccounts'), mPay = $('mPayments'), mAgent = $('mAgent'), mCms = $('mCMS'), mEcom = $('mEcom');
    const cnApi = $('cnApi'), ciAcc = $('ciAcc'), ciPay = $('ciPay'), ciAgent = $('ciAgent'), ciCms = $('ciCms'), ciEcom = $('ciEcom'), ciDb = $('ciDb'), ciCache = $('ciCache');
    const pkQ = $('pkQ'), pkC = $('pkC'), pkReq = $('pkReq');
    const accShield = $('accShield'), accCheck = $('accCheck'), accShieldFill = $('accShieldFill'), cacheHit = $('cacheHit');
    const customers = $('customers'), custNum = $('custNum');
    const custDots = Array.from(svg.querySelectorAll('#customers .cust')) as unknown as El[];
    const bizTitle = $('bizTitle'), bizNum = $('bizNum'), bizSize = $('bizSize');
    const gAnalytics = $('gAnalytics');
    const ciProdAn = $('ciProdAn'), ciApiAn = $('ciApiAn');
    const ciProdAnPulse = $('ciProdAnPulse'), ciApiAnPulse = $('ciApiAnPulse');
    const scSqs = [0,1,2,3,4,5,6,7,8].map(i => $('gsq' + i));
    const cbBars = [$('cb0'), $('cb1'), $('cb2'), $('cb3'), $('cb4'), $('cb5'), $('cb6'), $('cb7')];
    const anChart = $('anChart');
    const anHeat = $('anHeat'), anSearch = $('anSearch'), anRev = $('anRev');
    const caps = [$('cap1'), $('cap2'), $('cap3'), $('cap4'), $('cap5'), $('cap6')];
    const track = [$('tk1'), $('tk2'), $('tk3'), $('tk4'), $('tk5'), $('tk6')];
    const prog = $('fProg');
    [accShield, accCheck, cnApi, ciAcc, ciPay, ciAgent, ciCms, ciEcom, ciDb, ciCache, anChart].forEach((e) => {
      if (e) { e.style.strokeDasharray = '1'; e.style.strokeDashoffset = '1'; }
    });

    // build analytics sub-charts (heatmap + impression/revenue bars)
    const NS = 'http://www.w3.org/2000/svg';
    const mk = (t: string, attrs: Record<string, string | number>) => {
      const e = document.createElementNS(NS, t);
      for (const k in attrs) e.setAttribute(k, String(attrs[k]));
      return e;
    };
    if (anHeat && !anHeat.childNodes.length) {
      const cols = 11, rows = 5, x0 = 520, y0 = 232, cw = 33, ch = 24, gx = 2, gy = 3;
      for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++) {
        const hot = Math.exp(-(Math.pow(c - 7, 2) / 9 + Math.pow(r - 1.6, 2) / 3.2));
        const noise = Math.abs((Math.sin(c * 12.9 + r * 78.2) * 43758.5453) % 1);
        const v = Math.max(0.05, Math.min(0.95, hot * 0.9 + noise * 0.18 + 0.05));
        anHeat.appendChild(mk('rect', { x: x0 + c * (cw + gx), y: y0 + r * (ch + gy), width: cw, height: ch, rx: 2, fill: 'var(--accent)', 'fill-opacity': v.toFixed(2) }));
      }
    }
    if (anSearch && !anSearch.childNodes.length) {
      const n = 14, x0 = 96, base = 502, bw = 18, step = 27, maxH = 64;
      for (let i = 0; i < n; i++) { const t = i / (n - 1); const h = (0.25 + 0.7 * t + 0.12 * Math.sin(i * 1.7)) * maxH; anSearch.appendChild(mk('rect', { x: x0 + i * step, y: base - h, width: bw, height: h, rx: 2, fill: 'rgba(198,244,50,.6)' })); }
    }
    if (anRev && !anRev.childNodes.length) {
      const n = 12, x0 = 524, base = 502, bw = 20, step = 32, maxH = 64;
      for (let i = 0; i < n; i++) { const t = i / (n - 1); const h = (0.22 + 0.72 * t + 0.1 * Math.sin(i * 2.1 + 1)) * maxH; anRev.appendChild(mk('rect', { x: x0 + i * step, y: base - h, width: bw, height: h, rx: 2, fill: 'var(--accent)' })); }
    }

    const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));
    const seg = (p: number, a: number, b: number) => clamp((p - a) / (b - a), 0, 1);
    const sm = (t: number) => t * t * (3 - 2 * t);
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

    const apply = (p: number) => {
      const draw = (el: El | null, d: number) => { if (el) { el.style.strokeDashoffset = String(1 - d); el.style.opacity = d > 0 ? '1' : '0'; } };
      const flow = (pk: El | null, c: number[], m: number[], a: number, b: number) => {
        if (!pk) return;
        const l = seg(p, a, b);
        const active = l > 0 && l < 1;
        const frac = l < 0.5 ? sm(l * 2) : 1 - sm((l - 0.5) * 2);
        pk.setAttribute('cx', lerp(c[0], m[0], frac).toFixed(1));
        pk.setAttribute('cy', lerp(c[1], m[1], frac).toFixed(1));
        pk.style.opacity = active ? '1' : '0';
      };

      // ---- CAMERA ----
      // 0.00-0.14: site+phone centered
      // 0.14-0.28: slight pull back as site exits
      // 0.28-0.46: ENGINE view — backend+children centered at (500,310)
      // 0.46-0.54: zoom out for side-by-side
      // 0.54-0.70: side-by-side, product left / backend right
      // 0.70-0.87: scale view
      // 0.87+: analytics
      const A = [[0, 500, 300, 1.0], [0.14, 500, 300, 1.0], [0.28, 500, 300, 1.0], [0.46, 500, 300, 1.0], [0.54, 500, 300, 0.88], [0.70, 500, 300, 0.88], [0.76, 500, 330, 0.95], [0.86, 500, 330, 0.95], [0.89, 500, 300, 1], [1.04, 500, 300, 1]];
      let fx = 500, fy = 300, k = 1;
      for (let i = 0; i < A.length - 1; i++) { if (p >= A[i][0] && p <= A[i + 1][0]) { const t = sm(seg(p, A[i][0], A[i + 1][0])); fx = lerp(A[i][1], A[i + 1][1], t); fy = lerp(A[i][2], A[i + 1][2], t); k = lerp(A[i][3], A[i + 1][3], t); break; } }
      if (camera) camera.setAttribute('transform', 'translate(' + (500 - k * fx).toFixed(1) + ' ' + (300 - k * fy).toFixed(1) + ') scale(' + k.toFixed(3) + ')');

      // ---- BUILD: site draws in ----
      const pWire = sm(seg(p, 0.0, 0.06));
      const phoneAppear = sm(seg(p, 0.04, 0.12));
      const n = wfStroke.length;
      wfStroke.forEach((e, i) => { e.style.strokeDashoffset = String(1 - clamp(pWire * n - i, 0, 1)); });
      wfPop.forEach((e, i) => { e.style.opacity = String(clamp(pWire * wfPop.length - i, 0, 1)); });

      // ---- SLIDE UP: site + phone exit upward ----
      const slideUp = sm(seg(p, 0.14, 0.27));
      const slideOff = slideUp * -700;
      if (wire) { wire.setAttribute('transform', 'translate(0 ' + slideOff.toFixed(1) + ')'); wire.style.opacity = String(pWire > 0 ? Math.max(0, 1 - slideUp * 1.5) : 0); }
      if (phone) { const ty = slideOff + lerp(20, 0, phoneAppear); phone.setAttribute('transform', 'translate(0 ' + ty.toFixed(1) + ')'); phone.style.opacity = String(Math.max(0, phoneAppear - slideUp * 1.5)); }

      // ---- BACKEND position ----
      // Enters from bottom, holds at center for ENGINE (incl. collapse), then slides right as small card
      const Banch = [[0, 500, 700], [0.14, 500, 700], [0.24, 500, 200], [0.53, 500, 200], [0.62, 660, 300], [0.70, 660, 300], [0.76, 660, 300], [1.04, 660, 300]];
      let bx = 700, by = 210;
      for (let i = 0; i < Banch.length - 1; i++) { if (p >= Banch[i][0] && p <= Banch[i + 1][0]) { const t = sm(seg(p, Banch[i][0], Banch[i + 1][0])); bx = lerp(Banch[i][1], Banch[i + 1][1], t); by = lerp(Banch[i][2], Banch[i + 1][2], t); break; } }

      // ---- ENGINE: children explode out from backend, then collapse back ----
      const e1 = sm(seg(p, 0.30, 0.42));
      const e2 = sm(seg(p, 0.46, 0.53));

      // ENGINE: full terminal fades in then shrinks as children explode; hidden after ENGINE
      const apiEnter = sm(seg(p, 0.14, 0.24));
      const apiTermScale = lerp(1.2, 0, e1);
      const apiTermOpac = apiEnter * lerp(1, 0, e1);
      if (gApi) { gApi.setAttribute('transform', 'translate(' + bx.toFixed(1) + ' ' + by.toFixed(1) + ') scale(' + apiTermScale.toFixed(3) + ')'); gApi.style.opacity = p < 0.53 ? apiTermOpac.toFixed(3) : '0'; }

      // CONNECT+: simple API card follows Banch (slides center → right)
      const apiCardShow = sm(seg(p, 0.54, 0.61));
      if (gApiCard) { gApiCard.setAttribute('transform', 'translate(' + bx.toFixed(1) + ' ' + by.toFixed(1) + ')'); gApiCard.style.opacity = apiCardShow.toFixed(3); }
      // Children grid centered at x=500: row1 (350/500/650 y=290), row2 (425/575 y=400), row3 (425/575 y=510)
      const kids = [
        { g: mAcc,   c: ciAcc,   gx: 350, gy: 290 },
        { g: mPay,   c: ciPay,   gx: 500, gy: 290 },
        { g: mAgent, c: ciAgent, gx: 650, gy: 290 },
        { g: mCms,   c: ciCms,   gx: 425, gy: 400 },
        { g: mEcom,  c: ciEcom,  gx: 575, gy: 400 },
        { g: gDb,    c: ciDb,    gx: 425, gy: 510 },
        { g: gCache, c: ciCache, gx: 575, gy: 510 },
      ];
      kids.forEach((o) => {
        let x = lerp(bx, o.gx, e1), y = lerp(by, o.gy, e1);
        x = lerp(x, bx, e2); y = lerp(y, by, e2);
        const scl = lerp(1, 0.1, e2);
        const appear = e1 * (1 - e2);
        if (o.g) { o.g.setAttribute('transform', 'translate(' + x.toFixed(1) + ' ' + y.toFixed(1) + ') scale(' + scl.toFixed(3) + ')'); o.g.style.opacity = appear.toFixed(3); }
        if (o.c) { o.c.setAttribute('x1', bx.toFixed(1)); o.c.setAttribute('y1', (by + 120).toFixed(1)); o.c.setAttribute('x2', x.toFixed(1)); o.c.setAttribute('y2', (y - 36).toFixed(1)); o.c.style.strokeDashoffset = String(1 - appear); o.c.style.opacity = (appear * 0.5).toFixed(3); }
      });
      draw(accShield, sm(seg(p, 0.34, 0.40)));
      draw(accCheck, sm(seg(p, 0.37, 0.43)));
      if (accShieldFill) accShieldFill.style.opacity = sm(seg(p, 0.41, 0.45)).toFixed(3);
      flow(pkQ, [500, 320], [425, 490], 0.42, 0.46);
      flow(pkC, [506, 320], [575, 490], 0.43, 0.47);
      if (cacheHit) cacheHit.style.opacity = (sm(seg(p, 0.43, 0.46)) * (1 - sm(seg(p, 0.47, 0.50)))).toFixed(3);

      // ---- CONNECT: product card left (280,300), backend right (700,300) ----
      const pSideBy = sm(seg(p, 0.54, 0.61));
      if (gCore) { gCore.setAttribute('transform', 'translate(340 300)'); gCore.style.opacity = pSideBy.toFixed(3); }
      if (cnApi) { const cv = sm(seg(p, 0.60, 0.66)); cnApi.setAttribute('x1', '432'); cnApi.setAttribute('y1', '300'); cnApi.setAttribute('x2', '568'); cnApi.setAttribute('y2', '300'); cnApi.style.strokeDashoffset = String(1 - cv); cnApi.style.opacity = (cv * 0.7).toFixed(3); }

      // ---- TRAFFIC → SCALE: business counter replaces users element ----
      const sIn = sm(seg(p, 0.59, 0.65));
      if (bizTitle) bizTitle.style.opacity = sIn.toFixed(3);
      const bn = sm(seg(p, 0.62, 0.88));
      let bsize: string, busers: number;
      if (bn < 0.4) { bsize = 'SMALL BUSINESS'; busers = 100 * Math.pow(10, bn / 0.4); }
      else if (bn < 0.74) { bsize = 'MEDIUM BUSINESS'; busers = 1000 * Math.pow(50, (bn - 0.4) / 0.34); }
      else { bsize = 'ENTERPRISE'; busers = 50000 * Math.pow(10, (bn - 0.74) / 0.26); }
      busers = Math.round(busers / 50) * 50;
      if (bizNum) bizNum.textContent = busers.toLocaleString('en-US') + ' users';
      if (bizSize) bizSize.textContent = bsize;

      // ---- SCALE: grid squares, analytics card, connectors, packets ----
      const gsGate = sm(seg(p, 0.72, 0.78));
      scSqs.forEach((s, i) => {
        if (!s) return;
        s.style.opacity = (gsGate * sm(seg(bn, i / 9, i / 9 + 0.18))).toFixed(2);
      });
      const anCardIn = sm(seg(p, 0.74, 0.80));
      if (gAnalytics) gAnalytics.style.opacity = anCardIn.toFixed(3);
      const ciPAv = sm(seg(p, 0.75, 0.81));
      if (ciProdAn) ciProdAn.style.opacity = ciPAv.toFixed(3);
      if (ciProdAnPulse) ciProdAnPulse.style.opacity = ciPAv.toFixed(3);
      const ciAAv = sm(seg(p, 0.76, 0.82));
      if (ciApiAn) { ciApiAn.setAttribute('x1', bx.toFixed(1)); ciApiAn.style.opacity = ciAAv.toFixed(3); }
      if (ciApiAnPulse) { ciApiAnPulse.setAttribute('x1', bx.toFixed(1)); ciApiAnPulse.style.opacity = ciAAv.toFixed(3); }

      // ---- DATA ----
      const an = sm(seg(p, 0.87, 0.93));
      if (camera) camera.style.opacity = (1 - an * 0.92).toFixed(3);
      const analytics = $('analytics');
      if (analytics) analytics.style.opacity = String(an);
      draw(anChart, sm(seg(p, 0.89, 0.99)));

      // ---- captions + tracker + progress ----
      // 0=BUILD 1=ENGINE 2=CONNECT 3=TRAFFIC 4=SCALE 5=DATA
      const phase = p < 0.18 ? 0 : (p < 0.56 ? 1 : (p < 0.68 ? 2 : (p < 0.76 ? 3 : (p < 0.88 ? 4 : 5))));
      caps.forEach((c, i) => { if (c) { c.style.opacity = i === phase ? '1' : '0'; c.style.transform = i === phase ? 'translateY(0)' : 'translateY(12px)'; } });
      track.forEach((t, i) => { if (t) t.style.color = i === phase ? 'var(--accent)' : '#4a4a44'; });
      if (prog) prog.style.width = (p * 100).toFixed(1) + '%';
    };

    if (reduce) {
      apply(0.60);
    } else {
      let lastP = -1, raf = 0;
      const update = () => {
        const r = sec.getBoundingClientRect();
        const vh = window.innerHeight || document.documentElement.clientHeight;
        const total = sec.offsetHeight - vh;
        const p = total > 0 ? Math.max(0, Math.min(1, -r.top / total)) : 0;
        if (Math.abs(p - lastP) > 0.0004) { lastP = p; apply(p); }
      };
      const tick = () => { update(); raf = requestAnimationFrame(tick); };
      raf = requestAnimationFrame(tick);
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update, { passive: true });
      apply(0);
    }
  }
</script>
