<section id="snz-build" style="position:relative;height:1360vh;background:#0b0b0b;border-bottom:1px solid rgba(255,255,255,.08)">
  <div id="snz-buildsticky" style="position:sticky;top:var(--snz-nav-h, 0px);height:calc(100vh - var(--snz-nav-h, 0px));overflow:hidden;display:flex;flex-direction:column">
