---
// THE BUILD — scroll-driven story: site + app merge into a product, the backend
// docks and explodes into modules, traffic arrives, it scales, then analytics.
---
<section id="snz-build" style="position:relative;height:760vh;background:#0b0b0b;border-bottom:1px solid rgba(255,255,255,.08)">
  <div style="position:sticky;top:0;height:100vh;overflow:hidden;display:flex;flex-direction:column">
    <!-- top bar -->
    <div id="snz-buildtop" style="display:flex;align-items:center;justify-content:space-between;padding:30px 56px 0">
      <div style="font:600 11px 'JetBrains Mono',monospace;letter-spacing:.2em;color:#7c7c74">[ THE BUILD ] — one builder, the whole stack</div>
      <div class="snz-track" style="display:flex;gap:13px;font:600 11px 'JetBrains Mono',monospace;letter-spacing:.06em">
        <span id="tk1" style="color:var(--accent);transition:color .4s ease">01 BUILD</span>
        <span id="tk2" style="color:#4a4a44;transition:color .4s ease">02 ENGINE</span>
        <span id="tk3" style="color:#4a4a44;transition:color .4s ease">03 CONNECT</span>
        <span id="tk4" style="color:#4a4a44;transition:color .4s ease">04 TRAFFIC</span>
        <span id="tk5" style="color:#4a4a44;transition:color .4s ease">05 SCALE</span>
        <span id="tk6" style="color:#4a4a44;transition:color .4s ease">06 DATA</span>
      </div>
    </div>
    <!-- stage -->
    <div style="flex:1;position:relative;display:flex;align-items:center;justify-content:center;padding:8px 40px 0">
      <svg id="snz-flow" viewBox="0 0 1000 600" style="width:100%;max-width:1120px;height:100%;max-height:72vh;overflow:visible" aria-hidden="true">
        <defs>
          <clipPath id="snzPhoneClip"><rect x="660" y="122" width="126" height="268" rx="4"></rect></clipPath>
          <!-- gradient pulses for traffic lines (x1/y1/x2/y2 animated via JS) -->
        </defs>
        <g id="camera">
        <!-- website wireframe -->
        <g id="fWire" opacity="0">
          <rect data-wf pathLength="1" x="150" y="120" width="404" height="300" rx="13" fill="none" stroke="rgba(255,255,255,.42)" stroke-width="2"></rect>
          <line data-wf pathLength="1" x1="150" y1="166" x2="554" y2="166" stroke="rgba(255,255,255,.28)" stroke-width="1.8"></line>
          <circle data-wfp cx="178" cy="143" r="5.5" fill="var(--accent)"></circle>
          <circle data-wfp cx="197" cy="143" r="5.5" fill="rgba(255,255,255,.3)"></circle>
          <circle data-wfp cx="216" cy="143" r="5.5" fill="rgba(255,255,255,.3)"></circle>
          <rect data-wf pathLength="1" x="184" y="192" width="150" height="20" rx="4" fill="none" stroke="rgba(255,255,255,.3)" stroke-width="1.6"></rect>
          <rect data-wf pathLength="1" x="184" y="224" width="336" height="96" rx="8" fill="rgba(198,244,50,.05)" stroke="var(--accent)" stroke-width="2.2"></rect>
          <text data-wfp x="206" y="280" fill="var(--accent)" font-family="JetBrains Mono,monospace" font-weight="600" font-size="18">YOUR SITE</text>
          <rect data-wf pathLength="1" x="184" y="338" width="104" height="66" rx="7" fill="none" stroke="rgba(255,255,255,.28)" stroke-width="1.6"></rect>
          <rect data-wf pathLength="1" x="300" y="338" width="104" height="66" rx="7" fill="none" stroke="rgba(255,255,255,.28)" stroke-width="1.6"></rect>
          <rect data-wf pathLength="1" x="416" y="338" width="104" height="66" rx="7" fill="none" stroke="rgba(255,255,255,.28)" stroke-width="1.6"></rect>
        </g>
        <!-- mobile app -->
        <g id="fPhone" opacity="0">
          <rect x="648" y="96" width="150" height="316" rx="26" fill="#0c0c0c" stroke="rgba(255,255,255,.5)" stroke-width="2"></rect>
          <rect x="660" y="122" width="126" height="268" rx="4" fill="#0e0e0e"></rect>
          <g clip-path="url(#snzPhoneClip)">
            <g style="animation:snz-appscroll 6s linear infinite">
              <rect x="668" y="126" width="110" height="30" rx="5" fill="rgba(198,244,50,.12)" stroke="var(--accent)" stroke-width="1"></rect>
              <text x="676" y="146" fill="var(--accent)" font-family="JetBrains Mono,monospace" font-weight="700" font-size="11">App</text>
              <rect x="668" y="164" width="110" height="62" rx="6" fill="rgba(198,244,50,.06)" stroke="var(--accent)" stroke-width="1"></rect>
              <rect x="668" y="236" width="110" height="22" rx="4" fill="rgba(255,255,255,.09)"></rect>
              <rect x="668" y="266" width="110" height="22" rx="4" fill="rgba(255,255,255,.09)"></rect>
              <rect x="668" y="296" width="110" height="22" rx="4" fill="rgba(255,255,255,.09)"></rect>
              <rect x="668" y="326" width="78" height="22" rx="4" fill="rgba(255,255,255,.09)"></rect>
              <rect x="668" y="366" width="110" height="30" rx="5" fill="rgba(198,244,50,.12)" stroke="var(--accent)" stroke-width="1"></rect>
              <text x="676" y="386" fill="var(--accent)" font-family="JetBrains Mono,monospace" font-weight="700" font-size="11">App</text>
              <rect x="668" y="404" width="110" height="62" rx="6" fill="rgba(198,244,50,.06)" stroke="var(--accent)" stroke-width="1"></rect>
              <rect x="668" y="476" width="110" height="22" rx="4" fill="rgba(255,255,255,.09)"></rect>
              <rect x="668" y="506" width="110" height="22" rx="4" fill="rgba(255,255,255,.09)"></rect>
              <rect x="668" y="536" width="110" height="22" rx="4" fill="rgba(255,255,255,.09)"></rect>
              <rect x="668" y="566" width="78" height="22" rx="4" fill="rgba(255,255,255,.09)"></rect>
            </g>
          </g>
          <rect x="700" y="104" width="46" height="9" rx="4.5" fill="rgba(255,255,255,.22)"></rect>
          <rect x="699" y="398" width="48" height="5" rx="2.5" fill="rgba(255,255,255,.3)"></rect>
        </g>
        <!-- customers (left only) — traffic as a number -->
        <g id="customers" opacity="0">
          <circle class="cust" cx="96" cy="232" r="6" fill="rgba(198,244,50,.5)"></circle>
          <circle class="cust" cx="150" cy="222" r="6" fill="rgba(198,244,50,.5)"></circle>
          <circle class="cust" cx="196" cy="238" r="6" fill="rgba(198,244,50,.5)"></circle>
          <circle class="cust" cx="80" cy="300" r="6" fill="rgba(198,244,50,.5)"></circle>
          <circle class="cust" cx="210" cy="300" r="6" fill="rgba(198,244,50,.5)"></circle>
          <circle class="cust" cx="96" cy="366" r="6" fill="rgba(198,244,50,.5)"></circle>
          <circle class="cust" cx="150" cy="378" r="6" fill="rgba(198,244,50,.5)"></circle>
          <circle class="cust" cx="196" cy="362" r="6" fill="rgba(198,244,50,.5)"></circle>
          <text id="custNum" x="145" y="312" text-anchor="middle" fill="var(--accent)" font-family="Archivo,sans-serif" font-weight="800" font-size="46" letter-spacing="-0.02em">0</text>
          <text x="145" y="338" text-anchor="middle" fill="#7c7c74" font-family="JetBrains Mono,monospace" font-weight="600" font-size="10" letter-spacing="1.5">USERS NOW</text>
          <circle id="pkReq" r="4.5" fill="var(--accent)" opacity="0"></circle>
        </g>
        <!-- connectors -->
        <line id="cnApi" x1="468" y1="286" x2="616" y2="214" pathLength="1" fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round" opacity="0"></line>
        <line id="ciAcc" x1="672" y1="250" x2="572" y2="304" pathLength="1" fill="none" stroke="rgba(255,255,255,.3)" stroke-width="1.5" opacity="0"></line>
        <line id="ciPay" x1="700" y1="250" x2="700" y2="298" pathLength="1" fill="none" stroke="rgba(255,255,255,.3)" stroke-width="1.5" opacity="0"></line>
        <line id="ciAgent" x1="728" y1="250" x2="828" y2="304" pathLength="1" fill="none" stroke="rgba(255,255,255,.3)" stroke-width="1.5" opacity="0"></line>
        <line id="ciCms" x1="688" y1="250" x2="636" y2="398" pathLength="1" fill="none" stroke="rgba(255,255,255,.3)" stroke-width="1.5" opacity="0"></line>
        <line id="ciEcom" x1="712" y1="250" x2="764" y2="398" pathLength="1" fill="none" stroke="rgba(255,255,255,.3)" stroke-width="1.5" opacity="0"></line>
        <line id="ciDb" x1="684" y1="250" x2="636" y2="502" pathLength="1" fill="none" stroke="rgba(255,255,255,.3)" stroke-width="1.5" opacity="0"></line>
        <line id="ciCache" x1="716" y1="250" x2="764" y2="502" pathLength="1" fill="none" stroke="rgba(255,255,255,.3)" stroke-width="1.5" opacity="0"></line>
        <circle id="pkApi" r="5" fill="var(--accent)" opacity="0"></circle>
        <circle id="pkQ" r="4.5" fill="var(--accent)" opacity="0"></circle>
        <circle id="pkC" r="4.5" fill="var(--accent)" opacity="0"></circle>
        <!-- backend card (used in CONNECT+ phases — simple label, no vector) -->
        <g id="gApiCard" opacity="0" transform="translate(700 300)">
          <rect x="-92" y="-48" width="184" height="96" rx="13" fill="#0c0c0c" stroke="var(--accent)" stroke-width="1.8"></rect>
          <text x="-30" y="6" text-anchor="middle" fill="#E9E7E1" font-family="Archivo,sans-serif" font-weight="800" font-size="22" letter-spacing="-0.02em">API</text>
          <text x="-30" y="36" text-anchor="middle" fill="var(--accent)" font-family="JetBrains Mono,monospace" font-weight="700" font-size="10" letter-spacing="1">BACKEND</text>
          <!-- scale grid: 3×3, appear progressively as bn grows -->
          <rect id="gsq0" x="4"  y="-28" width="16" height="14" rx="2" fill="var(--accent)" fill-opacity=".7" opacity="0"/>
          <rect id="gsq1" x="26" y="-28" width="16" height="14" rx="2" fill="var(--accent)" fill-opacity=".7" opacity="0"/>
          <rect id="gsq2" x="48" y="-28" width="16" height="14" rx="2" fill="var(--accent)" fill-opacity=".7" opacity="0"/>
          <rect id="gsq3" x="4"  y="-8"  width="16" height="14" rx="2" fill="var(--accent)" fill-opacity=".7" opacity="0"/>
          <rect id="gsq4" x="26" y="-8"  width="16" height="14" rx="2" fill="var(--accent)" fill-opacity=".7" opacity="0"/>
          <rect id="gsq5" x="48" y="-8"  width="16" height="14" rx="2" fill="var(--accent)" fill-opacity=".7" opacity="0"/>
          <rect id="gsq6" x="4"  y="12"  width="16" height="14" rx="2" fill="var(--accent)" fill-opacity=".7" opacity="0"/>
          <rect id="gsq7" x="26" y="12"  width="16" height="14" rx="2" fill="var(--accent)" fill-opacity=".7" opacity="0"/>
          <rect id="gsq8" x="48" y="12"  width="16" height="14" rx="2" fill="var(--accent)" fill-opacity=".7" opacity="0"/>
        </g>
        <!-- core product -->
        <g id="gCore" opacity="0" transform="translate(380 290)">
          <rect x="-92" y="-48" width="184" height="96" rx="13" fill="#0c0c0c" stroke="var(--accent)" stroke-width="1.8"></rect>
          <rect x="-74" y="-32" width="78" height="46" rx="5" fill="none" stroke="rgba(255,255,255,.4)" stroke-width="1.3"></rect>
          <circle cx="-68" cy="-26" r="2.2" fill="var(--accent)"></circle>
          <circle cx="-61" cy="-26" r="2.2" fill="rgba(255,255,255,.3)"></circle>
          <rect x="-68" y="-14" width="44" height="9" rx="2" fill="rgba(198,244,50,.5)"></rect>
          <rect x="-68" y="1" width="60" height="5" rx="2" fill="rgba(255,255,255,.14)"></rect>
          <rect x="18" y="-34" width="38" height="62" rx="8" fill="none" stroke="rgba(255,255,255,.4)" stroke-width="1.3"></rect>
          <rect x="24" y="-26" width="26" height="40" rx="2" fill="rgba(198,244,50,.12)"></rect>
          <text x="0" y="40" text-anchor="middle" fill="var(--accent)" font-family="JetBrains Mono,monospace" font-weight="700" font-size="10" letter-spacing="1">YOUR PRODUCT</text>
        </g>
        <!-- BACKEND engine — terminal vector -->
        <g id="gApi" opacity="0" transform="translate(500 700)">
          <rect id="apiBox" x="-160" y="-120" width="320" height="240" rx="13" fill="#0c0c0c" stroke="rgba(255,255,255,.42)" stroke-width="2"></rect>
          <line x1="-160" y1="-82" x2="160" y2="-82" stroke="rgba(255,255,255,.22)" stroke-width="1.5"></line>
          <circle cx="-138" cy="-101" r="5" fill="var(--accent)"></circle>
          <circle cx="-120" cy="-101" r="5" fill="rgba(255,255,255,.25)"></circle>
          <circle cx="-102" cy="-101" r="5" fill="rgba(255,255,255,.25)"></circle>
          <text x="0" y="-95" text-anchor="middle" fill="rgba(255,255,255,.35)" font-family="JetBrains Mono,monospace" font-weight="600" font-size="10" letter-spacing="1.5">API ENDPOINTS</text>
          <!-- endpoint rows: method badge | path | latency bar | ms -->
          <rect x="-140" y="-72" width="40" height="14" rx="3" fill="rgba(198,244,50,.18)"></rect>
          <text x="-136" y="-60" fill="var(--accent)" font-family="JetBrains Mono,monospace" font-weight="700" font-size="9">GET</text>
          <text x="-92" y="-60" fill="rgba(255,255,255,.5)" font-family="JetBrains Mono,monospace" font-size="9">/auth</text>
          <rect x="20" y="-70" width="52" height="6" rx="3" fill="rgba(255,255,255,.1)"></rect>
          <rect x="20" y="-70" width="34" height="6" rx="3" fill="var(--accent)" fill-opacity=".7"></rect>
          <text x="106" y="-60" text-anchor="end" fill="rgba(255,255,255,.4)" font-family="JetBrains Mono,monospace" font-size="9">12ms</text>

          <rect x="-140" y="-48" width="48" height="14" rx="3" fill="rgba(198,244,50,.18)"></rect>
          <text x="-136" y="-36" fill="var(--accent)" font-family="JetBrains Mono,monospace" font-weight="700" font-size="9">POST</text>
          <text x="-84" y="-36" fill="rgba(255,255,255,.5)" font-family="JetBrains Mono,monospace" font-size="9">/payments</text>
          <rect x="20" y="-46" width="52" height="6" rx="3" fill="rgba(255,255,255,.1)"></rect>
          <rect x="20" y="-46" width="22" height="6" rx="3" fill="var(--accent)" fill-opacity=".7"></rect>
          <text x="106" y="-36" text-anchor="end" fill="rgba(255,255,255,.4)" font-family="JetBrains Mono,monospace" font-size="9">8ms</text>

          <rect x="-140" y="-24" width="40" height="14" rx="3" fill="rgba(198,244,50,.18)"></rect>
          <text x="-136" y="-12" fill="var(--accent)" font-family="JetBrains Mono,monospace" font-weight="700" font-size="9">GET</text>
          <text x="-92" y="-12" fill="rgba(255,255,255,.5)" font-family="JetBrains Mono,monospace" font-size="9">/content</text>
          <rect x="20" y="-22" width="52" height="6" rx="3" fill="rgba(255,255,255,.1)"></rect>
          <rect x="20" y="-22" width="44" height="6" rx="3" fill="var(--accent)" fill-opacity=".7"></rect>
          <text x="106" y="-12" text-anchor="end" fill="rgba(255,255,255,.4)" font-family="JetBrains Mono,monospace" font-size="9">4ms</text>

          <rect x="-140" y="0" width="40" height="14" rx="3" fill="rgba(198,244,50,.18)"></rect>
          <text x="-136" y="12" fill="var(--accent)" font-family="JetBrains Mono,monospace" font-weight="700" font-size="9">GET</text>
          <text x="-92" y="12" fill="rgba(255,255,255,.5)" font-family="JetBrains Mono,monospace" font-size="9">/ai-agent</text>
          <rect x="20" y="2" width="52" height="6" rx="3" fill="rgba(255,255,255,.1)"></rect>
          <rect x="20" y="2" width="14" height="6" rx="3" fill="var(--accent)" fill-opacity=".7"></rect>
          <text x="106" y="12" text-anchor="end" fill="rgba(255,255,255,.4)" font-family="JetBrains Mono,monospace" font-size="9">24ms</text>

          <line x1="-160" y1="32" x2="160" y2="32" stroke="rgba(255,255,255,.1)" stroke-width="1"></line>
          <circle cx="-138" cy="46" r="3" fill="var(--accent)"></circle>
          <text x="-128" y="50" fill="rgba(255,255,255,.38)" font-family="JetBrains Mono,monospace" font-size="9">DB</text>
          <circle cx="-96" cy="46" r="3" fill="var(--accent)"></circle>
          <text x="-86" y="50" fill="rgba(255,255,255,.38)" font-family="JetBrains Mono,monospace" font-size="9">Cache</text>
          <text x="106" y="50" text-anchor="end" fill="rgba(198,244,50,.48)" font-family="JetBrains Mono,monospace" font-size="9">99.9% up</text>
          <g id="capgrp">
            <rect class="capbar" id="cb0" x="-76" y="118" width="13" height="0" rx="2" fill="var(--accent)" opacity="0"></rect>
            <rect class="capbar" id="cb1" x="-55" y="118" width="13" height="0" rx="2" fill="var(--accent)" opacity="0"></rect>
            <rect class="capbar" id="cb2" x="-34" y="118" width="13" height="0" rx="2" fill="var(--accent)" opacity="0"></rect>
            <rect class="capbar" id="cb3" x="-13" y="118" width="13" height="0" rx="2" fill="var(--accent)" opacity="0"></rect>
            <rect class="capbar" id="cb4" x="8" y="118" width="13" height="0" rx="2" fill="var(--accent)" opacity="0"></rect>
            <rect class="capbar" id="cb5" x="29" y="118" width="13" height="0" rx="2" fill="var(--accent)" opacity="0"></rect>
            <rect class="capbar" id="cb6" x="50" y="118" width="13" height="0" rx="2" fill="var(--accent)" opacity="0"></rect>
            <rect class="capbar" id="cb7" x="71" y="118" width="13" height="0" rx="2" fill="var(--accent)" opacity="0"></rect>
          </g>
        </g>
        <!-- accounts (backend module) -->
        <g id="mAccounts" opacity="0" transform="translate(566 336)">
          <rect x="-64" y="-36" width="128" height="72" rx="11" fill="#0e0e0e" stroke="rgba(255,255,255,.2)" stroke-width="1.4"></rect>
          <path id="accShieldFill" d="M-40 -16 L-27 -11 L-27 0 Q-27 12 -40 18 Q-53 12 -53 0 L-53 -11 Z" fill="rgba(198,244,50,.10)" opacity="0"></path>
          <path id="accShield" d="M-40 -16 L-27 -11 L-27 0 Q-27 12 -40 18 Q-53 12 -53 0 L-53 -11 Z" pathLength="1" fill="none" stroke="var(--accent)" stroke-width="1.7" stroke-linejoin="round"></path>
          <path id="accCheck" d="M-47 0 L-42 5 L-33 -6" pathLength="1" fill="none" stroke="var(--accent)" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"></path>
          <text x="-14" y="-3" fill="#E9E7E1" font-family="JetBrains Mono,monospace" font-weight="600" font-size="11">Accounts</text>
          <text x="-14" y="12" fill="#7c7c74" font-family="JetBrains Mono,monospace" font-weight="500" font-size="8">secure logins</text>
        </g>
        <!-- payments (backend module) -->
        <g id="mPayments" opacity="0" transform="translate(700 336)">
          <rect x="-64" y="-36" width="128" height="72" rx="11" fill="#0e0e0e" stroke="rgba(255,255,255,.2)" stroke-width="1.4"></rect>
          <rect x="-52" y="-13" width="32" height="22" rx="3" fill="none" stroke="var(--accent)" stroke-width="1.5"></rect>
          <rect x="-52" y="-7" width="32" height="5" fill="var(--accent)"></rect>
          <text x="-14" y="-3" fill="#E9E7E1" font-family="JetBrains Mono,monospace" font-weight="600" font-size="11">Payments</text>
          <text x="-14" y="12" fill="#7c7c74" font-family="JetBrains Mono,monospace" font-weight="500" font-size="8">card payments</text>
        </g>
        <!-- ai agent (backend module) -->
        <g id="mAgent" opacity="0" transform="translate(834 336)">
          <rect x="-64" y="-36" width="128" height="72" rx="11" fill="#0e0e0e" stroke="rgba(255,255,255,.2)" stroke-width="1.4"></rect>
          <circle cx="-42" cy="0" r="16" fill="none" stroke="var(--accent)" stroke-width="1.3" style="transform-box:fill-box;transform-origin:center;animation:snz-ring 2.6s ease-out infinite"></circle>
          <circle cx="-42" cy="0" r="15" fill="rgba(198,244,50,.06)" stroke="var(--accent)" stroke-width="1.6"></circle>
          <text x="-42" y="5" text-anchor="middle" fill="var(--accent)" font-family="Archivo,sans-serif" font-weight="800" font-size="14">✦</text>
          <text x="-12" y="-3" fill="#E9E7E1" font-family="JetBrains Mono,monospace" font-weight="600" font-size="11">AI agent</text>
          <text x="-12" y="12" fill="#7c7c74" font-family="JetBrains Mono,monospace" font-weight="500" font-size="8">gets things done</text>
        </g>
        <!-- cms (backend module) -->
        <g id="mCMS" opacity="0" transform="translate(632 432)">
          <rect x="-64" y="-36" width="128" height="72" rx="11" fill="#0e0e0e" stroke="rgba(255,255,255,.2)" stroke-width="1.4"></rect>
          <rect x="-52" y="-15" width="26" height="30" rx="3" fill="none" stroke="var(--accent)" stroke-width="1.5"></rect>
          <line x1="-47" y1="-7" x2="-31" y2="-7" stroke="var(--accent)" stroke-width="1.4"></line>
          <line x1="-47" y1="-1" x2="-31" y2="-1" stroke="var(--accent)" stroke-width="1.4"></line>
          <line x1="-47" y1="5" x2="-37" y2="5" stroke="var(--accent)" stroke-width="1.4"></line>
          <text x="-18" y="-3" fill="#E9E7E1" font-family="JetBrains Mono,monospace" font-weight="600" font-size="11">CMS</text>
          <text x="-18" y="12" fill="#7c7c74" font-family="JetBrains Mono,monospace" font-weight="500" font-size="8">manage content</text>
        </g>
        <!-- ecommerce (backend module) -->
        <g id="mEcom" opacity="0" transform="translate(768 432)">
          <rect x="-64" y="-36" width="128" height="72" rx="11" fill="#0e0e0e" stroke="rgba(255,255,255,.2)" stroke-width="1.4"></rect>
          <path d="M-52 -10 L-26 -10 L-29 8 L-49 8 Z" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linejoin="round"></path>
