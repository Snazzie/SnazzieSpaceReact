---
// THE BUILD — scroll-driven story: site + app merge into a product, the backend
// docks and explodes into modules, traffic arrives, it scales, then analytics.

import {
  siStripe, siPaypal, siRevenuecat, siPaddle, siLemonsqueezy, siSquare,
  siGoogleadsense, siGoogleadmob, siGoogleads,
  siCloudflare, siGooglecloud, siVercel, siNetlify, siDigitalocean, siRender, siRailway, siHetzner, siVultr, siFastly, siAkamai,
  siSupabase, siFirebase, siPlanetscale, siNeon, siConvex, siUpstash, siAlgolia,
  siAuth0, siClerk, siOkta,
  siAnthropic, siGooglegemini, siMistralai, siPerplexity, siHuggingface, siReplicate,
  siSanity, siContentful, siNotion, siGhost, siDirectus, siStrapi,
  siResend, siMailgun, siMailchimp,
  siSentry, siDatadog, siPosthog, siPlausibleanalytics, siMixpanel,
  siCloudinary, siLinear, siIntercom, siZendesk, siHubspot, siDiscord,
  type SimpleIcon,
} from "simple-icons";

// ENGINE: skewed tech-services marquee (background) + a browser that morphs through
// the shapes one product can take (landing → store → content → app), scroll-driven.
// Each service is tagged with a category; the marquee lights up the category that
// matches the current morph stage (host → pay → cms → app) and dims the rest.
const cat = (c: string) => (i: SimpleIcon) => ({ title: i.title, path: i.path, cat: c });
const services = [
  ...[siCloudflare, siGooglecloud, siVercel, siNetlify, siDigitalocean, siRender, siRailway, siHetzner, siVultr, siFastly, siAkamai].map(cat("host")),
  ...[siStripe, siPaypal, siRevenuecat, siPaddle, siLemonsqueezy, siSquare, siGoogleadsense, siGoogleadmob, siGoogleads].map(cat("pay")),
  ...[siSanity, siContentful, siNotion, siGhost, siDirectus, siStrapi, siCloudinary, siMailchimp, siResend, siMailgun].map(cat("cms")),
  ...[siSupabase, siFirebase, siPlanetscale, siNeon, siConvex, siUpstash, siAlgolia, siAuth0, siClerk, siOkta,
    siAnthropic, siGooglegemini, siMistralai, siPerplexity, siHuggingface, siReplicate,
    siSentry, siDatadog, siPosthog, siPlausibleanalytics, siMixpanel, siLinear, siIntercom, siZendesk, siHubspot, siDiscord].map(cat("app")),
];
// stage index (0..3) → highlighted category
const PUR_CATS = ["host", "pay", "cms", "app"];
// deterministic per-row shuffle (no Math.random at build time)
// PERF + CORRECTNESS: keep each row narrow. The row's transform animation promotes it to a GPU
// layer sized to its full content × devicePixelRatio; if that exceeds the GPU max texture (~16384)
// the browser CLIPS the layer and glyphs past the limit render black/missing. 16 items (×2 dupes)
// at the reduced font/gap below keeps the row well under the limit. Fewer nodes also = less paint.
const shuffle = (n: number) => { const a = services.slice(); for (let i = a.length - 1; i > 0; i--) { const j = (i * 7 + n * 3) % (i + 1); [a[i], a[j]] = [a[j], a[i]]; } return a.slice(0, 16); };
// Density comes from MORE ROWS (vertical), not wider rows: each row is its own compositor layer
// sized to its width, so stacking rows never approaches the per-layer texture limit, while wider
// rows would. 13 rows of 16 shuffled items reads as a dense, endless field.
const PURPOSE_ROWS = Array.from({ length: 13 }, (_, r) => ({ dir: r % 2 ? "r" : "l", dur: 44 + (r % 5) * 6, items: shuffle(r) }));

// Scroll-step captions (cap1..cap6). cap1 stays visible; rest start hidden.
const buildCaps = [
  { label: "01 — DESIGN", title: "Endless design possibilities.", body: "Catered entirely to your brand. Website, app, or both, no templates, no limits, designed from scratch around you.", max: 460 },
  { label: "02 — PURPOSE", title: "Built around what it's for.", body: "A landing page, a store, a content engine, a full app, the same product shaped to whatever your business needs to do.", max: 480 },
  { label: "03 — SCALE", title: "Scales with your customers.", body: "As word spreads more customers arrive, from a small shop with a hundred visitors to an enterprise with half a million, and the infrastructure scales right along with them.", max: 500 },
  { label: "04 — DATA", title: "And you see it all.", body: "Live analytics show your traffic, revenue and what's working, so you know what to do next.", max: 480 },
];

// Step tracker labels (tk1..tk6) — first is active (accent), rest dim.
const buildTrack = ["01 DESIGN", "02 PURPOSE", "03 SCALE", "04 DATA"];

// Phone app screen repeated twice for the scroll loop (UNIT 1 at o=0, UNIT 2 at o=240).
const phoneUnits = [0, 240];

// Styles + keyframes live in a sibling stylesheet (global, not scoped — every selector is
// uniquely `pur-`/`snz-` prefixed). Bundled by Vite via this import.
import "./BuildFlow.css";
