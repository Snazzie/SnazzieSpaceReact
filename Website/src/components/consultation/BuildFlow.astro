          <!-- TL: traffic line -->
          <text x="92" y="224" fill="#9a9a92" font-family="JetBrains Mono,monospace" font-weight="600" font-size="11">TRAFFIC OVER TIME</text>
          <polyline id="anChart" points="92,360 130,350 168,356 206,334 244,322 282,326 320,302 358,292 396,300 434,274 472,250" pathLength="1" fill="none" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></polyline>
