---
// THE BUILD — scroll-driven story: site + app merge into a product, the backend
// docks and explodes into modules, traffic arrives, it scales, then analytics.

import {
  siStripe, siPaypal, siRevenuecat, siPaddle, siLemonsqueezy, siSquare,
  siCloudflare, siGooglecloud, siVercel, siNetlify, siDigitalocean, siRender, siRailway, siHetzner, siVultr, siFastly, siAkamai,
  siSupabase, siFirebase, siPlanetscale, siNeon, siConvex, siUpstash, siAlgolia,
  siAuth0, siClerk, siOkta,
  siAnthropic, siGooglegemini, siMistralai, siPerplexity, siHuggingface, siReplicate,
  siSanity, siContentful, siNotion, siGhost, siDirectus, siStrapi,
  siResend, siMailgun, siMailchimp,
  siSentry, siDatadog, siPosthog, siPlausibleanalytics, siMixpanel,
  siCloudinary, siLinear, siIntercom, siZendesk, siHubspot, siDiscord,
  type SimpleIcon,
} from "simple-icons";

// ENGINE: skewed tech-services marquee (background) + a browser that morphs through
// the shapes one product can take (landing → store → content → app), scroll-driven.
// Each service is tagged with a category; the marquee lights up the category that
// matches the current morph stage (host → pay → cms → app) and dims the rest.
const cat = (c: string) => (i: SimpleIcon) => ({ title: i.title, path: i.path, cat: c });
const services = [
  ...[siCloudflare, siGooglecloud, siVercel, siNetlify, siDigitalocean, siRender, siRailway, siHetzner, siVultr, siFastly, siAkamai].map(cat("host")),
  ...[siStripe, siPaypal, siRevenuecat, siPaddle, siLemonsqueezy, siSquare].map(cat("pay")),
  ...[siSanity, siContentful, siNotion, siGhost, siDirectus, siStrapi, siCloudinary, siMailchimp, siResend, siMailgun].map(cat("cms")),
  ...[siSupabase, siFirebase, siPlanetscale, siNeon, siConvex, siUpstash, siAlgolia, siAuth0, siClerk, siOkta,
    siAnthropic, siGooglegemini, siMistralai, siPerplexity, siHuggingface, siReplicate,
    siSentry, siDatadog, siPosthog, siPlausibleanalytics, siMixpanel, siLinear, siIntercom, siZendesk, siHubspot, siDiscord].map(cat("app")),
];
// stage index (0..3) → highlighted category
const ENG_CATS = ["host", "pay", "cms", "app"];
// deterministic per-row shuffle (no Math.random at build time)
const shuffle = (n: number) => { const a = services.slice(); for (let i = a.length - 1; i > 0; i--) { const j = (i * 7 + n * 3) % (i + 1); [a[i], a[j]] = [a[j], a[i]]; } return a.slice(0, 30); };
const ENGINE_ROWS = Array.from({ length: 14 }, (_, r) => ({ dir: r % 2 ? "r" : "l", dur: 44 + (r % 5) * 6, items: shuffle(r) }));

// Scroll-step captions (cap1..cap6). cap1 stays visible; rest start hidden.
const buildCaps = [
  { label: "01 — BUILD", title: "What the user sees.", body: "A website and an app — designed around you and built by hand.", max: 460 },
  { label: "02 — ENGINE", title: "Starts simple. Grows into anything.", body: "A landing page, a store, a content engine, a full app — the same product, built on the services behind it.", max: 480 },
  { label: "03 — CONNECT", title: "Wire it together.", body: "Your product and the backend, talking to a database and a fast cache so everything feels instant.", max: 480 },
  { label: "04 — TRAFFIC", title: "People show up.", body: "As word spreads, more and more customers arrive — all at once.", max: 480 },
  { label: "05 — SCALE", title: "It scales with demand.", body: "Whether you're a small shop with a hundred visitors or an enterprise with half a million, the solution always scale with your needs.", max: 480 },
  { label: "06 — DATA", title: "And you see it all.", body: "Live analytics show your traffic, revenue and what's working — so you know what to do next.", max: 480 },
];

// Step tracker labels (tk1..tk6) — first is active (accent), rest dim.
const buildTrack = ["01 BUILD", "02 ENGINE", "03 CONNECT", "04 TRAFFIC", "05 SCALE", "06 DATA"];

// Phone app screen repeated twice for the scroll loop (UNIT 1 at o=0, UNIT 2 at o=240).
const phoneUnits = [0, 240];
---
<style>
  @keyframes snz-spin { to { transform: rotate(360deg); } }

  /* ===== ENGINE overlay: skewed services marquee + morphing browser ===== */
  .eng-bg{ position:absolute; left:50%; top:50%; width:230vmax; height:230vmax;
    transform:translate(-50%,-50%) rotate(-45deg); transform-origin:center;
    display:flex; flex-direction:column; justify-content:center; gap:24px;
    -webkit-mask-image:radial-gradient(58% 50% at 50% 50%,#000 26%,transparent 72%);
            mask-image:radial-gradient(58% 50% at 50% 50%,#000 26%,transparent 72%); }
  .eng-row{ display:flex; align-items:center; gap:44px; white-space:nowrap; font:800 50px/1.3 'Archivo',sans-serif;
    letter-spacing:-.03em; padding:4px 0 24px; border-bottom:1px solid rgba(255,255,255,.04);
    color:transparent; background-color:rgba(255,255,255,.06);
    background-image:linear-gradient(100deg, transparent 0%, transparent 40%,
      rgba(198,244,50,.22) 47%, rgba(255,255,255,.4) 50%, rgba(198,244,50,.22) 53%,
      transparent 60%, transparent 100%);
    background-repeat:repeat-x; background-size:600px 100%;
    -webkit-background-clip:text; background-clip:text; }
  .eng-row.l{ animation:eng-ml var(--dur,52s) linear infinite, eng-shim 2s linear infinite; }
  .eng-row.r{ animation:eng-mr var(--dur,52s) linear infinite, eng-shim 2s linear infinite; }
  @keyframes eng-ml{ from{transform:translateX(0)} to{transform:translateX(-50%)} }
  @keyframes eng-mr{ from{transform:translateX(-50%)} to{transform:translateX(0)} }
  @keyframes eng-shim{ from{background-position:0 0} to{background-position:-600px 0} }
  .eng-it{ display:inline-flex; align-items:center; gap:.26em; transition:-webkit-text-fill-color .5s ease, opacity .5s ease; }
  .eng-ic{ height:.56em; width:auto; fill:rgba(255,255,255,.16); flex:none; transition:fill .5s ease, opacity .5s ease; opacity:.55; }
  /* stage-reactive highlight: the category matching the current morph stage glows accent, rest dim */
  #snz-engine[data-cat] .eng-it{ opacity:.5; }
  #snz-engine[data-cat="host"] .eng-it[data-cat="host"],
  #snz-engine[data-cat="pay"]  .eng-it[data-cat="pay"],
  #snz-engine[data-cat="cms"]  .eng-it[data-cat="cms"],
  #snz-engine[data-cat="app"]  .eng-it[data-cat="app"]{ opacity:.7; -webkit-text-fill-color:rgba(198,244,50,.3); }
  #snz-engine[data-cat="host"] .eng-it[data-cat="host"] .eng-ic,
  #snz-engine[data-cat="pay"]  .eng-it[data-cat="pay"]  .eng-ic,
  #snz-engine[data-cat="cms"]  .eng-it[data-cat="cms"]  .eng-ic,
  #snz-engine[data-cat="app"]  .eng-it[data-cat="app"]  .eng-ic{ fill:rgba(198,244,50,.32); opacity:.7; }

  .eng-fg{ position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:18px; }
  .eng-browser{ width:min(560px,82%); border:1.6px solid var(--accent); border-radius:14px; background:#0c0c0c; overflow:hidden;
    box-shadow:0 30px 80px rgba(0,0,0,.6), 0 0 60px rgba(198,244,50,.1); }
  .eng-chrome{ height:38px; display:flex; align-items:center; gap:7px; padding:0 14px; border-bottom:1px solid rgba(255,255,255,.08); background:rgba(255,255,255,.02); }
  .eng-chrome i{ width:10px; height:10px; border-radius:50%; background:rgba(255,255,255,.18); }
  .eng-chrome i:first-child{ background:var(--accent); }
  .eng-url{ margin-left:10px; height:16px; flex:1; max-width:260px; border-radius:8px; background:rgba(255,255,255,.05); }
  .eng-screen{ position:relative; height:328px; }
  .eng-view{ position:absolute; inset:0; padding:20px 22px; opacity:0; pointer-events:none; transition:opacity .2s ease; }
  .eng-view.on{ opacity:1; }
  .eng-pl{ opacity:0; }
  .eng-pl.go{ animation:eng-plop .46s cubic-bezier(.2,1.35,.4,1) forwards; }
  @keyframes eng-plop{ 0%{opacity:0;transform:scale(.25) translateY(9px)} 55%{opacity:1} 100%{opacity:1;transform:scale(1) translateY(0)} }
  .eng-bar{ background:rgba(255,255,255,.14); border-radius:4px; }
  .eng-bar.dim{ background:rgba(255,255,255,.07); } .eng-bar.acc{ background:rgba(198,244,50,.55); }
  .eng-box{ background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.08); border-radius:8px; }
  .eng-btn{ background:var(--accent); border-radius:8px; }
  .eng-rw{ display:flex; } .eng-cl{ display:flex; flex-direction:column; }
  .eng-nav{ display:flex; align-items:center; gap:9px; margin-bottom:16px; }
  .eng-nav .lg{ width:42px; height:10px; border-radius:3px; background:var(--accent); }
  .eng-nav .sp{ flex:1; } .eng-nav .lk{ width:28px; height:6px; border-radius:3px; background:rgba(255,255,255,.18); }
  .eng-grid3{ display:grid; grid-template-columns:repeat(3,1fr); gap:11px; }
  .eng-grid2{ display:grid; grid-template-columns:repeat(3,1fr); gap:12px; }
  .eng-post{ display:flex; gap:12px; align-items:center; padding:9px 0; border-top:1px solid rgba(255,255,255,.07); }
  .eng-rail{ width:42px; flex:none; align-self:stretch; border-right:1px solid rgba(255,255,255,.08); background:rgba(255,255,255,.02);
    display:flex; flex-direction:column; align-items:center; gap:12px; padding:14px 0; }
  .eng-rail .rl{ width:18px; height:18px; border-radius:6px; background:var(--accent); }
  .eng-rail .rd{ width:16px; height:16px; border-radius:6px; background:rgba(255,255,255,.12); }
  .eng-rail .rd.on{ background:rgba(198,244,50,.4); }
  .eng-cap{ display:flex; align-items:center; gap:13px; }
  .eng-step{ font:800 13px 'Archivo',sans-serif; color:#0b0b0b; background:var(--accent); border-radius:7px; padding:4px 8px; letter-spacing:-.02em; }
  .eng-title{ font:700 12px 'JetBrains Mono',monospace; letter-spacing:2px; color:var(--accent); }
  .eng-cap small{ color:#9a9a92; font:500 11px 'JetBrains Mono',monospace; letter-spacing:1px; }
  @media (prefers-reduced-motion: reduce){ .eng-row{ animation:none; } .eng-pl{ opacity:1; } }

  @keyframes snz-bf-up { from { transform: translateY(0); } to { transform: translateY(-50%); } }
  @keyframes snz-bf-dn { from { transform: translateY(-50%); } to { transform: translateY(0); } }
  @keyframes snz-appscroll { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-140px); } }
  .snz-bf-col { display:flex; flex-direction:column; gap:16px; flex-shrink:0; width:160px; }
  .snz-bf-col-a { animation: snz-bf-up 30s linear infinite; animation-play-state:paused; }
  .snz-bf-col-b { animation: snz-bf-dn 24s linear infinite; animation-play-state:paused; }
  .snz-bf-col-c { animation: snz-bf-up 36s linear infinite; animation-play-state:paused; }
  .snz-bf-col-a.snz-bf-go, .snz-bf-col-b.snz-bf-go, .snz-bf-col-c.snz-bf-go { animation-play-state:running; }
  @media (prefers-reduced-motion: reduce) {
    .snz-bf-col-a, .snz-bf-col-b, .snz-bf-col-c { animation:none; }
  }
  #snz-stmt { position:relative; overflow:hidden; }
  .snz-ghost {
    position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
    font:800 13vw/1 'Archivo',sans-serif; letter-spacing:-0.03em; white-space:nowrap;
    color:transparent; -webkit-text-stroke:1px rgba(198,244,50,.06);
    pointer-events:none; user-select:none;
    transform:translateY(8px); transition:transform 1.4s ease;
  }
  #snz-stmt.snz-in .snz-ghost { transform:translateY(0); }
  .snz-stmt-label {
    font:600 11px 'JetBrains Mono',monospace; letter-spacing:.2em; color:var(--accent);
    margin-bottom:28px; opacity:0; transform:translateY(10px);
    transition:opacity .5s ease, transform .5s ease;
  }
  #snz-stmt.snz-in .snz-stmt-label { opacity:1; transform:translateY(0); }
  .snz-stmt-h { margin:0 auto; max-width:860px; font:800 clamp(34px,5.5vw,76px)/1.04 'Archivo',sans-serif; letter-spacing:-0.03em; }
  .snz-w {
    display:inline-block; color:#F2F0EA;
    opacity:0; transform:translateY(28px);
    transition:opacity .6s ease, transform .6s ease;
    transition-delay:var(--d,0s);
  }
  .snz-w.snz-accent { color:var(--accent); }
  #snz-stmt.snz-in .snz-w { opacity:1; transform:translateY(0); }
  #snz-row1, #snz-row2 { display:block; white-space:nowrap; will-change:transform; }
  #snz-row1 .snz-w, #snz-row2 .snz-w { opacity:1; transform:none; transition:none; }
  .snz-stmt-line {
    margin:40px auto 0; height:2px; width:0; background:var(--accent);
    transition:width .9s cubic-bezier(.22,1,.36,1); transition-delay:.9s;
  }
  #snz-stmt.snz-in .snz-stmt-line { width:72px; }
  .snz-stmt-sub {
    margin:28px auto 0; max-width:720px; font:400 18px/1.65 'JetBrains Mono',monospace;
    letter-spacing:.04em; color:#6a6a62;
    opacity:0; transform:translateY(8px);
    transition:opacity .6s ease, transform .6s ease; transition-delay:1.1s;
  }
  #snz-stmt.snz-in .snz-stmt-sub { opacity:1; transform:translateY(0); }
  .snz-slide-row {
    position:absolute; left:-20%; width:160%;
    font:700 clamp(10px,1.2vw,13px)/1 'JetBrains Mono',monospace;
    letter-spacing:.22em; color:transparent;
    -webkit-background-clip:text; background-clip:text;
    background-image:linear-gradient(90deg,rgba(198,244,50,.06) 0%,rgba(198,244,50,.06) 100%);
    white-space:nowrap; pointer-events:none; will-change:transform;
  }
  @media (max-width: 760px) {
    #snz-stmt { padding-left: 22px !important; padding-right: 22px !important; }
    .snz-stmt-h { font-size: clamp(30px,9vw,42px) !important; }
    /* let the headline wrap and ignore the scroll-driven horizontal slide on mobile */
    #snz-row1, #snz-row2 { white-space: normal !important; transform: none !important; opacity: 1 !important; }
    .snz-stmt-sub { font-size: 15px !important; }
  }
</style>
