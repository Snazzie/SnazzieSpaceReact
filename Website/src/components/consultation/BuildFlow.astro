---
// THE BUILD — scroll-driven story: site + app merge into a product, the backend
// docks and explodes into modules, traffic arrives, it scales, then analytics.
---
<style>
  @keyframes snz-spin { to { transform: rotate(360deg); } }

  #snz-stmt { position:relative; overflow:hidden; }
  .snz-ghost {
    position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
    font:800 13vw/1 'Archivo',sans-serif; letter-spacing:-0.03em; white-space:nowrap;
    color:transparent; -webkit-text-stroke:1px rgba(198,244,50,.06);
    pointer-events:none; user-select:none;
    transform:translateY(8px); transition:transform 1.4s ease;
  }
  #snz-stmt.snz-in .snz-ghost { transform:translateY(0); }
  .snz-stmt-label {
    font:600 11px 'JetBrains Mono',monospace; letter-spacing:.2em; color:var(--accent);
    margin-bottom:28px; opacity:0; transform:translateY(10px);
    transition:opacity .5s ease, transform .5s ease;
  }
  #snz-stmt.snz-in .snz-stmt-label { opacity:1; transform:translateY(0); }
  .snz-stmt-h { margin:0 auto; max-width:860px; font:800 clamp(34px,5.5vw,76px)/1.04 'Archivo',sans-serif; letter-spacing:-0.03em; }
  .snz-w {
    display:inline-block; color:#F2F0EA;
    opacity:0; transform:translateY(28px);
    transition:opacity .6s ease, transform .6s ease;
    transition-delay:var(--d,0s);
  }
  .snz-w.snz-accent { color:var(--accent); }
  #snz-stmt.snz-in .snz-w { opacity:1; transform:translateY(0); }
  #snz-row1, #snz-row2 { display:block; white-space:nowrap; will-change:transform; }
  #snz-row1 .snz-w, #snz-row2 .snz-w { opacity:1; transform:none; transition:none; }
  .snz-stmt-line {
    margin:40px auto 0; height:2px; width:0; background:var(--accent);
    transition:width .9s cubic-bezier(.22,1,.36,1); transition-delay:.9s;
  }
  #snz-stmt.snz-in .snz-stmt-line { width:72px; }
  .snz-stmt-sub {
    margin:28px auto 0; max-width:720px; font:400 18px/1.65 'JetBrains Mono',monospace;
    letter-spacing:.04em; color:#6a6a62;
    opacity:0; transform:translateY(8px);
    transition:opacity .6s ease, transform .6s ease; transition-delay:1.1s;
  }
  #snz-stmt.snz-in .snz-stmt-sub { opacity:1; transform:translateY(0); }
  .snz-slide-row {
    position:absolute; left:-20%; width:160%;
    font:700 clamp(10px,1.2vw,13px)/1 'JetBrains Mono',monospace;
    letter-spacing:.22em; color:transparent;
    -webkit-background-clip:text; background-clip:text;
    background-image:linear-gradient(90deg,rgba(198,244,50,.06) 0%,rgba(198,244,50,.06) 100%);
    white-space:nowrap; pointer-events:none; will-change:transform;
  }
</style>
<section id="snz-stmt" style="background:#0b0b0b;padding:clamp(80px,12vw,140px) 56px;text-align:center;border-bottom:1px solid rgba(255,255,255,.08)">
  <div class="snz-ghost" aria-hidden="true">sells.</div>
  <div class="snz-slide-row" id="snz-sr1" style="top:14%" aria-hidden="true">IMPRESSION · IDENTITY · DESIGN · PRESENCE · CRAFT · IMPRESSION · IDENTITY · DESIGN · PRESENCE · CRAFT · IMPRESSION · IDENTITY · DESIGN · PRESENCE · CRAFT · IMPRESSION · IDENTITY · DESIGN · PRESENCE · CRAFT · IMPRESSION · IDENTITY · DESIGN · PRESENCE · CRAFT · IMPRESSION · IDENTITY · DESIGN · PRESENCE · CRAFT ·</div>
  <div class="snz-slide-row" id="snz-sr2" style="top:82%" aria-hidden="true">BUILDER · PRODUCT · BUILD · BESPOKE · IMPACT · BUILDER · PRODUCT · BUILD · BESPOKE · IMPACT · BUILDER · PRODUCT · BUILD · BESPOKE · IMPACT · BUILDER · PRODUCT · BUILD · BESPOKE · IMPACT · BUILDER · PRODUCT · BUILD · BESPOKE · IMPACT · BUILDER · PRODUCT · BUILD · BESPOKE · IMPACT ·</div>
  <div class="snz-stmt-label">[ A THOUGHT ]</div>
  <h2 class="snz-stmt-h">
    <span id="snz-row1"><span class="snz-w">Building&nbsp;</span><span class="snz-w">a&nbsp;</span><span class="snz-w">product&nbsp;</span><span class="snz-w">is&nbsp;</span><span class="snz-w">easy.</span></span>
    <span id="snz-row2"><span class="snz-w">Building&nbsp;</span><span class="snz-w">one&nbsp;</span><span class="snz-w">that&nbsp;</span><span class="snz-w snz-accent">sells&nbsp;</span><span class="snz-w">is&nbsp;</span><span class="snz-w">not.</span></span>
  </h2>
  <div class="snz-stmt-line"></div>
</section>
