---
// Closing CTA: final call to get in touch.
const LINKEDIN = 'https://linkedin.com/in/cooper-a-m/';
---
<section id="snz-close" class="py-[120px] px-14 relative overflow-hidden max-[760px]:py-20 max-[760px]:px-[22px]">
  <div id="snz-closebg" class="absolute inset-0 pointer-events-none" style="background-image:radial-gradient(circle at 70% 40%,rgba(var(--accent-rgb),.08),transparent 55%)"></div>
  <div data-reveal class="relative max-w-[1180px] mx-auto grid grid-cols-[1fr_380px] gap-16 items-start max-[900px]:grid-cols-1 max-[900px]:gap-10">
    <div>
      <div class="font-semibold text-[11px] font-['JetBrains_Mono'] tracking-[.2em] text-[var(--accent-vis)] mb-[22px]">[ 06 ] LET'S BUILD</div>
      <h2 class="snz-display m-0 font-extrabold text-[76px] leading-[0.96] font-['Archivo'] tracking-[-0.04em]">Got a project<br>in mind?</h2>
      <p class="mt-[30px] mb-10 mx-0 max-w-[540px] font-normal text-[16px] leading-[1.65] font-['JetBrains_Mono'] text-[var(--ink-a)]">Tell me what you are building and where it is stuck. I will come back with a clear scope and price. The first call is free and there is no obligation to go ahead.</p>

      <div class="flex gap-[14px] flex-wrap">
        <span class="snz-magwrap"><a href="/consulting/find-your-fit/" class="inline-block font-bold text-[13px] font-['JetBrains_Mono'] tracking-[.04em] bg-[var(--accent)] text-[var(--ink)] py-4 px-6 no-underline" style="transition:transform .3s cubic-bezier(.2,.8,.2,1)">FIND YOUR FIT →</a></span>
      </div>
      <p class="mt-9 mb-0 font-medium text-[12px] font-['JetBrains_Mono'] tracking-[.04em] text-[var(--ink5)]">I only take on a handful of builds at a time, so slots are limited.</p>
    </div>

    <!-- founder: who you actually talk to (real details from the main site) -->
    <div data-reveal data-delay="90" class="border border-[rgba(var(--line-rgb),0.1)] bg-[var(--bg2)] p-8">
      <img
        src="/images/avatar.webp"
        alt="Aaron, the engineer you work with"
        width="380"
        height="380"
        loading="lazy"
        decoding="async"
        class="w-full aspect-[16/10] object-cover border border-[rgba(var(--line-rgb),0.12)] mb-5 block"
      />
      <div class="font-semibold text-[11px] font-['JetBrains_Mono'] tracking-[.2em] text-[var(--accent-vis)] mb-2.5">WHO YOU WORK WITH</div>
      <div class="flex items-center gap-2.5">
        <h3 class="m-0 font-extrabold text-[26px] font-['Archivo'] tracking-[-0.02em] text-[var(--ink0)]">Aaron <span class="font-medium text-[16px] text-[var(--ink5)]">(Snazzie)</span></h3>
        <a href={LINKEDIN} target="_blank" rel="noopener noreferrer" aria-label="Aaron's LinkedIn" class="inline-flex text-[var(--ink5)] hover:text-[var(--accent-vis)] transition-colors">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M23.994 24v-.001H24v-8.802c0-4.306-.927-7.623-5.961-7.623-2.42 0-4.044 1.328-4.707 2.587h-.07V7.976H8.489v16.023h4.97v-7.934c0-2.089.396-4.109 2.983-4.109 2.549 0 2.587 2.384 2.587 4.243V24zM.396 7.977h4.976V24H.396zM2.882 0C1.291 0 0 1.291 0 2.882s1.291 2.909 2.882 2.909 2.882-1.318 2.882-2.909A2.884 2.884 0 002.882 0z"></path></svg>
        </a>
      </div>
      <p class="mt-1 mb-3 font-medium text-[12.5px] font-['JetBrains_Mono'] tracking-[.04em] text-[var(--ink3)]">Software Engineer · All Stack · England</p>
      <p class="m-0 font-normal text-[14px] leading-[1.6] font-['JetBrains_Mono'] text-[var(--ink1)]">Full-stack across frontend, backend, cross-platform apps and cloud, focused on performance and clean systems. You deal with the person building it, start to finish. No account managers, no handoffs.</p>
    </div>
  </div>
</section>
