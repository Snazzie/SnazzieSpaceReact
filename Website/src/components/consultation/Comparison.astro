---
import BuilderTradeoff from './BuilderTradeoff.astro';
// Bold three-way comparison: build it yourself (WordPress/Squarespace),
// hire a WordPress developer, or work with me. "Me" column is the hero.
// Chip-ladder: one criterion per row, three options as chips.
// cells order is [diy (you + website builder), dev (WP shop), me (winner)].
type Cell = { text: string; tone?: 'bad' | 'mid' | 'good' };

const rows: { label: string; cells: Cell[] }[] = [
  {
    label: 'Experience',
    cells: [
      { text: 'Little idea what actually works', tone: 'bad' },
      { text: 'Drag-and-drop, not real devs', tone: 'bad' },
      { text: 'Pro engineer across many technologies', tone: 'good' },
    ],
  },
  {
    label: 'Look & feel',
    cells: [
      { text: 'Looks home-made', tone: 'bad' },
      { text: 'A dressed-up template, like every other WP site', tone: 'bad' },
      { text: 'Professional, optimised structure, unique brand-matching identity', tone: 'good' },
    ],
  },
  {
    label: 'Speed',
    cells: [
      { text: 'Slow and clunky', tone: 'bad' },
      { text: 'Bloated, laggy', tone: 'bad' },
      { text: 'Loads fast', tone: 'good' },
    ],
  },
  {
    label: 'Security',
    cells: [
      { text: 'Insecure builder logins and plugins', tone: 'bad' },
      { text: 'Pay extra for basics, still insecure', tone: 'bad' },
      { text: 'Secure by design, no extra cost', tone: 'good' },
    ],
  },
  {
    label: 'Found on search engines',
    cells: [
      { text: 'Hit or miss', tone: 'bad' },
      { text: 'Costs extra', tone: 'bad' },
      { text: 'Google, Bing, AI chat', tone: 'good' },
    ],
  },
  {
    label: 'Price',
    cells: [
      { text: 'Your time + paid add-ons', tone: 'bad' },
      { text: '£2k to £5k, plus monthly', tone: 'bad' },
      { text: 'From £1,500', tone: 'good' },
    ],
  },
  {
    label: 'Maintenance',
    cells: [
      { text: 'All on you', tone: 'bad' },
      { text: 'Ongoing fees', tone: 'bad' },
      { text: 'No monthly fee, changes from £20', tone: 'good' },
    ],
  },
  {
    label: 'When it breaks',
    cells: [
      { text: 'Search a forum', tone: 'bad' },
      { text: 'Wait in a queue', tone: 'bad' },
      { text: 'Just text me', tone: 'good' },
    ],
  },
];

const pad = (i: number) => String(i + 1).padStart(2, '0');
---
<section id="snz-compare" class="py-24 px-14 border-b border-[rgba(var(--line-rgb),0.08)]">
  <div data-reveal class="flex items-end justify-between flex-wrap gap-5 mb-[54px]">
    <div>
      <div class="font-semibold text-[11px] font-['JetBrains_Mono'] tracking-[.2em] text-[var(--accent-vis)] mb-[18px]">[ 02 ] THE CHOICE</div>
      <h2 class="snz-display m-0 font-extrabold text-[60px] leading-[0.98] font-['Archivo'] tracking-[-0.035em]">Three ways to do it</h2>
    </div>
    <p class="m-0 max-w-[340px] font-normal text-[14px] leading-[1.6] font-['JetBrains_Mono'] text-[var(--ink4)]">Same goal, three very different roads. Here's the honest version, side by side — no spin.</p>
  </div>

  <div class="snz-ladder">
    {rows.map((r, ri) => (
      <div data-reveal data-delay={ri * 40} class="snz-lrow">
        <div class="snz-lcrit"><span class="snz-lnum">{pad(ri)}</span>{r.label}</div>
        <div class="snz-lset">
          <div class="snz-chip snz-win">
            <div class="snz-who"><span class="snz-dot"></span>Me ✓</div>
            <div class="snz-txt">{r.cells[2].text}</div>
          </div>
          <div class="snz-chip">
            <div class="snz-who"><span class="snz-dot"></span>You + website builder</div>
            <div class="snz-txt">{r.cells[0].text}</div>
          </div>
          <div class="snz-chip">
            <div class="snz-who"><span class="snz-dot"></span>WP shop</div>
            <div class="snz-txt">{r.cells[1].text}</div>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- verdict band -->
  <div data-reveal class="mt-6 border border-[var(--accent)] py-9 px-10 flex items-center justify-between flex-wrap gap-6" style="background:linear-gradient(90deg,rgba(var(--accent-rgb),.1),var(--bg0))">
    <div>
      <h3 class="m-0 mb-2 font-extrabold text-[26px] font-['Archivo'] tracking-[-0.02em]">Same money. A site that's actually yours.</h3>
      <p class="m-0 max-w-[560px] font-normal text-[13.5px] leading-[1.6] font-['JetBrains_Mono'] text-[var(--ink3)]">Skip the template tax and the plugin treadmill. One person, hand-building something built around you — and a real human to call when you need one.</p>
    </div>
    <span class="snz-magwrap"><a href="/consulting/find-your-fit/" class="inline-block font-bold text-[13px] font-['JetBrains_Mono'] tracking-[.04em] bg-[var(--accent)] text-[var(--ink)] py-[15px] px-[22px] no-underline transition-transform duration-300 ease-[cubic-bezier(.2,.8,.2,1)]">FIND YOUR FIT →</a></span>
  </div>

  <!-- honest tradeoff: the one thing a builder genuinely does differently -->
  <div class="mt-6"><BuilderTradeoff /></div>
</section>

<style>
  /* section-scoped semantic tones: winner green, competitors orange (muted, professional) */
  #snz-compare { --snz-good: #2C7A54; --snz-bad: #B15A2B; max-width: 1040px; margin-left: auto; margin-right: auto; }
  :global(html[data-theme="dark"]) #snz-compare { --snz-good: #5FB98A; --snz-bad: #C77E52; }

  .snz-ladder { margin-top: 4px; }
  .snz-lrow {
    display: grid; grid-template-columns: 200px 1fr; gap: 26px; align-items: center;
    padding: 18px 0; border-top: 1px solid rgba(var(--line-rgb), 0.08);
  }
  .snz-lrow:first-child { border-top: none; }
  .snz-lcrit { font: 700 18px/1.2 'Archivo', sans-serif; letter-spacing: -0.02em; color: var(--ink0); }
  .snz-lnum { display: block; font: 600 11px/1 'JetBrains Mono', monospace; letter-spacing: .12em; color: var(--ink6); margin-bottom: 6px; }
  .snz-lset { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 22px; }
  .snz-who { display: flex; align-items: center; gap: 7px; font: 600 11px/1 'JetBrains Mono', monospace; letter-spacing: .1em; text-transform: uppercase; color: var(--ink6); margin-bottom: 9px; }
  .snz-txt { font: 400 15px/1.5 'JetBrains Mono', monospace; color: var(--ink4); }
  .snz-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--snz-bad); flex: none; }
  .snz-win .snz-who { color: var(--snz-good); }
  .snz-win .snz-txt { color: var(--ink0); font-weight: 500; }
  .snz-win .snz-dot { background: var(--snz-good); }

  @media (max-width: 860px) {
    #snz-compare { padding: 64px 22px !important; }
    .snz-lrow { grid-template-columns: 1fr; gap: 14px; }
    .snz-lset { grid-template-columns: 1fr; gap: 18px; }
  }
</style>
