---
// Bold three-way comparison: build it yourself (WordPress/Squarespace),
// hire a WordPress developer, or work with me. "Me" column is the hero.
const LINKEDIN = 'https://linkedin.com/in/cooper-a-m/';

type Cell = { text: string; tone?: 'bad' | 'mid' | 'good' };

const cols = [
  { key: 'diy', kicker: 'GO IT ALONE', title: 'You + WordPress / Squarespace', sub: 'Drag, drop, hope.' },
  { key: 'dev', kicker: 'HIRE A SHOP', title: 'A WordPress web developer', sub: 'Same templates, your money.' },
  { key: 'me', kicker: 'WORK WITH ME', title: 'Me', sub: 'Hand-built, start to finish.', hero: true },
];

const rows: { label: string; cells: Cell[] }[] = [
  {
    label: 'The design',
    cells: [
      { text: 'Often ends up looking home-made — flow and wording not quite there', tone: 'bad' },
      { text: 'A bought theme, dressed as custom', tone: 'mid' },
      { text: 'Unique, professional, from a blank canvas', tone: 'good' },
    ],
  },
  {
    label: 'Who builds it',
    cells: [
      { text: 'You, on YouTube tutorials', tone: 'bad' },
      { text: 'Often a theme setup, sometimes outsourced', tone: 'mid' },
      { text: 'Me — a real software engineer', tone: 'good' },
    ],
  },
  {
    label: 'The approach',
    cells: [
      { text: 'One tool for everything, like it or not', tone: 'bad' },
      { text: "WordPress for everything, even when it doesn't fit", tone: 'mid' },
      { text: 'Right tools picked per job — no over-complication, best value and experience', tone: 'good' },
    ],
  },
  {
    label: 'Time to live',
    cells: [
      { text: 'Weeks of evenings', tone: 'bad' },
      { text: 'Their queue, their pace', tone: 'mid' },
      { text: 'An agreed date I drive to', tone: 'good' },
    ],
  },
  {
    label: 'Speed',
    cells: [
      { text: 'Plugin bloat — slow, heavy pages', tone: 'bad' },
      { text: 'WordPress overhead, slow out the box', tone: 'mid' },
      { text: 'Hand-built and lightweight — loads fast', tone: 'good' },
    ],
  },
  {
    label: 'Security',
    cells: [
      { text: 'WordPress plugins — vulnerable from day one', tone: 'bad' },
      { text: 'Often charges for SSL and "security" that is free elsewhere', tone: 'mid' },
      { text: 'Secure by build — SSL/HTTPS free and included, no fake fees', tone: 'good' },
    ],
  },
  {
    label: 'SEO',
    cells: [
      { text: 'Bolted on, fingers crossed', tone: 'bad' },
      { text: 'Sold back as paid extras', tone: 'mid' },
      { text: 'Baked in, not an add-on', tone: 'good' },
    ],
  },
  {
    label: 'The real cost',
    cells: [
      { text: 'Cheap, then endless add-ons', tone: 'mid' },
      { text: '£2k to £5k, plus monthly fees', tone: 'bad' },
      { text: 'From £1500, hosting at cost (often zero host cost for simple websites)', tone: 'good' },
    ],
  },
  {
    label: 'Who owns it',
    cells: [
      { text: 'Squarespace does — leave, it dies', tone: 'bad' },
      { text: 'Locked to their stack', tone: 'mid' },
      { text: 'You, outright, forever', tone: 'good' },
    ],
  },
  {
    label: 'When it breaks',
    cells: [
      { text: 'A 2019 forum thread', tone: 'bad' },
      { text: 'A ticket and a queue', tone: 'mid' },
      { text: 'Text me — I built it', tone: 'good' },
    ],
  },
];

const dot = (tone?: string) =>
  tone === 'good' ? 'var(--accent)' : tone === 'mid' ? '#c9a227' : '#9a3b3b';
const ink = (tone?: string) =>
  tone === 'good' ? '#F2F0EA' : tone === 'mid' ? '#b8b8b0' : '#8a8a82';
---
<section id="snz-compare" class="py-24 px-14 border-b border-[rgba(255,255,255,0.08)]">
  <div data-reveal class="flex items-end justify-between flex-wrap gap-5 mb-[54px]">
    <div>
      <div class="font-semibold text-[11px] font-['JetBrains_Mono'] tracking-[.2em] text-[var(--accent)] mb-[18px]">[ 03 ] THE CHOICE</div>
      <h2 class="snz-display m-0 font-extrabold text-[60px] leading-[0.98] font-['Archivo'] tracking-[-0.035em]">Three ways to do it</h2>
    </div>
    <p class="m-0 max-w-[340px] font-normal text-[14px] leading-[1.6] font-['JetBrains_Mono'] text-[#8a8a82]">Same goal, three very different roads. Here's the honest version, side by side — no spin.</p>
  </div>

  <div id="snz-cmp" class="snz-cmp-desktop border border-[rgba(255,255,255,0.1)]">
    <!-- column heads -->
    <div class="snz-cmp-grid grid grid-cols-[1.05fr_1fr_1fr_1.15fr] bg-[rgba(255,255,255,0.08)] gap-[1px]">
      <div class="bg-[#0a0a0a]"></div>
      {cols.map((c, i) => (
        <div
          data-reveal
          data-delay={i * 80}
          class={`py-[30px] px-[26px] relative ${c.hero ? 'snz-cmp-hero' : 'bg-[#0a0a0a]'}`}
          style={c.hero ? 'background:linear-gradient(180deg,rgba(198,244,50,.12),#0c0c0c);box-shadow:inset 0 0 0 1px var(--accent)' : ''}
        >
          {c.hero && (
            <div class="absolute top-[-1px] right-[-1px] font-bold text-[10px] font-['JetBrains_Mono'] tracking-[.14em] bg-[var(--accent)] text-[#0a0a0a] py-[6px] px-3">PICK ME</div>
          )}
          <div class={`font-bold text-[10px] font-['JetBrains_Mono'] tracking-[.18em] mb-[14px] ${c.hero ? 'text-[var(--accent)]' : 'text-[#6a6a62]'}`}>{c.kicker}</div>
          <h3 class={`m-0 mb-2 font-extrabold ${c.hero ? 'text-[30px]' : 'text-[22px]'} leading-[1.04] font-['Archivo'] tracking-[-0.025em] ${c.hero ? 'text-[#F2F0EA]' : 'text-[#cfcfc7]'}`}>{c.title}</h3>
          <p class="m-0 font-normal text-[12.5px] leading-[1.5] font-['JetBrains_Mono'] text-[#7c7c74]">{c.sub}</p>
        </div>
      ))}
    </div>

    <!-- rows -->
    {rows.map((r, ri) => (
      <div data-reveal data-delay={ri * 50} class="snz-cmp-grid snz-cmp-row grid grid-cols-[1.05fr_1fr_1fr_1.15fr] bg-[rgba(255,255,255,0.08)] gap-[1px] border-t border-[rgba(255,255,255,0.06)]">
        <div class="snz-cmp-lab bg-[#0a0a0a] py-[22px] px-[26px] flex items-center font-semibold text-[12px] font-['JetBrains_Mono'] tracking-[.04em] text-[#6a6a62] uppercase">{r.label}</div>
        {r.cells.map((cell, ci) => {
          const hero = cols[ci].hero;
          return (
            <div style={`background:${hero ? 'rgba(198,244,50,.05)' : '#0a0a0a'};padding:22px 26px;display:flex;gap:12px;align-items:flex-start;${hero ? 'box-shadow:inset 1px 0 0 rgba(198,244,50,.25),inset -1px 0 0 rgba(198,244,50,.25)' : ''}`}>
              <span style={`flex:none;width:7px;height:7px;border-radius:50%;margin-top:6px;background:${dot(cell.tone)};${cell.tone === 'good' ? 'box-shadow:0 0 8px var(--accent)' : ''}`}></span>
              <span style={`font:400 13.5px/1.5 'JetBrains Mono',monospace;color:${ink(cell.tone)}`}>{cell.text}</span>
            </div>
          );
        })}
      </div>
    ))}
  </div>

  <!-- mobile: one card per option, each listing every row -->
  <div class="snz-cmp-mobile">
    {cols.map((c, ci) => (
      <div
        data-reveal
        data-delay={ci * 70}
        class={`snz-cmp-card relative mb-[14px] border ${c.hero ? 'border-[var(--accent)]' : 'border-[rgba(255,255,255,0.1)]'}`}
        style={c.hero ? 'background:linear-gradient(180deg,rgba(198,244,50,.1),#0a0a0a)' : 'background:#0a0a0a'}
      >
        {c.hero && (
          <div class="absolute top-0 right-0 font-bold text-[10px] font-['JetBrains_Mono'] tracking-[.14em] bg-[var(--accent)] text-[#0a0a0a] py-[5px] px-[10px]">PICK ME</div>
        )}
        <div class="py-[22px] px-[22px] border-b border-[rgba(255,255,255,0.08)]">
          <div class={`font-bold text-[10px] font-['JetBrains_Mono'] tracking-[.18em] mb-[12px] ${c.hero ? 'text-[var(--accent)]' : 'text-[#6a6a62]'}`}>{c.kicker}</div>
          <h3 class={`m-0 mb-2 font-extrabold text-[24px] leading-[1.04] font-['Archivo'] tracking-[-0.025em] ${c.hero ? 'text-[#F2F0EA]' : 'text-[#cfcfc7]'}`}>{c.title}</h3>
          <p class="m-0 font-normal text-[12.5px] leading-[1.5] font-['JetBrains_Mono'] text-[#7c7c74]">{c.sub}</p>
        </div>
        <div>
          {rows.map((r) => {
            const cell = r.cells[ci];
            return (
              <div class="py-[16px] px-[22px] border-b border-[rgba(255,255,255,0.05)] last:border-b-0">
                <div class="font-semibold text-[10.5px] font-['JetBrains_Mono'] tracking-[.1em] text-[#6a6a62] uppercase mb-[8px]">{r.label}</div>
                <div class="flex gap-[10px] items-start">
                  <span style={`flex:none;width:7px;height:7px;border-radius:50%;margin-top:6px;background:${dot(cell.tone)};${cell.tone === 'good' ? 'box-shadow:0 0 8px var(--accent)' : ''}`}></span>
                  <span style={`font:400 13.5px/1.5 'JetBrains Mono',monospace;color:${ink(cell.tone)}`}>{cell.text}</span>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    ))}
  </div>

  <!-- verdict band -->
  <div data-reveal class="mt-6 border border-[var(--accent)] py-9 px-10 flex items-center justify-between flex-wrap gap-6" style="background:linear-gradient(90deg,rgba(198,244,50,.1),#0a0a0a)">
    <div>
      <h3 class="m-0 mb-2 font-extrabold text-[26px] font-['Archivo'] tracking-[-0.02em]">Same money. A site that's actually yours.</h3>
      <p class="m-0 max-w-[560px] font-normal text-[13.5px] leading-[1.6] font-['JetBrains_Mono'] text-[#9a9a92]">Skip the template tax and the plugin treadmill. One person, hand-building something built around you — and a real human to call when you need one.</p>
    </div>
    <span class="snz-magwrap"><a data-mag href={LINKEDIN} class="inline-block font-bold text-[13px] font-['JetBrains_Mono'] tracking-[.04em] bg-[var(--accent)] text-[#0a0a0a] py-[15px] px-[22px] no-underline transition-transform duration-300 ease-[cubic-bezier(.2,.8,.2,1)]">GET IN TOUCH →</a></span>
  </div>
</section>

<style>
  .snz-cmp-mobile { display: none; }
  @media (max-width: 860px) {
    #snz-compare { padding: 64px 22px !important; }
    .snz-cmp-desktop { display: none !important; }
    .snz-cmp-mobile { display: block; }
  }
</style>
