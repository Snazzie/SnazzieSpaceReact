---
// Bold three-way comparison: build it yourself (WordPress/Squarespace),
// hire a WordPress developer, or work with me. "Me" column is the hero.
const LINKEDIN = 'https://linkedin.com/in/cooper-a-m/';

type Cell = { text: string; tone?: 'bad' | 'mid' | 'good' };

const cols = [
  { key: 'diy', kicker: 'GO IT ALONE', title: 'You + WordPress / Squarespace', sub: 'Drag, drop, hope.' },
  { key: 'dev', kicker: 'HIRE A SHOP', title: 'A WordPress web developer', sub: 'Same templates, your money.' },
  { key: 'me', kicker: 'WORK WITH ME', title: 'Me', sub: 'Hand-built, start to finish.', hero: true },
];

const rows: { label: string; cells: Cell[] }[] = [
  {
    label: 'What you actually get',
    cells: [
      { text: 'A template thousands of others already use', tone: 'bad' },
      { text: 'A template, dressed up to look custom', tone: 'mid' },
      { text: 'A one-of-a-kind site that looks genuinely professional and beautiful, built from a blank canvas', tone: 'good' },
    ],
  },
  {
    label: 'The design',
    cells: [
      { text: 'Pick a theme everyone else already picked', tone: 'bad' },
      { text: 'A bought theme, nudged to look custom', tone: 'mid' },
      { text: 'Designed around you from a blank canvas — no template underneath', tone: 'good' },
    ],
  },
  {
    label: 'Time to live',
    cells: [
      { text: 'Weeks of evenings, then it stalls', tone: 'bad' },
      { text: 'Their queue, their pace, slow revisions', tone: 'mid' },
      { text: 'An agreed date, and I drive it there', tone: 'good' },
    ],
  },
  {
    label: 'Who builds it',
    cells: [
      { text: 'You, after the day job, on YouTube tutorials', tone: 'bad' },
      { text: 'Often junior staff or outsourced overseas', tone: 'mid' },
      { text: 'Me — the person you actually talk to', tone: 'good' },
    ],
  },
  {
    label: 'Security, speed & SEO',
    cells: [
      { text: 'Plugins bolted on after, hope they hold', tone: 'bad' },
      { text: 'Sold back to you as paid extras', tone: 'mid' },
      { text: 'Baked in from the first line — the foundation, not an add-on', tone: 'good' },
    ],
  },
  {
    label: 'What gets promised',
    cells: [
      { text: 'Whatever the tutorial swore was easy', tone: 'bad' },
      { text: 'Promise the world, deliver it on janky plugins', tone: 'mid' },
      { text: 'I promise what I can build, then build it for real', tone: 'good' },
    ],
  },
  {
    label: 'The real cost',
    cells: [
      { text: 'Cheap upfront, then monthly hosting + themes + plugins + your time', tone: 'mid' },
      { text: '£2k–£5k, plus marked-up monthly hosting & licence fees forever', tone: 'bad' },
      { text: 'From £700, honest hosting at cost (often zero for simple sites)', tone: 'good' },
    ],
  },
  {
    label: 'Hidden fees',
    cells: [
      { text: 'Premium plugins nag you forever', tone: 'bad' },
      { text: 'Padded "security" & care packages', tone: 'bad' },
      { text: 'None — you pay hosting at cost, no markup', tone: 'good' },
    ],
  },
  {
    label: 'Who owns it',
    cells: [
      { text: 'Squarespace does. Leave and it dies', tone: 'bad' },
      { text: 'Locked to their stack & their plugins', tone: 'mid' },
      { text: 'You. Outright. Yours to keep forever', tone: 'good' },
    ],
  },
  {
    label: 'When it breaks',
    cells: [
      { text: 'A forum thread from 2019', tone: 'bad' },
      { text: 'A ticket, a queue, a wait', tone: 'mid' },
      { text: 'Text me. A real human who built it', tone: 'good' },
    ],
  },
];

const dot = (tone?: string) =>
  tone === 'good' ? 'var(--accent)' : tone === 'mid' ? '#c9a227' : '#9a3b3b';
const ink = (tone?: string) =>
  tone === 'good' ? '#F2F0EA' : tone === 'mid' ? '#b8b8b0' : '#8a8a82';
---
<section id="snz-compare" style="padding:96px 56px;border-bottom:1px solid rgba(255,255,255,.08)">
  <div data-reveal style="display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:20px;margin-bottom:54px">
    <div>
      <div style="font:600 11px 'JetBrains Mono',monospace;letter-spacing:.2em;color:var(--accent);margin-bottom:18px">[ 02 ] THE CHOICE</div>
      <h2 class="snz-display" style="margin:0;font:800 60px/0.98 'Archivo',sans-serif;letter-spacing:-0.035em">Three ways to do it</h2>
    </div>
    <p style="margin:0;max-width:340px;font:400 14px/1.6 'JetBrains Mono',monospace;color:#8a8a82">Same goal, three very different roads. Here's the honest version, side by side — no spin.</p>
  </div>

  <div id="snz-cmp" style="border:1px solid rgba(255,255,255,.1)">
    <!-- column heads -->
    <div class="snz-cmp-grid" style="display:grid;grid-template-columns:1.05fr 1fr 1fr 1.15fr;background:rgba(255,255,255,.08);gap:1px">
      <div style="background:#0a0a0a"></div>
      {cols.map((c, i) => (
        <div
          data-reveal
          data-delay={i * 80}
          class={c.hero ? 'snz-cmp-hero' : ''}
          style={`background:${c.hero ? 'linear-gradient(180deg,rgba(198,244,50,.12),#0c0c0c)' : '#0a0a0a'};padding:30px 26px;position:relative;${c.hero ? 'box-shadow:inset 0 0 0 1px var(--accent)' : ''}`}
        >
          {c.hero && (
            <div style="position:absolute;top:-1px;right:-1px;font:700 10px 'JetBrains Mono',monospace;letter-spacing:.14em;background:var(--accent);color:#0a0a0a;padding:6px 12px">PICK ME</div>
          )}
          <div style={`font:700 10px 'JetBrains Mono',monospace;letter-spacing:.18em;margin-bottom:14px;color:${c.hero ? 'var(--accent)' : '#6a6a62'}`}>{c.kicker}</div>
          <h3 style={`margin:0 0 8px;font:800 ${c.hero ? '30' : '22'}px/1.04 'Archivo',sans-serif;letter-spacing:-0.025em;color:${c.hero ? '#F2F0EA' : '#cfcfc7'}`}>{c.title}</h3>
          <p style="margin:0;font:400 12.5px/1.5 'JetBrains Mono',monospace;color:#7c7c74">{c.sub}</p>
        </div>
      ))}
    </div>

    <!-- rows -->
    {rows.map((r, ri) => (
      <div data-reveal data-delay={ri * 50} class="snz-cmp-grid snz-cmp-row" style="display:grid;grid-template-columns:1.05fr 1fr 1fr 1.15fr;background:rgba(255,255,255,.08);gap:1px;border-top:1px solid rgba(255,255,255,.06)">
        <div class="snz-cmp-lab" style="background:#0a0a0a;padding:22px 26px;display:flex;align-items:center;font:600 12px 'JetBrains Mono',monospace;letter-spacing:.04em;color:#6a6a62;text-transform:uppercase">{r.label}</div>
        {r.cells.map((cell, ci) => {
          const hero = cols[ci].hero;
          return (
            <div style={`background:${hero ? 'rgba(198,244,50,.05)' : '#0a0a0a'};padding:22px 26px;display:flex;gap:12px;align-items:flex-start;${hero ? 'box-shadow:inset 1px 0 0 rgba(198,244,50,.25),inset -1px 0 0 rgba(198,244,50,.25)' : ''}`}>
              <span style={`flex:none;width:7px;height:7px;border-radius:50%;margin-top:6px;background:${dot(cell.tone)};${cell.tone === 'good' ? 'box-shadow:0 0 8px var(--accent)' : ''}`}></span>
              <span style={`font:400 13.5px/1.5 'JetBrains Mono',monospace;color:${ink(cell.tone)}`}>{cell.text}</span>
            </div>
          );
        })}
      </div>
    ))}
  </div>

  <!-- verdict band -->
  <div data-reveal style="margin-top:24px;border:1px solid var(--accent);background:linear-gradient(90deg,rgba(198,244,50,.1),#0a0a0a);padding:36px 40px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:24px">
    <div>
      <h3 style="margin:0 0 8px;font:800 26px 'Archivo',sans-serif;letter-spacing:-0.02em">Same money. A site that's actually yours.</h3>
      <p style="margin:0;max-width:560px;font:400 13.5px/1.6 'JetBrains Mono',monospace;color:#9a9a92">Skip the template tax and the plugin treadmill. One person, hand-building something built around you — and a real human to call when you need one.</p>
    </div>
    <span class="snz-magwrap"><a data-mag href={LINKEDIN} style="display:inline-block;font:700 13px 'JetBrains Mono',monospace;letter-spacing:.04em;background:var(--accent);color:#0a0a0a;padding:15px 22px;text-decoration:none;transition:transform .3s cubic-bezier(.2,.8,.2,1)">START HERE →</a></span>
  </div>
</section>

<style>
  @media (max-width: 860px) {
    #snz-compare { padding: 64px 22px !important; }
    .snz-cmp-grid { grid-template-columns: 1fr !important; }
    .snz-cmp-row .snz-cmp-lab {
      box-shadow: inset 0 0 0 1px rgba(255,255,255,.06);
      color: var(--accent) !important;
    }
  }
</style>
