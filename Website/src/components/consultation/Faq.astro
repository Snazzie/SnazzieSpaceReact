---
// FAQ: consolidates the common objections that were scattered across the page,
// and emits FAQPage structured data so the answers can surface in search / AI.
const faqs = [
  {
    q: 'How much will my website cost?',
    a: "Bespoke sites start from £1500. That is purely the build. Your domain and any hosting are paid directly to the providers at cost, often close to nothing for a simple site. Apps, products and anything larger are quoted once we have scoped them together.",
  },
  {
    q: 'How long does it take?',
    a: 'Most small-business sites go from agreed design to live in a few weeks. You get a delivery date before any build work starts, and an agreed date I drive to.',
  },
  {
    q: 'Do I actually own it?',
    a: 'Yes, outright. The code, the domain and the accounts are all in your name from day one. No lock-in and no hostage hosting, so you can walk away whenever you like.',
  },
  {
    q: 'Do I need to be technical?',
    a: 'Not at all. Everything is explained in plain English, you get full handover notes, and if you would rather not touch the running of it I can manage it all for you.',
  },
  {
    q: 'What if I do not like the design?',
    a: 'You approve the mock-ups before any build begins, with up to five rounds of changes until you genuinely love it. The deposit covers the design stage and is credited in full against the final fee once we proceed.',
  },
  {
    q: 'What are the ongoing costs?',
    a: 'Just your domain and hosting, paid at cost and often very low. Optional Monthly Care from £40/mo keeps the site updated, healthy and growing, and you can cancel anytime.',
  },
  {
    q: 'Why not just use WordPress or Squarespace?',
    a: 'Hand-built sites load faster, are more secure, are fully yours to own, and are shaped around your business instead of a template everyone else is also using.',
  },
  {
    q: 'Where are you based and who will I deal with?',
    a: 'UK-based, and you deal directly with me, the person actually building it. No account managers, no outsourcing and no support queue.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<section id="snz-faq" class="py-24 px-14 border-b border-[rgba(255,255,255,0.08)] max-[760px]:py-16 max-[760px]:px-[22px]">
  <div data-reveal class="flex items-end justify-between flex-wrap gap-5 mb-[44px]">
    <div>
      <div class="font-semibold text-[11px] font-['JetBrains_Mono'] tracking-[.2em] text-[var(--accent)] mb-[18px]">[ 08 ] QUESTIONS</div>
      <h2 class="snz-display m-0 font-extrabold text-[60px] leading-[0.98] font-['Archivo'] tracking-[-0.035em] max-[760px]:text-[42px]">The honest answers</h2>
    </div>
    <p class="m-0 max-w-[340px] font-normal text-[14px] leading-[1.6] font-['JetBrains_Mono'] text-[#8a8a82]">The things people ask before we start. Anything else, just email me.</p>
  </div>

  <div class="border-t border-[rgba(255,255,255,0.1)]">
    {faqs.map((f, i) => (
      <details data-reveal data-delay={(i % 4) * 50} class="snz-faq group border-b border-[rgba(255,255,255,0.1)]">
        <summary class="flex items-center justify-between gap-6 py-6 cursor-pointer list-none select-none">
          <span class="font-bold text-[clamp(17px,2.2vw,22px)] font-['Archivo'] tracking-[-0.01em] text-[#F2F0EA]">{f.q}</span>
          <span aria-hidden="true" class="snz-faq-ico flex-none w-7 h-7 grid place-items-center rounded-full border border-[rgba(255,255,255,0.18)] text-[var(--accent)] text-[16px] leading-none transition-transform duration-300">+</span>
        </summary>
        <p class="m-0 pb-7 pr-12 max-w-[760px] font-normal text-[14px] leading-[1.7] font-['JetBrains_Mono'] text-[#9a9a92] max-[760px]:pr-0">{f.a}</p>
      </details>
    ))}
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  .snz-faq summary::-webkit-details-marker { display: none; }
  .snz-faq[open] .snz-faq-ico { transform: rotate(45deg); }
  .snz-faq summary:hover .snz-faq-ico { border-color: var(--accent); }
  @media (max-width: 860px) {
    #snz-faq { padding: 64px 22px !important; }
  }
</style>
