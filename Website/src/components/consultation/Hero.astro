---
// Hero: headline with cycling word, wireframe preview, and the stat strip.
const LINKEDIN = 'https://linkedin.com/in/cooper-a-m/';

const stats = [
  { value: 'Anything digital', label: 'websites · apps · products' },
  { value: 'From £1500', label: 'for a bespoke website' },
  { value: '5 rounds', label: 'design tweaks, til you love it' },
  { value: 'Just me', label: 'you talk to the maker direct' },
];
---
<section id="snz-top" style="position:relative;z-index:1;border-bottom:1px solid rgba(var(--line-rgb),.08)">
  <!-- shell: pinned + scrubbed on scroll so the persistent wireframe wall is revealed fullscreen -->
  <div id="snz-heroshell" style="position:relative;z-index:1;display:flex;flex-direction:column;min-height:calc(100vh - var(--snz-nav-h,56px))">
  <div id="snz-hero" style="position:relative;flex:1;display:grid;grid-template-columns:var(--snz-l,1fr) var(--snz-d,72px) 1.2fr;min-height:calc(100vh - 52px - 124px)">
    <!-- LEFT (opaque, hides the wall behind; grid texture kept) -->
    <div id="snz-heroL" style="padding:48px 56px;display:flex;flex-direction:column;justify-content:center;overflow:hidden;background:var(--bg1);background-image:linear-gradient(rgba(var(--line-rgb),.035) 1px,transparent 1px),linear-gradient(90deg,rgba(var(--line-rgb),.035) 1px,transparent 1px);background-size:34px 34px">
      <div style="font:600 11px 'JetBrains Mono',monospace;letter-spacing:.2em;color:var(--ink5);margin-bottom:26px">FOR INDIVIDUALS &amp; SMALL BUSINESSES · UK</div>
      <h1 class="snz-h1" style="margin:0;font:800 72px/0.98 'Archivo',sans-serif;letter-spacing:-0.035em">I build your<br><span style="display:inline-flex;align-items:baseline;gap:4px"><span id="snz-word" style="color:var(--accent-text)">website</span><span style="display:inline-block;width:5px;height:.78em;background:var(--accent);animation:snz-blink 1.05s steps(1) infinite;transform:translateY(2px)"></span></span></h1>
      <p style="margin:28px 0 0;max-width:480px;font:400 16px/1.65 'JetBrains Mono',monospace;color:var(--ink-a)">Anyone can put a site online. Winning customers with it is the hard part. Your site is your best salesperson, so let a real engineer hand-build you one that earns its keep.</p>
      <div style="display:flex;gap:14px;margin-top:38px;flex-wrap:wrap">
        <span class="snz-magwrap"><a data-mag href={LINKEDIN} style="display:inline-block;font:700 13px 'JetBrains Mono',monospace;letter-spacing:.04em;background:var(--accent);color:var(--ink);padding:15px 22px;text-decoration:none;transition:transform .3s cubic-bezier(.2,.8,.2,1)">GET IN TOUCH →</a></span>
        <span class="snz-magwrap"><a data-mag href="mailto:info@snazzie.space" style="display:inline-block;font:700 13px 'JetBrains Mono',monospace;letter-spacing:.04em;border:1px solid rgba(var(--line-rgb),.22);color:var(--ink0);padding:15px 22px;text-decoration:none;transition:transform .3s cubic-bezier(.2,.8,.2,1)">EMAIL ME</a></span>
      </div>
    </div>
    <!-- DIVIDER WALL -->
    <div id="snz-heroDiv" style="position:relative;background:var(--bg-deep);display:flex;flex-direction:column;align-items:center;overflow:hidden">
      <!-- left border -->
      <div style="position:absolute;top:0;bottom:0;left:12px;width:2px;background:rgba(var(--line-rgb),.55)"></div>
      <!-- right border -->
      <div style="position:absolute;top:0;bottom:0;right:12px;width:2px;background:rgba(var(--line-rgb),.55)"></div>
      <!-- inner fill between borders -->
      <div style="position:absolute;top:0;bottom:0;left:14px;right:14px;background:rgba(var(--line-rgb),.02)"></div>
      <!-- tick marks spanning full width between borders -->
      {[12,22,32,42,52,62,72,82,88].map(pct => (
        <div style={`position:absolute;top:${pct}%;left:14px;right:14px;height:1px;background:rgba(var(--line-rgb),.12)`}></div>
      ))}
      <!-- centre diamond -->
      <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) rotate(45deg);width:12px;height:12px;background:var(--pure0);z-index:1"></div>
    </div>
    <!-- RIGHT : transparent, reveals the shared wireframe wall behind -->
    <div class="snz-right" style="position:relative;background:transparent;overflow:hidden"></div>
  </div>
  <!-- STAT STRIP -->
  <div id="snz-stats" style="position:relative;display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid rgba(var(--line-rgb),.08);overflow:hidden;background:var(--bg1)">
    {stats.map((s, i) => (
      <div style={`padding:26px 32px;${i < stats.length - 1 ? 'border-right:1px solid rgba(var(--line-rgb),.08)' : ''}`}>
        <div style="font:800 26px 'Archivo',sans-serif;letter-spacing:-0.02em">{s.value}</div>
        <div style="font:500 12px 'JetBrains Mono',monospace;color:var(--ink5);margin-top:6px">{s.label}</div>
      </div>
    ))}
  </div>
  </div><!-- /snz-heroshell -->
</section>

<style>
  @keyframes snz-wall-up {
    from { transform: translateY(0); }
    to   { transform: translateY(-50%); }
  }
  @keyframes snz-wall-dn {
    from { transform: translateY(-50%); }
    to   { transform: translateY(0); }
  }
  .snz-col-up  { animation: snz-wall-up 28s linear infinite; animation-play-state: paused; }
  .snz-col-dn  { animation: snz-wall-dn 22s linear infinite; animation-play-state: paused; }
  .snz-col-up2 { animation: snz-wall-up 34s linear infinite; animation-play-state: paused; }
  .snz-col-dn2 { animation: snz-wall-dn 26s linear infinite; animation-play-state: paused; }
  .snz-col-up.snz-ready, .snz-col-up2.snz-ready { animation-play-state: running; }
  .snz-col-dn.snz-ready, .snz-col-dn2.snz-ready { animation-play-state: running; }
  .snz-wf { border-radius: 6px; display: block; }
  @media (prefers-reduced-motion: reduce) {
    .snz-col-up, .snz-col-dn, .snz-col-up2, .snz-col-dn2 { animation: none; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  // Cycle the accent word in the hero headline.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const word = document.getElementById('snz-word');
  if (word && !reduce) {
    const words = ['website', 'mobile app', 'product', 'service'];
    let i = 0;
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    (async () => {
      while (true) {
        await wait(2200);
        i = (i + 1) % words.length;
        const next = words[i];
        const out = word.animate(
          [{ opacity: 1, transform: 'translateY(0)' }, { opacity: 0, transform: 'translateY(-10px)' }],
          { duration: 200, easing: 'ease-in', fill: 'forwards' },
        );
        out.onfinish = () => {
          word.textContent = next;
          word.animate(
            [{ opacity: 0, transform: 'translateY(10px)' }, { opacity: 1, transform: 'translateY(0)' }],
            { duration: 300, easing: 'cubic-bezier(.2,.9,.2,1.2)', fill: 'forwards' },
          );
        };
      }
    })();
  }

  // The wireframe wall (#snz-wbg) is shared with the build story and is booted by buildflow.ts.

  // Hero → BuildFlow: pin the hero, reveal the shared wireframe wall fullscreen on scroll.
  // Skipped for reduced-motion and mobile (hero is single-column there).
  if (!reduce && window.matchMedia('(min-width: 881px)').matches) {
    gsap.registerPlugin(ScrollTrigger);

    // Keep the sticky-shell height in sync with the consultation nav.
    const setNavH = () => {
      const nav = document.getElementById('snz-cnav');
      if (nav) document.documentElement.style.setProperty('--snz-nav-h', nav.offsetHeight + 'px');
    };
    setNavH();
    window.addEventListener('resize', setNavH, { passive: true });

    const hero = document.getElementById('snz-hero');
    if (hero) {
      const grid = { l: 1, d: 72 };
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: '#snz-top',
          start: 'top top',
          end: '+=90%',
          scrub: 0.6,
          pin: '#snz-heroshell',
          anticipatePin: 1,
          invalidateOnRefresh: true,
        },
      });
      // widen the right wall by collapsing the left + divider grid tracks to zero
      tl.to(grid, {
        l: 0, d: 0, duration: 1, ease: 'none',
        onUpdate: () => {
          hero.style.setProperty('--snz-l', grid.l + 'fr');
          hero.style.setProperty('--snz-d', grid.d + 'px');
        },
      }, 0);
      // fade + slide the left text and divider out of the way
      tl.to('#snz-heroL', { autoAlpha: 0, x: -60, duration: 0.55, ease: 'none' }, 0);
      tl.to('#snz-heroDiv', { autoAlpha: 0, duration: 0.5, ease: 'none' }, 0);
      // collapse the stat strip so the wall grows to full height
      tl.to('#snz-stats', { autoAlpha: 0, height: 0, duration: 0.6, ease: 'none' }, 0.35);
    }
  }
</script>
