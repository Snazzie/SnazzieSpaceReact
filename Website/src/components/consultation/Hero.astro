---
// Hero: headline with cycling word, wireframe preview, and the stat strip.
const LINKEDIN = 'https://linkedin.com/in/cooper-a-m/';

const stats = [
  { value: 'Anything digital', label: 'websites · apps · products' },
  { value: 'From £700', label: 'for a bespoke website' },
  { value: '5 rounds', label: 'design tweaks, til you love it' },
  { value: 'Just me', label: 'you talk to the maker direct' },
];
---
<section id="snz-top" style="position:relative;border-bottom:1px solid rgba(255,255,255,.08)">
  <div id="snz-gridbg" style="position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);background-size:34px 34px;pointer-events:none"></div>
  <div id="snz-hero" style="position:relative;display:grid;grid-template-columns:1fr 72px 1.2fr;min-height:calc(100vh - 52px - 124px)">
    <!-- LEFT -->
    <div style="padding:48px 56px;display:flex;flex-direction:column;justify-content:center">
      <div style="font:600 11px 'JetBrains Mono',monospace;letter-spacing:.2em;color:#7c7c74;margin-bottom:26px">FOR INDIVIDUALS &amp; SMALL BUSINESSES — UK</div>
      <h1 class="snz-h1" style="margin:0;font:800 72px/0.98 'Archivo',sans-serif;letter-spacing:-0.035em">I build your<br><span style="display:inline-flex;align-items:baseline;gap:4px"><span id="snz-word" style="color:var(--accent)">website</span><span style="display:inline-block;width:5px;height:.78em;background:var(--accent);animation:snz-blink 1.05s steps(1) infinite;transform:translateY(2px)"></span></span></h1>
      <p style="margin:28px 0 0;max-width:480px;font:400 16px/1.65 'JetBrains Mono',monospace;color:#a8a89f">Building a product is easy. Building one that sells is not. Your product is your most powerful sales tool — leave it to the real professional to build you one that leaves an impression.</p>
      <div style="display:flex;gap:14px;margin-top:38px;flex-wrap:wrap">
        <span class="snz-magwrap"><a data-mag href={LINKEDIN} style="display:inline-block;font:700 13px 'JetBrains Mono',monospace;letter-spacing:.04em;background:var(--accent);color:var(--ink);padding:15px 22px;text-decoration:none;transition:transform .3s cubic-bezier(.2,.8,.2,1)">GET IN TOUCH →</a></span>
        <span class="snz-magwrap"><a data-mag href="mailto:info@snazzie.space" style="display:inline-block;font:700 13px 'JetBrains Mono',monospace;letter-spacing:.04em;border:1px solid rgba(255,255,255,.22);color:#F2F0EA;padding:15px 22px;text-decoration:none;transition:transform .3s cubic-bezier(.2,.8,.2,1)">EMAIL ME</a></span>
      </div>
    </div>
    <!-- DIVIDER WALL -->
    <div style="position:relative;background:#080808;display:flex;flex-direction:column;align-items:center;overflow:hidden">
      <!-- left border -->
      <div style="position:absolute;top:0;bottom:0;left:12px;width:2px;background:rgba(255,255,255,.55)"></div>
      <!-- right border -->
      <div style="position:absolute;top:0;bottom:0;right:12px;width:2px;background:rgba(255,255,255,.55)"></div>
      <!-- inner fill between borders -->
      <div style="position:absolute;top:0;bottom:0;left:14px;right:14px;background:rgba(255,255,255,.02)"></div>
      <!-- tick marks spanning full width between borders -->
      {[12,22,32,42,52,62,72,82,88].map(pct => (
        <div style={`position:absolute;top:${pct}%;left:14px;right:14px;height:1px;background:rgba(255,255,255,.12)`}></div>
      ))}
      <!-- centre diamond -->
      <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) rotate(45deg);width:12px;height:12px;background:#fff;z-index:1"></div>
      <!-- rotated label -->
      <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) rotate(-90deg);white-space:nowrap;font:800 8px 'JetBrains Mono',monospace;letter-spacing:.22em;color:#080808;z-index:2">SNAZZIE°</div>
    </div>
    <!-- RIGHT : WIREFRAME WALL -->
    <div class="snz-right" style="position:relative;background:#0c0c0c;overflow:hidden">
      <!-- top/bottom fade masks -->
