---
// Ownership & handover: client owns the app outright. On completion all
// service + hosting costs are theirs to manage — or they pay a monthly fee
// for me to admin it for them.
const LINKEDIN = 'https://linkedin.com/in/cooper-a-m/';

const steps = [
  { n: '01', title: 'I build it', body: 'Designed and developed end to end, around your business — no templates, no lock-in.' },
  { n: '02', title: 'You own it', body: 'On completion the whole thing is yours outright. The code, the accounts, the domain — all in your name.' },
  { n: '03', title: 'You hold the keys', body: 'From handover, the service and hosting accounts are yours to manage, paid directly to the providers at cost.' },
];

const selfManage = [
  'Everything in your name and your control',
  'Pay hosting & domain providers directly, at cost',
  'No monthly fee to me — walk away anytime',
  'Full handover notes so nothing is a mystery',
];

const managed = [
  'I provision & admin your hosting/domain accounts — still in your name',
  'Updates, content changes & uptime watched',
  'Legal obligations upkeep (GDPR & cookie-consent)',
  'One person to call — no tickets, no queue',
];
---
<section id="snz-ownership" style="padding:96px 56px;border-bottom:1px solid rgba(255,255,255,.08)">
  <div data-reveal style="display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:20px;margin-bottom:54px">
    <div>
      <div style="font:600 11px 'JetBrains Mono',monospace;letter-spacing:.2em;color:var(--accent);margin-bottom:18px">[ 04 ] OWNERSHIP</div>
      <h2 class="snz-display" style="margin:0;font:800 60px/0.98 'Archivo',sans-serif;letter-spacing:-0.035em">It's yours. Really yours.</h2>
    </div>
    <p style="margin:0;max-width:340px;font:400 14px/1.6 'JetBrains Mono',monospace;color:#8a8a82">No lock-in, no hostage hosting. When the job's done, you own the lot — and you choose who runs it.</p>
  </div>

  <!-- visual: a browser window handed over, stamped owned -->
  <div data-reveal id="snz-own-vis" style="border:1px solid rgba(255,255,255,.12);background:#0c0c0c;margin-bottom:24px;overflow:hidden">
    <!-- browser chrome -->
    <div style="display:flex;align-items:center;gap:14px;padding:14px 18px;border-bottom:1px solid rgba(255,255,255,.08);background:#0a0a0a">
      <div style="display:flex;gap:7px">
        <span style="width:11px;height:11px;border-radius:50%;background:#3a3a36"></span>
        <span style="width:11px;height:11px;border-radius:50%;background:#3a3a36"></span>
        <span style="width:11px;height:11px;border-radius:50%;background:#3a3a36"></span>
      </div>
      <div style="flex:1;max-width:340px;font:500 12px 'JetBrains Mono',monospace;color:#7c7c74;background:#141414;border:1px solid rgba(255,255,255,.06);border-radius:5px;padding:7px 12px">
        <span style="color:var(--accent)">https://</span>your-business.com
      </div>
      <div style="font:600 10px 'JetBrains Mono',monospace;letter-spacing:.14em;color:var(--accent)">● LIVE</div>
    </div>
    <!-- canvas with deed stamp -->
    <div style="position:relative;display:grid;place-items:center;min-height:230px;padding:48px 24px;background:radial-gradient(120% 140% at 50% 0%,rgba(198,244,50,.07),#0c0c0c 60%);overflow:hidden">
      <!-- faint wireframe lines -->
      <div aria-hidden="true" style="position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);background-size:34px 34px;mask-image:radial-gradient(120% 100% at 50% 30%,#000,transparent 75%)"></div>
      <div style="position:relative;text-align:center">
        <div style="font:700 11px 'JetBrains Mono',monospace;letter-spacing:.24em;color:#7c7c74;margin-bottom:14px">DEED OF OWNERSHIP</div>
        <div class="snz-display" style="font:800 clamp(34px,6vw,68px)/0.95 'Archivo',sans-serif;letter-spacing:-0.04em">100% yours.</div>
        <div style="font:400 13px/1.6 'JetBrains Mono',monospace;color:#9a9a92;margin-top:14px;max-width:380px">Code, domain and accounts — all signed over to your name on day one.</div>
      </div>
      <!-- stamp -->
      <div aria-hidden="true" style="position:absolute;right:6%;bottom:14%;transform:rotate(-13deg);border:2px solid var(--accent);color:var(--accent);border-radius:9px;padding:8px 14px;font:800 14px 'Archivo',sans-serif;letter-spacing:.06em;opacity:.92;box-shadow:0 0 22px rgba(198,244,50,.18)">OWNED OUTRIGHT</div>
    </div>
  </div>

  <!-- handover flow -->
  <div id="snz-own-flow" style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.08);margin-bottom:24px">
    {steps.map((s, i) => (
      <div data-reveal data-delay={i * 80} style="background:#0a0a0a;padding:34px 30px;position:relative">
        <div style="font:700 13px 'JetBrains Mono',monospace;color:var(--accent);margin-bottom:40px">{s.n}</div>
        <h3 style="margin:0 0 12px;font:700 22px 'Archivo',sans-serif;letter-spacing:-0.02em">{s.title}</h3>
        <p style="margin:0;font:400 14px/1.6 'JetBrains Mono',monospace;color:#9a9a92">{s.body}</p>
      </div>
    ))}
  </div>

  <!-- two paths after handover -->
  <div id="snz-own-paths" style="display:grid;grid-template-columns:1fr 1fr;gap:24px">
    <!-- self-manage -->
    <div data-reveal style="border:1px solid rgba(255,255,255,.12);padding:36px;background:#0c0c0c;display:flex;flex-direction:column">
      <div style="font:600 11px 'JetBrains Mono',monospace;letter-spacing:.18em;color:#7c7c74;margin-bottom:14px">PATH A · DIY</div>
      <h3 style="margin:0 0 8px;font:800 26px 'Archivo',sans-serif;letter-spacing:-0.02em">You manage it</h3>
      <p style="margin:0 0 24px;font:400 13.5px/1.6 'JetBrains Mono',monospace;color:#9a9a92">Take the keys and run it yourself. Everything's in your name from day one.</p>
      <div style="display:flex;flex-direction:column;gap:10px">
        {selfManage.map((f) => (
          <div style="font:400 13px/1.5 'JetBrains Mono',monospace;color:#cfcfc7"><span style="color:#7c7c74">·</span> {f}</div>
        ))}
      </div>
    </div>
    <!-- managed -->
    <div data-reveal data-delay="90" style="border:1px solid var(--accent);padding:36px;background:linear-gradient(180deg,rgba(198,244,50,.08),#0c0c0c);display:flex;flex-direction:column;position:relative">
      <div style="position:absolute;top:-1px;right:-1px;font:700 10px 'JetBrains Mono',monospace;letter-spacing:.14em;background:var(--accent);color:#0a0a0a;padding:6px 12px">HANDS-OFF</div>
      <div style="font:600 11px 'JetBrains Mono',monospace;letter-spacing:.18em;color:var(--accent);margin-bottom:14px">PATH B · I ADMIN IT</div>
      <div style="display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:8px">
        <h3 style="margin:0;font:800 26px 'Archivo',sans-serif;letter-spacing:-0.02em">I manage it for you</h3>
        <span style="font:700 18px 'Archivo',sans-serif;color:#F2F0EA">From £40<span style="font:500 11px 'JetBrains Mono',monospace;color:#7c7c74">/mo</span></span>
      </div>
      <p style="margin:0 0 24px;font:400 13.5px/1.6 'JetBrains Mono',monospace;color:#9a9a92">Still owned by you — I just handle the running of it. Cancel anytime, keys stay yours.</p>
      <div style="display:flex;flex-direction:column;gap:10px">
        {managed.map((f) => (
          <div style="font:400 13px/1.5 'JetBrains Mono',monospace;color:#cfcfc7"><span style="color:var(--accent)">+</span> {f}</div>
        ))}
      </div>
    </div>
  </div>

  <p data-reveal style="margin:24px 0 0;max-width:680px;font:400 12.5px/1.7 'JetBrains Mono',monospace;color:#7c7c74">Either way, you own the application outright. After completion, the service and hosting costs are the client's to manage — pay the providers directly at cost, or let me admin it all for a flat monthly fee.</p>
</section>

<style>
  @media (max-width: 860px) {
    #snz-ownership { padding: 64px 22px !important; }
    #snz-own-flow, #snz-own-paths { grid-template-columns: 1fr !important; }
  }
</style>
