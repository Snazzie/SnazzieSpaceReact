---
// Ownership & handover: client owns the app outright. On completion all
// service + hosting costs are theirs to manage — or they pay a monthly fee
// for me to admin it for them.
const LINKEDIN = 'https://linkedin.com/in/cooper-a-m/';

const steps = [
  { n: '01', title: 'I build it', body: 'Designed and developed end to end, around your business — no templates, no lock-in.' },
  { n: '02', title: 'You own it', body: 'On completion the whole thing is yours outright. The code, the accounts, the domain — all in your name.' },
  { n: '03', title: 'You hold the keys', body: 'From handover, the service and hosting accounts are yours to manage, paid directly to the providers at cost.' },
];

const selfManage = [
  'Everything in your name and your control',
  'Pay hosting & domain providers directly, at cost',
  'No monthly fee to me — walk away anytime',
  'Full handover notes so nothing is a mystery',
];

const managed = [
  'I provision & admin your hosting/domain accounts — still in your name',
  'Updates, content changes & uptime watched',
  'Legal obligations upkeep (GDPR & cookie-consent)',
  'One person to call — no tickets, no queue',
];
---
<section id="snz-ownership" class="py-24 px-14 border-b border-[rgba(255,255,255,0.08)]">
  <div data-reveal class="flex items-end justify-between flex-wrap gap-5 mb-[54px]">
    <div>
      <div class="font-semibold text-[11px] font-['JetBrains_Mono'] tracking-[.2em] text-[var(--accent)] mb-[18px]">[ 05 ] OWNERSHIP</div>
      <h2 class="snz-display m-0 font-extrabold text-[60px] leading-[0.98] font-['Archivo'] tracking-[-0.035em]">It's yours. Really yours.</h2>
    </div>
    <p class="m-0 max-w-[340px] font-normal text-[14px] leading-[1.6] font-['JetBrains_Mono'] text-[#8a8a82]">No lock-in, no hostage hosting. When the job's done, you own the lot — and you choose who runs it.</p>
  </div>

  <!-- visual: a browser window handed over -->
  <div data-reveal id="snz-own-vis" class="border border-[rgba(255,255,255,0.1)] bg-[#0c0c0c] mb-7 overflow-hidden rounded-[18px]">
    <!-- browser chrome -->
    <div class="flex items-center gap-[14px] py-[14px] px-[18px] border-b border-[rgba(255,255,255,0.07)] bg-[#0a0a0a]">
      <div class="flex gap-[7px]">
        <span class="w-[11px] h-[11px] rounded-full bg-[#3a3a36]"></span>
        <span class="w-[11px] h-[11px] rounded-full bg-[#3a3a36]"></span>
        <span class="w-[11px] h-[11px] rounded-full bg-[#3a3a36]"></span>
      </div>
      <div class="flex-1 max-w-[340px] font-medium text-[12px] font-['JetBrains_Mono'] text-[#7c7c74] bg-[#141414] border border-[rgba(255,255,255,0.06)] rounded-full py-[7px] px-4">
        <span class="text-[var(--accent)]">https://</span>your-business.com
      </div>
      <div class="snz-live font-semibold text-[10px] font-['JetBrains_Mono'] tracking-[.14em] text-[var(--accent)]">● LIVE</div>
    </div>
    <!-- canvas -->
    <div class="relative grid place-items-center min-h-[240px] py-14 px-6 overflow-hidden" style="background:radial-gradient(120% 140% at 50% 0%,rgba(198,244,50,.07),#0c0c0c 60%)">
      <!-- drifting ambient glow -->
      <div aria-hidden="true" class="snz-own-glow absolute w-[440px] h-[440px] rounded-full pointer-events-none" style="background:radial-gradient(circle,rgba(198,244,50,.16),transparent 65%);filter:blur(20px)"></div>
      <!-- faint wireframe lines -->
      <div aria-hidden="true" class="absolute inset-0 bg-[length:34px_34px]" style="background-image:linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);mask-image:radial-gradient(120% 100% at 50% 30%,#000,transparent 75%)"></div>
      <div class="relative text-center">
        <div class="font-bold text-[11px] font-['JetBrains_Mono'] tracking-[.24em] text-[#7c7c74] mb-[14px]">DEED OF OWNERSHIP</div>
        <div class="snz-display font-extrabold text-[clamp(34px,6vw,68px)] leading-[0.95] font-['Archivo'] tracking-[-0.04em]">100% yours.</div>
        <div class="font-normal text-[13px] leading-[1.6] font-['JetBrains_Mono'] text-[#9a9a92] mt-[14px] max-w-[380px] mx-auto">Code, domain and accounts — all signed over to your name on day one.</div>
      </div>
    </div>
  </div>

  <!-- handover flow -->
  <div id="snz-own-flow" class="grid grid-cols-3 gap-5 mb-7">
    {steps.map((s, i) => (
      <div data-reveal data-delay={i * 80} class="snz-own-step group bg-[#0a0a0a] py-[34px] px-[30px] relative rounded-[16px] border border-[rgba(255,255,255,0.08)] overflow-hidden">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 h-[2px] bg-gradient-to-r from-transparent via-[var(--accent)] to-transparent opacity-0 group-hover:opacity-60 transition-opacity duration-500"></div>
        <div class="font-bold text-[13px] font-['JetBrains_Mono'] text-[var(--accent)] mb-10">{s.n}</div>
        <h3 class="mt-0 mb-3 mx-0 font-bold text-[22px] font-['Archivo'] tracking-[-0.02em]">{s.title}</h3>
        <p class="m-0 font-normal text-[14px] leading-[1.6] font-['JetBrains_Mono'] text-[#9a9a92]">{s.body}</p>
      </div>
    ))}
  </div>

  <!-- two paths after handover -->
  <div id="snz-own-paths" class="grid grid-cols-2 gap-6">
    <!-- self-manage -->
    <div data-reveal class="snz-own-path border border-[rgba(255,255,255,0.1)] p-9 bg-[#0c0c0c] flex flex-col rounded-[18px]">
      <div class="font-semibold text-[11px] font-['JetBrains_Mono'] tracking-[.18em] text-[#7c7c74] mb-[14px]">PATH A · DIY</div>
      <h3 class="mt-0 mb-2 mx-0 font-extrabold text-[26px] font-['Archivo'] tracking-[-0.02em]">You manage it</h3>
      <p class="mt-0 mb-6 mx-0 font-normal text-[13.5px] leading-[1.6] font-['JetBrains_Mono'] text-[#9a9a92]">Take the keys and run it yourself. Everything's in your name from day one.</p>
      <div class="flex flex-col gap-[10px]">
        {selfManage.map((f) => (
          <div class="font-normal text-[13px] leading-[1.5] font-['JetBrains_Mono'] text-[#cfcfc7]"><span class="text-[#7c7c74]">·</span> {f}</div>
        ))}
      </div>
    </div>
    <!-- managed -->
    <div data-reveal data-delay="90" class="snz-own-path border border-[var(--accent)] p-9 flex flex-col relative rounded-[18px] overflow-hidden" style="background:linear-gradient(180deg,rgba(198,244,50,.08),#0c0c0c)">
      <div class="absolute top-0 right-0 font-bold text-[10px] font-['JetBrains_Mono'] tracking-[.14em] bg-[var(--accent)] text-[#0a0a0a] py-[6px] px-3 rounded-bl-[12px]">HANDS-OFF</div>
      <div class="font-semibold text-[11px] font-['JetBrains_Mono'] tracking-[.18em] text-[var(--accent)] mb-[14px]">PATH B · I ADMIN IT</div>
      <div class="flex items-baseline justify-between flex-wrap gap-[10px] mb-2">
        <h3 class="m-0 font-extrabold text-[26px] font-['Archivo'] tracking-[-0.02em]">I manage it for you</h3>
        <span class="font-bold text-[18px] font-['Archivo'] text-[#F2F0EA]">From £40<span class="font-medium text-[11px] font-['JetBrains_Mono'] text-[#7c7c74]">/mo</span></span>
      </div>
      <p class="mt-0 mb-6 mx-0 font-normal text-[13.5px] leading-[1.6] font-['JetBrains_Mono'] text-[#9a9a92]">Still owned by you — I just handle the running of it. Cancel anytime, keys stay yours.</p>
      <div class="flex flex-col gap-[10px]">
        {managed.map((f) => (
          <div class="font-normal text-[13px] leading-[1.5] font-['JetBrains_Mono'] text-[#cfcfc7]"><span class="text-[var(--accent)]">+</span> {f}</div>
        ))}
      </div>
    </div>
  </div>

  <p data-reveal class="mt-6 mb-0 mx-0 max-w-[680px] font-normal text-[12.5px] leading-[1.7] font-['JetBrains_Mono'] text-[#7c7c74]">Either way, you own the application outright. After completion, the service and hosting costs are the client's to manage — pay the providers directly at cost, or let me admin it all for a flat monthly fee.</p>
</section>

<style>
  /* slow drifting glow behind the deed so the visual isn't static */
  .snz-own-glow {
    animation: snz-own-drift 11s ease-in-out infinite;
  }
  @keyframes snz-own-drift {
    0%, 100% { transform: translate(-14%, -8%) scale(1); opacity: .55; }
    50%      { transform: translate(14%, 8%) scale(1.12); opacity: .85; }
  }
  /* breathing LIVE dot */
  .snz-live { animation: snz-own-pulse 2.4s ease-in-out infinite; }
  @keyframes snz-own-pulse { 0%,100% { opacity: 1; } 50% { opacity: .45; } }

  /* cards lift gently instead of sitting flat */
  .snz-own-step, .snz-own-path {
    transition: transform .35s cubic-bezier(.2,.7,.2,1), border-color .35s ease, box-shadow .35s ease;
    will-change: transform;
  }
  .snz-own-step:hover {
    transform: translateY(-4px);
    border-color: rgba(198,244,50,.3);
  }
  .snz-own-path:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px -24px rgba(198,244,50,.35);
  }

  @media (prefers-reduced-motion: reduce) {
    .snz-own-glow, .snz-live { animation: none; }
    .snz-own-step, .snz-own-path { transition: none; }
  }

  @media (max-width: 860px) {
    #snz-ownership { padding: 64px 22px !important; }
    #snz-own-flow, #snz-own-paths { grid-template-columns: 1fr !important; }
  }
</style>
