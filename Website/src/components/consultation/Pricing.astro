---
// Services: three ways people work with me, each linking to its own detail + full pricing page.
const segments = [
  {
    slug: 'websites',
    audience: 'SMALL BUSINESS',
    title: 'A website for your business',
    price: 'From £1500',
    priceNote: 'one-off',
    blurb: 'Hand-built, launch-ready, and yours to own outright.',
  },
  {
    slug: 'apps',
    audience: 'FOUNDERS & IDEAS',
    title: 'Turn your idea into an app',
    price: 'Scoped after a call',
    priceNote: '',
    blurb: 'Mobile apps and products built from scratch, priced to what you need.',
  },
  {
    slug: 'consulting',
    audience: 'TEAMS & ENTERPRISE',
    title: 'Engineering advisory & consulting',
    price: 'Scoped after a call',
    priceNote: '',
    blurb: 'Backend systems, AI features, or a second opinion on what you have.',
  },
];
---
<section id="snz-services" class="py-24 px-14 border-b border-[rgba(var(--line-rgb),0.08)] max-[760px]:py-16 max-[760px]:px-[22px]">
  <div data-reveal class="flex items-end justify-between flex-wrap gap-5 mb-[54px]">
    <div>
      <div class="font-['JetBrains_Mono'] font-semibold text-[11px] tracking-[0.2em] text-[var(--accent-vis)] mb-[18px]">[ 03 ] SERVICES</div>
      <h2 class="snz-display m-0 font-['Archivo'] font-extrabold text-[60px] leading-[0.98] tracking-[-0.035em]">What I build, and what it costs</h2>
    </div>
    <p class="m-0 max-w-[340px] font-['JetBrains_Mono'] font-normal text-[14px] leading-[1.6] text-[var(--ink4)]">Whatever you need made, I can probably make it. Pick where you're starting from.</p>
  </div>

  <div id="snz-svc" class="grid grid-cols-3 gap-6 max-[900px]:grid-cols-1">
    {segments.map((s, i) => (
      <a
        data-reveal
        data-delay={i * 90}
        data-mag
        href={`/consultation/services/${s.slug}/`}
        class="snz-card group flex flex-col justify-between gap-7 border border-[rgba(var(--line-rgb),0.12)] p-8 bg-[var(--bg2)] no-underline transition-[background,transform] duration-[.35s] ease"
        style="transition:transform .3s cubic-bezier(.2,.8,.2,1),background .35s ease"
      >
        <div>
          <div class="font-['JetBrains_Mono'] font-semibold text-[11px] tracking-[0.16em] text-[var(--accent-vis)] mb-4">{s.audience}</div>
          <h3 class="m-0 mb-3 font-['Archivo'] font-extrabold text-[24px] leading-[1.1] tracking-[-0.02em] text-[var(--ink0)]">{s.title}</h3>
          <p class="m-0 font-['JetBrains_Mono'] font-normal text-[13px] leading-[1.6] text-[var(--ink3)]">{s.blurb}</p>
        </div>
        <div class="flex items-end justify-between gap-3">
          <div class="font-['Archivo'] font-bold text-[20px] text-[var(--ink0)]">
            {s.price}{s.priceNote && <span class="font-['JetBrains_Mono'] font-medium text-[12px] text-[var(--ink5)]"> {s.priceNote}</span>}
          </div>
          <span class="font-['JetBrains_Mono'] text-[var(--accent-vis)] opacity-0 -translate-x-1 transition-[opacity,transform] duration-[.35s] ease group-hover:opacity-100 group-hover:translate-x-0">→</span>
        </div>
      </a>
    ))}
  </div>
</section>
