---
// Process: how a project runs from first email to agreed fee.
const steps = [
  { n: '01', title: 'Get in touch', body: 'Send me an email with a brief outline of the work. I reply to discuss it and let you know if it is something I can take on.' },
  { n: '02', title: 'Discovery call', body: 'An initial 30-minute call to talk through the work, what I will need from you, and any examples or designs you want to use as influence.' },
  { n: '03', title: 'Deposit', body: 'A deposit, based on the scope we estimate, secures your slot and covers the design work. It is credited in full against the final fee once we proceed to build.' },
  { n: '04', title: 'Mock-ups', body: 'I come back with designs and we work on them together — up to five rounds of changes — until we land on something you genuinely love.' },
  { n: '05', title: 'Estimate & fee', body: 'Once the design is agreed, you get a delivery-date estimate and a fee. With that signed off, work begins.' },
];
---
<section id="snz-process" style="padding:96px 56px;border-bottom:1px solid rgba(255,255,255,.08)">
  <div data-reveal style="display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:20px;margin-bottom:54px">
    <div>
      <div style="font:600 11px 'JetBrains Mono',monospace;letter-spacing:.2em;color:var(--accent);margin-bottom:18px">[ 05 ] PROCESS</div>
      <h2 class="snz-display" style="margin:0;font:800 60px/0.98 'Archivo',sans-serif;letter-spacing:-0.035em">How it works</h2>
    </div>
    <p style="margin:0;max-width:340px;font:400 14px/1.6 'JetBrains Mono',monospace;color:#8a8a82">From first email to final design, no guesswork.</p>
  </div>
  <div style="border-top:1px solid rgba(255,255,255,.1)">
    {steps.map((s, i) => (
      <div data-reveal data-delay={i * 60} class="snz-step" style="display:grid;grid-template-columns:120px 1fr;gap:24px;padding:32px 0;border-bottom:1px solid rgba(255,255,255,.1);transition:padding-left .35s ease;align-items:start">
        <div class="snz-stepnum" style="font:800 56px 'Archivo',sans-serif;color:#2a2a26;letter-spacing:-0.03em;line-height:1;transition:color .5s ease,text-shadow .5s ease">{s.n}</div>
        <div>
          <h3 style="margin:0 0 10px;font:700 22px 'Archivo',sans-serif">{s.title}</h3>
          <p style="margin:0;max-width:620px;font:400 14px/1.65 'JetBrains Mono',monospace;color:#9a9a92">{s.body}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  @media (max-width: 760px) {
    #snz-process { padding: 64px 22px !important; }
    #snz-process .snz-step { grid-template-columns: 48px 1fr !important; gap: 16px !important; }
    #snz-process .snz-stepnum { font-size: 30px !important; }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const steps = Array.from(document.querySelectorAll<HTMLElement>('#snz-process .snz-step'));
  const light = (n: HTMLElement) => { n.style.color = 'var(--accent)'; n.style.textShadow = '0 0 40px rgba(198,244,50,.35)'; };
  const dim   = (n: HTMLElement) => { n.style.color = '#2a2a26'; n.style.textShadow = 'none'; };
  if (reduce) {
    steps.forEach((s) => { const n = s.querySelector<HTMLElement>('.snz-stepnum'); if (n) light(n); });
  } else {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        const n = (e.target as HTMLElement).querySelector<HTMLElement>('.snz-stepnum');
        if (!n) return;
        if (e.isIntersecting) {
          light(n);
        } else if (e.boundingClientRect.top > 0) {
          // exited below viewport — user scrolled back up past it
          dim(n);
        }
        // exited above viewport (user scrolled past it going down) — stay lit
      });
    }, { threshold: 0.5 });
    steps.forEach((el) => io.observe(el));
  }
</script>
