---
// Process: how a project runs from first email to agreed fee.
const steps = [
  { n: '01', title: 'Get in touch', body: 'Send me an email with a brief outline of the work. I reply to discuss it and let you know if it is something I can take on.' },
  { n: '02', title: 'Discovery call', body: 'An initial 30-minute call to talk through the work, what I will need from you, and any examples or designs you want to use as influence.' },
  { n: '03', title: 'Deposit', body: 'A deposit, based on the scope we estimate, secures your slot and covers the design work. It is credited in full against the final fee once we proceed to build.' },
  { n: '04', title: 'Mock-ups', body: 'I come back with designs and we work on them together — up to five rounds of changes — until we land on something you genuinely love.' },
  { n: '05', title: 'Estimate & fee', body: 'Once the design is agreed, you get a delivery-date estimate and a fee. With that signed off, work begins.' },
];
---
<section id="snz-process" class="py-24 px-14 border-b border-[rgba(255,255,255,0.08)] max-[760px]:py-16 max-[760px]:px-[22px]">
  <div data-reveal class="flex items-end justify-between flex-wrap gap-5 mb-[54px]">
    <div>
      <div class="font-semibold text-[11px] font-['JetBrains_Mono'] tracking-[.2em] text-[var(--accent)] mb-[18px]">[ 05 ] PROCESS</div>
      <h2 class="snz-display m-0 font-extrabold text-[60px] leading-[0.98] font-['Archivo'] tracking-[-0.035em]">How it works</h2>
    </div>
    <p class="m-0 max-w-[340px] font-normal text-[14px] leading-[1.6] font-['JetBrains_Mono'] text-[#8a8a82]">From first email to final design, no guesswork.</p>
  </div>
  <div class="border-t border-[rgba(255,255,255,0.1)]">
    {steps.map((s, i) => (
      <div data-reveal data-delay={i * 60} class="snz-step grid grid-cols-[120px_1fr] gap-6 py-8 px-0 border-b border-[rgba(255,255,255,0.1)] transition-[padding-left] duration-[.35s] ease items-start max-[760px]:grid-cols-[48px_1fr] max-[760px]:gap-4">
        <div class="snz-stepnum font-extrabold text-[56px] font-['Archivo'] text-[#2a2a26] tracking-[-0.03em] leading-none transition-[color,text-shadow] duration-[.5s] ease max-[760px]:text-[30px]">{s.n}</div>
        <div>
          <h3 class="mt-0 mb-[10px] mx-0 font-bold text-[22px] font-['Archivo']">{s.title}</h3>
          <p class="m-0 max-w-[620px] font-normal text-[14px] leading-[1.65] font-['JetBrains_Mono'] text-[#9a9a92]">{s.body}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const steps = Array.from(document.querySelectorAll<HTMLElement>('#snz-process .snz-step'));
  const light = (n: HTMLElement) => { n.style.color = 'var(--accent)'; n.style.textShadow = '0 0 40px rgba(198,244,50,.35)'; };
  const dim   = (n: HTMLElement) => { n.style.color = '#2a2a26'; n.style.textShadow = 'none'; };
  if (reduce) {
    steps.forEach((s) => { const n = s.querySelector<HTMLElement>('.snz-stepnum'); if (n) light(n); });
  } else {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        const n = (e.target as HTMLElement).querySelector<HTMLElement>('.snz-stepnum');
        if (!n) return;
        if (e.isIntersecting) {
          light(n);
        } else if (e.boundingClientRect.top > 0) {
          // exited below viewport — user scrolled back up past it
          dim(n);
        }
        // exited above viewport (user scrolled past it going down) — stay lit
      });
    }, { threshold: 0.5 });
    steps.forEach((el) => io.observe(el));
  }
</script>
