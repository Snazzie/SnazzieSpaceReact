---
// Process: how a project runs from first email to agreed fee.
// Scroll-driven step rail — a row of nodes sits centered on screen; as you scroll
// the connecting line fills left-to-right and lights each node in turn. The active
// step's text (number, icon, title, body) is centered directly below. A static list
// is shown when prefers-reduced-motion is set.
const ICONS: Record<string, string> = {
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  call: '<path d="M15.5 3a5.5 5.5 0 0 1 5.5 5.5"/><path d="M15 7a2.5 2.5 0 0 1 2 2"/><path d="M4 4h4l2 5-2.5 1.5a11 11 0 0 0 6 6L15 14l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 2 6a2 2 0 0 1 2-2z"/>',
  lock: '<rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><circle cx="12" cy="15.5" r="1.5"/>',
  layout: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/>',
  check: '<path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M5 3h9l5 5v11a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2z"/><path d="m9 14 2 2 4-4"/>',
};
const svg = (name: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${ICONS[name]}</svg>`;

// Per-step animated scenes — live inside each node and play while that step is
// active. Animation classes are styled in the is:global block (set:html markup is
// not scoped). viewBox 240x170 is fit (meet) into the circle so nothing clips.
const sceneSvgs = [
  `<svg class="sc" viewBox="0 0 240 170"><path class="ln trail" d="M30 120 Q90 70 150 60"/><g class="plane"><path class="ln" d="M150 60 l46 -18 -16 44 -12 -16 z"/><path class="ln" d="M180 86 l4 -14"/></g><g class="at"><circle class="ln dim" cx="56" cy="118" r="20"/><path class="ln" d="M62 118 a6 6 0 1 0 -6 6 a10 10 0 1 0 9 -14"/></g></svg>`,
  `<svg class="sc" viewBox="0 0 240 170"><circle class="ln wave" cx="120" cy="85" r="34"/><circle class="ln wave b" cx="120" cy="85" r="34"/><circle class="ln wave c" cx="120" cy="85" r="34"/><g class="phone"><rect class="ln" x="104" y="46" width="32" height="60" rx="7"/><path class="ln" d="M114 96 h12"/></g></svg>`,
  `<svg class="sc" viewBox="0 0 240 170"><g class="coin"><circle class="ln" cx="120" cy="46" r="14"/><path class="ln" d="M120 39 v14 M115 46 h10"/></g><path class="ln shackle" d="M104 96 v-8 a16 16 0 0 1 32 0 v8"/><rect class="ln" x="98" y="96" width="44" height="40" rx="7"/><circle class="fil spark" cx="120" cy="116" r="3"/></svg>`,
  `<svg class="sc" viewBox="0 0 240 170"><rect class="ln dim" x="64" y="40" width="112" height="84" rx="8"/><path class="ln dim" d="M64 56 h112"/><circle class="fil" cx="74" cy="48" r="2.2"/><circle class="fil" cx="82" cy="48" r="2.2"/><rect class="ln blk" x="74" y="66" width="40" height="48" rx="4"/><path class="ln blk b" d="M124 66 h44"/><path class="ln blk c" d="M124 80 h44 M124 92 h30"/><path class="ln cursor" d="M150 96 l0 22 6 -6 4 9 4 -2 -4 -9 8 0 z"/></svg>`,
  `<svg class="sc" viewBox="0 0 240 170"><path class="ln" d="M84 36 h54 l18 18 v80 a4 4 0 0 1 -4 4 h-68 a4 4 0 0 1 -4 -4 z"/><path class="ln dim" d="M138 36 v18 h18"/><path class="ln dim" d="M96 74 h40 M96 86 h48"/><path class="ln sig" d="M96 110 q8 -14 16 0 t16 0"/><g class="stamp"><circle class="ln" cx="150" cy="116" r="16"/><path class="ln check" d="M142 116 l6 6 10 -12"/></g></svg>`,
];

const steps = [
  { n: '01', icon: 'mail', title: 'Get in touch', body: 'Send me an email with a brief outline of the work. I reply to discuss it and let you know if it is something I can take on.' },
  { n: '02', icon: 'call', title: 'Discovery call', body: 'A free, no-obligation 30-minute call to talk through the work, what I will need from you, and any examples or designs you want to use as influence.' },
  { n: '03', icon: 'lock', title: 'Deposit', body: 'A deposit, based on the scope we estimate, secures your slot and covers the design work. It is credited in full against the final fee once we proceed to build.' },
  { n: '04', icon: 'layout', title: 'Mock-ups', body: 'I come back with designs and we work on them together — up to five rounds of changes — until we land on something you genuinely love.' },
  { n: '05', icon: 'check', title: 'Estimate & fee', body: 'Once the design is agreed, you get a delivery-date estimate and a fee. With that signed off, work begins.' },
];
---
<section id="snz-process" class="relative border-b border-[rgba(var(--line-rgb),0.08)]">
  <!-- ===================== SCROLL-DRIVEN STEP RAIL ===================== -->
  <div id="snz-proc-anim">
    <div class="snz-proc-pin">
      <!-- ambient glow -->
      <div aria-hidden="true" class="snz-proc-glow"></div>

      <div class="snz-proc-head">
        <div class="font-semibold text-[11px] font-['JetBrains_Mono'] tracking-[.2em] text-[var(--accent-text)] mb-[14px]">[ 05 ] PROCESS</div>
        <h2 class="snz-display m-0 font-extrabold text-[clamp(34px,4.5vw,58px)] leading-[0.98] font-['Archivo'] tracking-[-0.035em]">How it works</h2>
      </div>

      <!-- node rail -->
      <div class="snz-proc-rail" role="presentation">
        <div class="snz-proc-rail-bed"></div>
        <div class="snz-proc-rail-fill" id="snz-proc-fill"></div>
        <div class="snz-proc-nodes">
          {steps.map((s, i) => (
            <div class:list={['snz-proc-node', { on: i === 0, 'scene-active': i === 0 }]} data-i={i}>
              <span class="ic" set:html={svg(s.icon)} />
              <span class="scene" set:html={sceneSvgs[i]} />
              <span class="num">{s.n}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- centered active-step text -->
      <div class="snz-proc-step">
        <div class="snz-proc-swap" id="snz-proc-swap">
          <div class="font-semibold text-[11px] font-['JetBrains_Mono'] tracking-[.2em] text-[var(--accent-text)] mb-[10px]" id="snz-proc-mn">STEP 01 / 05</div>
          <h3 class="m-0 mb-[14px] font-bold text-[clamp(24px,3vw,34px)] font-['Archivo'] tracking-[-0.02em]" id="snz-proc-mt">{steps[0].title}</h3>
          <p class="m-0 mx-auto max-w-[560px] font-normal text-[14px] leading-[1.65] font-['JetBrains_Mono'] text-[var(--ink3)]" id="snz-proc-mp">{steps[0].body}</p>
        </div>
      </div>

      <!-- full step data for the swap -->
      <script type="application/json" id="snz-proc-data" set:html={JSON.stringify(steps.map((s) => ({ n: s.n, title: s.title, body: s.body })))} />

      <div class="snz-proc-hint font-['JetBrains_Mono'] text-[10px] tracking-[.2em] text-[var(--ink6)]">↓ SCROLL ↓</div>
    </div>
  </div>

  <!-- ===================== STATIC FALLBACK (reduced motion) ===================== -->
  <div id="snz-proc-static" class="py-24 px-14 max-[760px]:py-16 max-[760px]:px-[22px]">
    <div data-reveal class="flex items-end justify-between flex-wrap gap-5 mb-[40px]">
      <div>
        <div class="font-semibold text-[11px] font-['JetBrains_Mono'] tracking-[.2em] text-[var(--accent-text)] mb-[18px]">[ 05 ] PROCESS</div>
        <h2 class="snz-display m-0 font-extrabold text-[60px] leading-[0.98] font-['Archivo'] tracking-[-0.035em] max-[760px]:text-[42px]">How it works</h2>
      </div>
      <p class="m-0 max-w-[340px] font-normal text-[14px] leading-[1.6] font-['JetBrains_Mono'] text-[var(--ink4)]">From first email to final design, no guesswork.</p>
    </div>
    <div class="border-t border-[rgba(var(--line-rgb),0.1)]">
      {steps.map((s) => (
        <div class="grid grid-cols-[64px_1fr] gap-6 py-7 border-b border-[rgba(var(--line-rgb),0.1)] items-start max-[760px]:grid-cols-[52px_1fr] max-[760px]:gap-4">
          <div class="w-[54px] h-[54px] rounded-[15px] border border-[rgba(var(--accent-rgb),0.3)] bg-[rgba(var(--accent-rgb),0.07)] grid place-items-center text-[var(--accent-text)] [&_svg]:w-6 [&_svg]:h-6" set:html={svg(s.icon)} />
          <div>
            <div class="font-semibold text-[11px] font-['JetBrains_Mono'] tracking-[.16em] text-[var(--accent-text)] mb-[6px]">STEP {s.n}</div>
            <h3 class="mt-0 mb-[10px] font-bold text-[22px] font-['Archivo']">{s.title}</h3>
            <p class="m-0 max-w-[620px] font-normal text-[14px] leading-[1.65] font-['JetBrains_Mono'] text-[var(--ink3)]">{s.body}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* ---- shell ---- */
  #snz-proc-static { display: none; }
  #snz-proc-anim { height: 360vh; position: relative; }
  .snz-proc-pin {
    position: sticky; top: 0; height: 100vh; overflow: hidden;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 34px; padding: 0 24px; text-align: center;
  }
  .snz-proc-glow {
    position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(60% 50% at 50% 42%, rgba(var(--accent-rgb),.06), transparent 70%);
  }
  .snz-proc-head { position: relative; z-index: 2; }

  /* ---- node rail ---- */
  .snz-proc-rail { position: relative; z-index: 2; width: 100%; max-width: 820px; height: 92px; }
  .snz-proc-rail-bed,
  .snz-proc-rail-fill {
    position: absolute; top: 50%; left: 46px; right: 46px; height: 2px; border-radius: 2px;
  }
  .snz-proc-rail-bed { background: rgba(var(--line-rgb),.1); transform: translateY(-50%); }
  .snz-proc-rail-fill {
    background: var(--accent); box-shadow: 0 0 10px rgba(var(--accent-rgb),.6);
    transform-origin: left center; transform: translateY(-50%) scaleX(0); transition: transform .15s linear;
  }
  .snz-proc-nodes { position: relative; z-index: 1; display: flex; justify-content: space-between; height: 100%; align-items: center; }
  .snz-proc-node {
    position: relative; width: 92px; height: 92px; border-radius: 50%;
    display: grid; place-items: center; flex: none;
    background: var(--bg-node); border: 2px solid rgba(var(--line-rgb),.18);
    transition: border-color .4s, background .4s, box-shadow .4s, transform .4s;
  }
  .snz-proc-node .ic { display: block; width: 32px; height: 32px; color: var(--ink6); transition: color .4s, opacity .2s; }
  /* coming back (node no longer active): wait for the scene to fade out first, so
     the icon and scene are never both visible */
  .snz-proc-node:not(.scene-active) .ic { transition: color .4s, opacity .2s ease .3s; }
  .snz-proc-node :global(svg) { width: 32px; height: 32px; }
  /* active node shows the scene, so fade its static icon out */
  .snz-proc-node.scene-active .ic { opacity: 0; }
  .snz-proc-node .num {
    position: absolute; top: -26px; font: 600 11px 'JetBrains Mono', monospace; letter-spacing: .14em; color: var(--ink6); transition: color .4s;
  }
  .snz-proc-node.on {
    border-color: var(--accent);
    background: linear-gradient(rgba(var(--accent-rgb),.12), rgba(var(--accent-rgb),.12)), var(--bg-node);
    box-shadow: 0 0 0 5px rgba(var(--accent-rgb),.07), 0 0 22px rgba(var(--accent-rgb),.4); transform: scale(1.06);
  }
  .snz-proc-node.on .ic { color: var(--accent-text); }
  .snz-proc-node.on .num { color: var(--accent-text); }

  /* ---- per-step scene (plays inside the active circle) ---- */
  .snz-proc-node .scene {
    position: absolute; inset: 7px; border-radius: 50%; overflow: hidden;
    display: grid; place-items: center; opacity: 0; transition: opacity .3s; pointer-events: none; z-index: 1;
  }
  .snz-proc-node.scene-active .scene { opacity: 1; }

  /* ---- centered active text ---- */
  /* fixed height so varying body length never shifts the rail/icons above it */
  .snz-proc-step { position: relative; z-index: 2; height: 180px; width: 100%; max-width: 620px; }
  .snz-proc-swap { transition: opacity .3s, transform .3s; }

  .snz-proc-hint { position: absolute; bottom: 5vh; left: 50%; transform: translateX(-50%); animation: snz-proc-bob 1.8s ease-in-out infinite; }
  @keyframes snz-proc-bob { 50% { transform: translate(-50%, 5px); } }

  @media (max-width: 680px) {
    .snz-proc-pin { gap: 30px; }
    .snz-proc-rail { height: 64px; max-width: 380px; }
    .snz-proc-rail-bed, .snz-proc-rail-fill { left: 32px; right: 32px; }
    .snz-proc-node { width: 64px; height: 64px; }
    .snz-proc-node .ic, .snz-proc-node :global(svg) { width: 24px; height: 24px; }
    .snz-proc-node .num { top: -22px; font-size: 10px; }
    .snz-proc-step { height: 230px; }
  }

  /* ---- reduced motion: drop the animation, show the list ---- */
  @media (prefers-reduced-motion: reduce) {
    #snz-proc-anim { display: none; }
    #snz-proc-static { display: block; }
    .snz-proc-hint, .snz-proc-glow { animation: none; }
  }
</style>

<!-- scene SVGs are injected via set:html (unscoped), so their styling + animations live here -->
<style is:global>
  .snz-proc-node .scene .sc { display: block; width: 100%; height: 100%; overflow: visible; filter: drop-shadow(0 0 4px rgba(var(--accent-rgb),.4)); }
  .snz-proc-node .scene .ln { fill: none; stroke: var(--accent); stroke-width: 3.2; stroke-linecap: round; stroke-linejoin: round; }
  .snz-proc-node .scene .ln.dim { stroke: rgba(var(--line-rgb),.3); }
  .snz-proc-node .scene .fil { fill: var(--accent); }
  .snz-proc-node .scene .cursor { fill: var(--bg-node); }

  /* animations only run on the active node's scene */
  .snz-proc-node.scene-active .scene .plane { animation: sc-fly 3.4s ease-in-out infinite; }
  @keyframes sc-fly { 0% { transform: translate(-10px,18px) rotate(-8deg); opacity:0; } 18% { opacity:1; } 70% { opacity:1; } 100% { transform: translate(150px,-30px) rotate(6deg); opacity:0; } }
  .snz-proc-node.scene-active .scene .trail { stroke-dasharray: 4 7; animation: sc-dash 1.2s linear infinite; }
  @keyframes sc-dash { to { stroke-dashoffset: -22; } }
  .snz-proc-node.scene-active .scene .at { animation: sc-ping 3.4s ease-in-out infinite; transform-origin: center; transform-box: fill-box; }
  @keyframes sc-ping { 0%,60%,100% { transform: scale(1); opacity:.5; } 75% { transform: scale(1.25); opacity:1; } }

  .snz-proc-node.scene-active .scene .phone { animation: sc-shake 2.4s ease-in-out infinite; transform-origin: 120px 100px; }
  @keyframes sc-shake { 0%,100% { transform: rotate(-6deg); } 50% { transform: rotate(6deg); } }
  .snz-proc-node.scene-active .scene .wave { opacity: 0; animation: sc-emit 2.2s ease-out infinite; transform-origin: 120px 85px; }
  .snz-proc-node.scene-active .scene .wave.b { animation-delay: .55s; } .snz-proc-node.scene-active .scene .wave.c { animation-delay: 1.1s; }
  @keyframes sc-emit { 0% { opacity:0; transform: scale(.4); } 30% { opacity:.9; } 100% { opacity:0; transform: scale(1.3); } }

  .snz-proc-node.scene-active .scene .coin { animation: sc-drop 2.6s ease-in infinite; }
  @keyframes sc-drop { 0% { transform: translateY(-70px); opacity:0; } 12% { opacity:1; } 45%,100% { transform: translateY(0); opacity:1; } }
  .snz-proc-node.scene-active .scene .shackle { animation: sc-clack 2.6s ease-out infinite; transform-origin: 120px 96px; }
  @keyframes sc-clack { 0%,45% { transform: translateY(-6px); } 55% { transform: translateY(0) scale(1,.96); } 60%,100% { transform: translateY(0); } }
  .snz-proc-node.scene-active .scene .spark { opacity:0; animation: sc-sp 2.6s ease-out infinite; transform-origin: center; transform-box: fill-box; }
  @keyframes sc-sp { 0%,50% { opacity:0; } 56% { opacity:1; transform: scale(1.4); } 75%,100% { opacity:0; } }

  .snz-proc-node.scene-active .scene .blk { stroke-dasharray: 220; stroke-dashoffset: 220; animation: sc-draw 4s ease-in-out infinite; }
  .snz-proc-node.scene-active .scene .blk.b { animation-delay: .5s; } .snz-proc-node.scene-active .scene .blk.c { animation-delay: 1s; }
  @keyframes sc-draw { 0% { stroke-dashoffset:220; } 40%,70% { stroke-dashoffset:0; } 100% { stroke-dashoffset:220; } }
  .snz-proc-node.scene-active .scene .cursor { animation: sc-move 4s ease-in-out infinite; }
  @keyframes sc-move { 0% { transform: translate(0,0); } 30% { transform: translate(70px,30px); } 60% { transform: translate(30px,55px); } 100% { transform: translate(0,0); } }

  .snz-proc-node.scene-active .scene .sig { stroke-dasharray: 120; stroke-dashoffset: 120; animation: sc-sign 3.6s ease-in-out infinite; }
  @keyframes sc-sign { 0% { stroke-dashoffset:120; } 45%,75% { stroke-dashoffset:0; } 100% { stroke-dashoffset:120; } }
  .snz-proc-node.scene-active .scene .stamp { opacity:0; animation: sc-slam 3.6s ease-out infinite; transform-origin: center; transform-box: fill-box; }
  @keyframes sc-slam { 0%,55% { opacity:0; transform: scale(1.8) rotate(-12deg); } 65% { opacity:1; transform: scale(1) rotate(-12deg); } 90%,100% { opacity:1; transform: scale(1) rotate(-12deg); } }
  .snz-proc-node.scene-active .scene .check { stroke-dasharray: 30; stroke-dashoffset: 30; animation: sc-chk 3.6s ease-out infinite; }
  @keyframes sc-chk { 0%,66% { stroke-dashoffset:30; } 78%,100% { stroke-dashoffset:0; } }

  @media (prefers-reduced-motion: reduce) {
    .snz-proc-node .scene { display: none; }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const dataEl = document.getElementById('snz-proc-data');
  if (!reduce && dataEl) {
    type Step = { n: string; title: string; body: string };
    const STEPS: Step[] = JSON.parse(dataEl.textContent || '[]');
    const N = STEPS.length;

    const wrap = document.getElementById('snz-proc-anim') as HTMLElement;
    const fill = document.getElementById('snz-proc-fill') as HTMLElement;
    const nodes = Array.from(document.querySelectorAll('.snz-proc-node')) as HTMLElement[];
    const swap = document.getElementById('snz-proc-swap') as HTMLElement;
    const mn = document.getElementById('snz-proc-mn');
    const mt = document.getElementById('snz-proc-mt');
    const mp = document.getElementById('snz-proc-mp');

    if (wrap && fill && nodes.length) {
      const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));
      const fr = (i: number) => i / (N - 1);
      const paint = (i: number) => {
        const s = STEPS[i];
        if (mn) mn.textContent = 'STEP ' + s.n + ' / 0' + N;
        if (mt) mt.textContent = s.title;
        if (mp) mp.textContent = s.body;
      };
      paint(0);

      let last = -1;
      let raf: number | null = null;
      const render = () => {
        raf = null;
        const total = wrap.offsetHeight - window.innerHeight;
        const p = total > 0 ? clamp(-wrap.getBoundingClientRect().top / total, 0, 1) : 0;

        fill.style.transform = 'translateY(-50%) scaleX(' + p + ')';
        // frontier = last lit node, so the scene only plays on a node that's lit
        const act = Math.floor(p * (N - 1) + 0.001);
        nodes.forEach((node, i) => {
          node.classList.toggle('on', fr(i) <= p + 0.001);
          node.classList.toggle('scene-active', i === act);
        });

        if (act !== last) {
          last = act;
          swap.style.opacity = '0';
          swap.style.transform = 'translateY(8px)';
          window.setTimeout(() => {
            paint(act);
            swap.style.opacity = '1';
            swap.style.transform = 'none';
          }, 140);
        }
      };
      const onScroll = () => { if (raf == null) raf = requestAnimationFrame(render); };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      render();
    }
  }
</script>
