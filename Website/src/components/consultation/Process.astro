---
// Process: how a project runs from first email to agreed fee.
// Scroll-driven "transit line" climb — a train ascends a staircase route as you
// scroll, lighting each station. On mobile the SVG viewport zooms in and pans to
// follow the train, with a caption card that swaps per step. A static list is
// shown when prefers-reduced-motion is set.
const ICONS: Record<string, string> = {
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  call: '<path d="M15.5 3a5.5 5.5 0 0 1 5.5 5.5"/><path d="M15 7a2.5 2.5 0 0 1 2 2"/><path d="M4 4h4l2 5-2.5 1.5a11 11 0 0 0 6 6L15 14l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 2 6a2 2 0 0 1 2-2z"/>',
  lock: '<rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><circle cx="12" cy="15.5" r="1.5"/>',
  layout: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/>',
  check: '<path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M5 3h9l5 5v11a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2z"/><path d="m9 14 2 2 4-4"/>',
};
const svg = (name: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${ICONS[name]}</svg>`;

// x/y are precomputed points evenly spaced along the staircase route (viewBox
// 0 0 1000 440, path length 1220) so stations + cards render server-side and
// pick up Astro's scoped styles. The script only animates them.
const steps = [
  { n: '01', icon: 'mail', x: 60, y: 400, title: 'Get in touch', body: 'Send me an email with a brief outline of the work. I reply to discuss it and let you know if it is something I can take on.' },
  { n: '02', icon: 'call', x: 275, y: 310, title: 'Discovery call', body: 'An initial 30-minute call to talk through the work, what I will need from you, and any examples or designs you want to use as influence.' },
  { n: '03', icon: 'lock', x: 500, y: 230, title: 'Deposit', body: 'A deposit, based on the scope we estimate, secures your slot and covers the design work. It is credited in full against the final fee once we proceed to build.' },
  { n: '04', icon: 'layout', x: 725, y: 150, title: 'Mock-ups', body: 'I come back with designs and we work on them together — up to five rounds of changes — until we land on something you genuinely love.' },
  { n: '05', icon: 'check', x: 950, y: 70, title: 'Estimate & fee', body: 'Once the design is agreed, you get a delivery-date estimate and a fee. With that signed off, work begins.' },
];
// first sentence only, for the compact on-map cards
const short = (b: string) => b.split('.')[0] + '.';
---
<section id="snz-process" class="relative border-b border-[rgba(255,255,255,0.08)]">
  <!-- ===================== ANIMATED CLIMB ===================== -->
  <div id="snz-proc-anim">
    <div class="snz-proc-pin">
      <!-- ambient glow rising from the floor -->
      <div aria-hidden="true" class="snz-proc-glow"></div>

      <div class="snz-proc-head">
        <div class="font-semibold text-[11px] font-['JetBrains_Mono'] tracking-[.2em] text-[var(--accent)] mb-[14px]">[ 06 ] PROCESS</div>
        <h2 class="snz-display m-0 font-extrabold text-[clamp(34px,4.5vw,58px)] leading-[0.98] font-['Archivo'] tracking-[-0.035em]">How it works</h2>
      </div>

      <!-- altitude / progress (desktop) -->
      <div class="snz-proc-alt" aria-hidden="true">
        <div class="snz-proc-pct font-extrabold text-[46px] leading-none font-['Archivo'] text-[var(--accent)] tracking-[-0.03em]" id="snz-proc-pctv">0%</div>
        <div class="font-['JetBrains_Mono'] text-[10px] tracking-[.2em] text-[#6a6a62] mt-[4px]">TO SIGN-OFF</div>
      </div>

      <div class="snz-proc-map">
        <svg id="snz-proc-svg" viewBox="0 0 1000 440" preserveAspectRatio="xMidYMid meet">
          <path id="snz-proc-route" class="snz-proc-bed" d="M60,400 H230 V310 H410 V230 H590 V150 H770 V70 H950" />
          <path id="snz-proc-live" class="snz-proc-liveln" d="M60,400 H230 V310 H410 V230 H590 V150 H770 V70 H950" />
          <g id="snz-proc-stns">
            {steps.map((s, i) => (
              <g class:list={['snz-proc-stn', { on: i === 0 }]} data-i={i}>
                <circle cx={s.x} cy={s.y} r="21" />
                <foreignObject x={s.x - 12} y={s.y - 12} width="24" height="24">
                  <span class="ic-h" style="display:block;width:24px;height:24px" set:html={svg(s.icon)} />
                </foreignObject>
              </g>
            ))}
          </g>
          <g id="snz-proc-train" class="snz-proc-train" transform="translate(60,400)">
            <circle r="11" fill="#fff"></circle>
            <circle r="20" fill="none" stroke="var(--accent)" stroke-width="2" opacity=".5"></circle>
          </g>
        </svg>
        <div id="snz-proc-cards">
          {steps.map((s, i) => (
            <div
              class:list={['snz-proc-card', { on: i === 0 }]}
              data-i={i}
              style={`left:${(s.x / 1000) * 100}%;bottom:${100 - (s.y / 440) * 100 + 7}%`}
            >
              <div class="n">STEP {s.n}</div>
              <h3>{s.title}</h3>
              <p>{short(s.body)}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- mobile caption (active step) -->
      <div class="snz-proc-mcap" aria-hidden="true">
        <div class="snz-proc-swap" id="snz-proc-swap">
          <div class="flex items-center gap-3 mb-2">
            <span class="snz-proc-mic" id="snz-proc-mic" set:html={svg(steps[0].icon)} />
            <div>
              <div class="font-semibold text-[10px] font-['JetBrains_Mono'] tracking-[.16em] text-[var(--accent)]" id="snz-proc-mn">STEP 01 / 05</div>
              <h3 class="m-0 mt-[2px] font-bold text-[19px] font-['Archivo'] tracking-[-0.015em]" id="snz-proc-mt">{steps[0].title}</h3>
            </div>
          </div>
          <p class="m-0 font-normal text-[12.5px] leading-[1.55] font-['JetBrains_Mono'] text-[#9a9a92]" id="snz-proc-mp">{steps[0].body}</p>
        </div>
      </div>

      <!-- full step data for the mobile caption swap -->
      <script type="application/json" id="snz-proc-data" set:html={JSON.stringify(steps.map((s) => ({ n: s.n, title: s.title, body: s.body, svg: svg(s.icon) })))} />

      <div class="snz-proc-hint font-['JetBrains_Mono'] text-[10px] tracking-[.2em] text-[#6a6a62]">↓ SCROLL TO CLIMB ↓</div>
    </div>
  </div>

  <!-- ===================== STATIC FALLBACK (reduced motion) ===================== -->
  <div id="snz-proc-static" class="py-24 px-14 max-[760px]:py-16 max-[760px]:px-[22px]">
    <div data-reveal class="flex items-end justify-between flex-wrap gap-5 mb-[40px]">
      <div>
        <div class="font-semibold text-[11px] font-['JetBrains_Mono'] tracking-[.2em] text-[var(--accent)] mb-[18px]">[ 06 ] PROCESS</div>
        <h2 class="snz-display m-0 font-extrabold text-[60px] leading-[0.98] font-['Archivo'] tracking-[-0.035em] max-[760px]:text-[42px]">How it works</h2>
      </div>
      <p class="m-0 max-w-[340px] font-normal text-[14px] leading-[1.6] font-['JetBrains_Mono'] text-[#8a8a82]">From first email to final design, no guesswork.</p>
    </div>
    <div class="border-t border-[rgba(255,255,255,0.1)]">
      {steps.map((s) => (
        <div class="grid grid-cols-[64px_1fr] gap-6 py-7 border-b border-[rgba(255,255,255,0.1)] items-start max-[760px]:grid-cols-[52px_1fr] max-[760px]:gap-4">
          <div class="w-[54px] h-[54px] rounded-[15px] border border-[rgba(198,244,50,0.3)] bg-[rgba(198,244,50,0.07)] grid place-items-center text-[var(--accent)] [&_svg]:w-6 [&_svg]:h-6" set:html={svg(s.icon)} />
          <div>
            <div class="font-semibold text-[11px] font-['JetBrains_Mono'] tracking-[.16em] text-[var(--accent)] mb-[6px]">STEP {s.n}</div>
            <h3 class="mt-0 mb-[10px] font-bold text-[22px] font-['Archivo']">{s.title}</h3>
            <p class="m-0 max-w-[620px] font-normal text-[14px] leading-[1.65] font-['JetBrains_Mono'] text-[#9a9a92]">{s.body}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* ---- shell ---- */
  #snz-proc-static { display: none; }
  #snz-proc-anim { height: 400vh; position: relative; }
  .snz-proc-pin {
    position: sticky; top: 0; height: 100vh; overflow: hidden;
    display: flex; flex-direction: column; justify-content: center; padding: 0 56px;
  }
  .snz-proc-glow {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(0deg, rgba(198,244,50,.05), transparent 55%);
  }
  .snz-proc-head { position: absolute; top: 8vh; left: 56px; z-index: 5; }
  .snz-proc-alt { position: absolute; top: 8vh; right: 56px; text-align: right; z-index: 5; }

  .snz-proc-map { position: relative; margin-top: 30px; }
  .snz-proc-map svg { display: block; width: 100%; height: auto; }
  .snz-proc-bed { fill: none; stroke: rgba(255,255,255,.08); stroke-width: 7; stroke-linecap: round; stroke-linejoin: round; }
  .snz-proc-liveln { fill: none; stroke: var(--accent); stroke-width: 7; stroke-linecap: round; stroke-linejoin: round; filter: drop-shadow(0 0 8px rgba(198,244,50,.6)); }
  .snz-proc-train { filter: drop-shadow(0 0 12px var(--accent)); }

  .snz-proc-stn circle { fill: #0c0c0a; stroke: rgba(255,255,255,.18); stroke-width: 2.5; transition: .45s; }
  .snz-proc-stn.on circle { stroke: var(--accent); fill: rgba(198,244,50,.12); }
  .snz-proc-stn .ic-h { color: #6a6a62; transition: .45s; }
  .snz-proc-stn.on .ic-h { color: var(--accent); }

  .snz-proc-card { position: absolute; width: 200px; transform: translate(-50%, 0); opacity: .3; transition: opacity .4s, transform .4s; }
  .snz-proc-card.on { opacity: 1; }
  .snz-proc-card .n { font: 600 10px 'JetBrains Mono', monospace; letter-spacing: .16em; color: var(--accent); }
  .snz-proc-card h3 { font: 700 18px 'Archivo'; margin: 3px 0 5px; letter-spacing: -.01em; }
  .snz-proc-card p { font: 400 11.5px/1.5 'JetBrains Mono', monospace; color: #9a9a92; margin: 0; }

  .snz-proc-hint { position: absolute; bottom: 6vh; left: 50%; transform: translateX(-50%); animation: snz-proc-bob 1.8s ease-in-out infinite; }
  @keyframes snz-proc-bob { 50% { transform: translate(-50%, 5px); } }

  /* ---- mobile caption ---- */
  .snz-proc-mcap { display: none; }
  .snz-proc-mic { width: 40px; height: 40px; flex: none; border-radius: 11px; border: 1px solid rgba(198,244,50,.35); background: rgba(198,244,50,.08); display: grid; place-items: center; color: var(--accent); }
  .snz-proc-mic :global(svg) { width: 19px; height: 19px; }
  .snz-proc-swap { transition: opacity .3s, transform .3s; }

  @media (max-width: 860px) {
    #snz-proc-anim { height: 480vh; }
    .snz-proc-pin { padding: 0 18px; justify-content: flex-start; }
    .snz-proc-head { position: static; margin-top: 13vh; }
    .snz-proc-alt { top: 13vh; right: 18px; }
    .snz-proc-alt .snz-proc-pct { font-size: 34px; }
    .snz-proc-map { margin-top: 18px; flex: 1; display: flex; align-items: center; }
    .snz-proc-card { display: none; }
    .snz-proc-mcap {
      display: block; position: absolute; left: 18px; right: 18px; bottom: 8vh; z-index: 6;
      border: 1px solid rgba(198,244,50,.25); background: rgba(12,12,10,.9); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
      border-radius: 16px; padding: 18px 20px; box-shadow: 0 16px 40px -26px rgba(198,244,50,.5);
    }
    .snz-proc-hint { bottom: 2.5vh; }
  }

  /* ---- reduced motion: drop the animation, show the list ---- */
  @media (prefers-reduced-motion: reduce) {
    #snz-proc-anim { display: none; }
    #snz-proc-static { display: block; }
    .snz-proc-hint, .snz-proc-glow { animation: none; }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const dataEl = document.getElementById('snz-proc-data');
  if (!reduce && dataEl) {
    type Step = { n: string; title: string; body: string; svg: string };
    const STEPS: Step[] = JSON.parse(dataEl.textContent || '[]');
    const N = STEPS.length;

    const route = document.getElementById('snz-proc-route') as unknown as SVGPathElement;
    const live = document.getElementById('snz-proc-live') as unknown as SVGPathElement;
    const train = document.getElementById('snz-proc-train') as unknown as SVGGElement;
    const svgEl = document.getElementById('snz-proc-svg') as unknown as SVGSVGElement;
    const wrap = document.getElementById('snz-proc-anim') as HTMLElement;
    const stnsG = document.getElementById('snz-proc-stns') as unknown as SVGGElement;
    const cardsEl = document.getElementById('snz-proc-cards') as HTMLElement;
    const pctv = document.getElementById('snz-proc-pctv') as HTMLElement;

    if (route && live && train && svgEl && wrap) {
      const L = route.getTotalLength();
      live.style.strokeDasharray = String(L);
      live.style.strokeDashoffset = String(L);
      const fr = (i: number) => i / (N - 1);

      const stnEls = Array.from(stnsG.children) as Element[];
      const cardEls = Array.from(cardsEl.children) as HTMLElement[];

      const mq = window.matchMedia('(max-width: 860px)');
      const setStroke = () => {
        const w = mq.matches ? 5 : 7;
        route.style.strokeWidth = String(w);
        live.style.strokeWidth = String(w);
      };
      setStroke();
      mq.addEventListener('change', setStroke);

      const CAM = { w: 300, h: 230 };
      let lastAct = -1;
      const mic = document.getElementById('snz-proc-mic');
      const mn = document.getElementById('snz-proc-mn');
      const mt = document.getElementById('snz-proc-mt');
      const mp = document.getElementById('snz-proc-mp');
      const swap = document.getElementById('snz-proc-swap');
      const paintCap = (i: number) => {
        const s = STEPS[i];
        if (mic) mic.innerHTML = s.svg;
        if (mn) mn.textContent = 'STEP ' + s.n + ' / 0' + N;
        if (mt) mt.textContent = s.title;
        if (mp) mp.textContent = s.body;
      };
      paintCap(0);

      let raf: number | null = null;
      const render = () => {
        raf = null;
        const total = wrap.offsetHeight - window.innerHeight;
        const p = total > 0 ? Math.min(1, Math.max(0, -wrap.getBoundingClientRect().top / total)) : 0;

        live.style.strokeDashoffset = String(L * (1 - p));
        const pt = route.getPointAtLength(L * p);
        train.setAttribute('transform', `translate(${pt.x},${pt.y})`);
        const act = Math.round(p * (N - 1));
        stnEls.forEach((s, i) => s.classList.toggle('on', fr(i) <= p + 0.001));
        cardEls.forEach((c, i) => c.classList.toggle('on', i === act));
        if (pctv) pctv.textContent = Math.round(p * 100) + '%';

        if (mq.matches) {
          const vx = Math.min(1000 - CAM.w, Math.max(0, pt.x - CAM.w / 2));
          const vy = Math.min(440 - CAM.h, Math.max(0, pt.y - CAM.h / 2));
          svgEl.setAttribute('viewBox', `${vx} ${vy} ${CAM.w} ${CAM.h}`);
          if (act !== lastAct) {
            lastAct = act;
            if (swap) {
              swap.style.opacity = '0';
              swap.style.transform = 'translateY(8px)';
              window.setTimeout(() => {
                paintCap(act);
                swap.style.opacity = '1';
                swap.style.transform = 'none';
              }, 150);
            }
          }
        } else if (svgEl.getAttribute('viewBox') !== '0 0 1000 440') {
          svgEl.setAttribute('viewBox', '0 0 1000 440');
        }
      };
      const onScroll = () => { if (raf == null) raf = requestAnimationFrame(render); };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      mq.addEventListener('change', () => { if (!mq.matches) svgEl.setAttribute('viewBox', '0 0 1000 440'); });
      render();
    }
  }
</script>
