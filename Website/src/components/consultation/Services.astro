---
// Services grid: the things people come to me to build.
const services = [
  { n: '01', title: 'Websites', body: 'A one-of-a-kind website, built by hand from a blank page — no templates, no WordPress. Designed around you and truly yours to own.' },
  { n: '02', title: 'Mobile apps', body: 'Apps for iPhone and Android, built once and sent to both app stores — smooth, fast and right at home on a phone.' },
  { n: '03', title: 'Products, from scratch', body: 'Got an idea? I take it from a sketch to a real, working product people can use — designed and built with you at every step.' },
  { n: '04', title: 'The engine behind it', body: 'The behind-the-scenes part that makes everything work — accounts, logins, payments and data, set up to be safe and to grow with you.' },
  { n: '05', title: 'Smart AI features', body: 'Helpful AI built into your product where it genuinely adds value — answering questions, cutting out busywork — never gimmicks.' },
  { n: '06', title: 'A second opinion', body: "Already had something built? I'll review it and tell you in plain English what's working, what's risky, and what to fix first." },
];
---
<section id="snz-services" style="padding:96px 56px;border-bottom:1px solid rgba(255,255,255,.08)">
  <div data-reveal style="display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:20px;margin-bottom:54px">
    <div>
      <div style="font:600 11px 'JetBrains Mono',monospace;letter-spacing:.2em;color:var(--accent);margin-bottom:18px">[ 01 ] CAPABILITIES</div>
      <h2 class="snz-display" style="margin:0;font:800 60px/0.98 'Archivo',sans-serif;letter-spacing:-0.035em">What I build</h2>
    </div>
    <p style="margin:0;max-width:340px;font:400 14px/1.6 'JetBrains Mono',monospace;color:#8a8a82">Whatever you need made, I can probably make it. A few of the things people come to me for — explained without the jargon.</p>
  </div>
  <div id="snz-svc" style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.08)">
    {services.map((s, i) => (
      <div data-reveal data-delay={(i % 3) * 70} class="snz-card" style="background:#0a0a0a;padding:34px 30px;cursor:default;transition:background .35s ease,transform .35s ease">
        <div style="font:700 13px 'JetBrains Mono',monospace;color:#3a3a36;margin-bottom:46px">{s.n}</div>
        <h3 style="margin:0 0 12px;font:700 22px 'Archivo',sans-serif;letter-spacing:-0.02em">{s.title}</h3>
        <p style="margin:0;font:400 14px/1.6 'JetBrains Mono',monospace;color:#9a9a92">{s.body}</p>
      </div>
    ))}
  </div>
</section>

<style>
  @media (max-width: 760px) {
    #snz-services { padding: 64px 22px !important; }
  }
</style>
