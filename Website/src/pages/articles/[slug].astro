---
import '@/styles/global.css';
import BaseHead from '@/components/BaseHead.astro';
import { getCollection, render } from 'astro:content';
import TagList from '@/components/articles/TagList.astro';
import AdUnit from '@/components/AdUnit.astro';

export async function getStaticPaths() {
  const posts = await getCollection('articles', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter(h => h.depth === 2);
const hasToc = tocHeadings.length >= 2;

const formattedDate = post.data.date.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const wordCount = post.body?.split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 238));

// Social/share image: per-article hero when set, else the site avatar.
const ogImageAbs = new URL(post.data.heroImage ?? '/images/avatar.webp', Astro.site ?? 'https://snazzie.space').href;
const articleTwitterCard = post.data.heroImage ? 'summary_large_image' : 'summary';

// Canonical TTS processing — single source of truth.
// Python generate-audio.py reads the .txt output this writes; "see raw script" shows it.
const WORD_SUBS: Record<string, string> = {
  "stays": "stays[S T EY1 Z]",
};

function buildTtsScript(body: string): string {
  let t = body;
  t = t.replace(/^---.*?---\s*/s, '');                         // strip frontmatter
  t = t.replace(/^(import|export)\s+.*$/gm, '');               // strip MDX imports/exports
  t = t.replace(/<[^>]*data-tts-skip[^>]*>[\s\S]*?^<\/\w+>/gm, ''); // strip data-tts-skip blocks — outer closing tag is at col 0
  t = t.replace(/```.*?```/gs, '');                            // strip code blocks BEFORE tag/inline strip
  t = t.replace(/`[^`]+`/g, '');                               // strip inline code BEFORE tag strip (prevents empty backtick pairs eating content)
  t = t.replace(/<[^>]+>/g, '');                               // strip JSX/HTML tags
  t = t.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1');               // markdown links → display text only
  t = t.replace(/^#{1,6}\s+(.+)$/gm, '$1.');                   // headers: trailing period for post-header pause (pre-header pause comes from paragraph break)
  t = t.replace(/\*{1,3}([^*]+)\*{1,3}/g, ' $1 ');            // strip bold/italic markers
  t = t.replace(/ {2,}/g, ' ');                                // collapse multiple spaces
  t = t.replace(/[–—―]/g, ', ');                               // em/en dashes → comma pause
  for (const [word, replacement] of Object.entries(WORD_SUBS)) {
    t = t.replace(new RegExp(`\\b${word}\\b`, 'gi'), replacement); // known mispronunciation fixes
  }
  t = t.replace(/\S+(\[[^\]]+\])/g, '$1');                     // word[PHONEME] → [PHONEME]
  t = t.replace(/[›»«‹]/g, '');                               // strip decorative arrow/quote chars
  t = t.replace(/\n+/g, ' ... ');                              // flatten newlines → inline pause markers
  t = t.replace(/ {2,}/g, ' ');                               // collapse spaces created by flatten
  t = t.replace(/^(?:\s*\.\.\.\s*)+/, '').replace(/(?:\s*\.\.\.\s*)+$/, ''); // drop leading/trailing pause markers from stripped imports/components
  return t.trim();
}

const ttsScript = buildTtsScript(post.body ?? '');

// Display version: all TTS transforms applied but newlines preserved — shows exactly what Python gets, structured for readability
function buildDisplayScript(body: string): string {
  let t = body;
  t = t.replace(/^---.*?---\s*/s, '');                         // strip frontmatter
  t = t.replace(/^(import|export)\s+.*$/gm, '');               // strip MDX imports/exports
  t = t.replace(/<[^>]*data-tts-skip[^>]*>[\s\S]*?^<\/\w+>/gm, ''); // strip data-tts-skip blocks — outer closing tag is at col 0
  t = t.replace(/```.*?```/gs, '');                            // strip code blocks BEFORE tag/inline strip
  t = t.replace(/`[^`]+`/g, '');                               // strip inline code BEFORE tag strip
  t = t.replace(/<[^>]+>/g, '');                               // strip JSX/HTML tags
  t = t.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1');               // markdown links → display text only
  t = t.replace(/^#{1,6}\s+(.+)$/gm, '$1.');                   // headers: trailing period for post-header pause
  t = t.replace(/\*{1,3}([^*]+)\*{1,3}/g, ' $1 ');            // strip bold/italic markers
  t = t.replace(/ {2,}/g, ' ');                                // collapse multiple spaces
  t = t.replace(/[–—―]/g, ', ');                               // em/en dashes → comma pause
  for (const [word, replacement] of Object.entries(WORD_SUBS)) {
    t = t.replace(new RegExp(`\\b${word}\\b`, 'gi'), replacement);
  }
  t = t.replace(/\S+(\[[^\]]+\])/g, '$1');                     // word[PHONEME] → [PHONEME]
  t = t.replace(/\n{3,}/g, '\n\n');                            // normalise blank lines
  return t.trim();
}

import { existsSync, readFileSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';
const audioDir = join(process.cwd(), 'public', 'audio');
const audioPath = `/audio/${post.id}.flac`;
const hasAudio = existsSync(join(audioDir, `${post.id}.flac`));
const waveformPath = join(audioDir, `${post.id}-waveform.json`);
const waveformData: number[] = hasAudio && existsSync(waveformPath)
  ? JSON.parse(readFileSync(waveformPath, 'utf8'))
  : [];

// Write canonical TTS script so Python reads JS-processed text, not raw MDX
import { mkdirSync } from 'node:fs';
mkdirSync(audioDir, { recursive: true });
writeFileSync(join(audioDir, `${post.id}.txt`), ttsScript, 'utf8');
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <BaseHead
      title={`${post.data.title} — Aaron Cooper`}
      description={post.data.excerpt}
      path={`/articles/${post.id}/`}
      ogType="article"
      image={ogImageAbs}
      twitterCard={articleTwitterCard}
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": post.data.title,
      "description": post.data.excerpt,
      "image": ogImageAbs,
      "datePublished": post.data.date.toISOString(),
      ...(post.data.updatedDate && { "dateModified": post.data.updatedDate.toISOString() }),
      "author": {
        "@type": "Person",
        "name": "Aaron Cooper",
        "url": "https://snazzie.space"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Snazzie",
        "url": "https://snazzie.space",
        "logo": {
          "@type": "ImageObject",
          "url": "https://snazzie.space/favicon.svg"
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": `https://snazzie.space/articles/${post.id}/`
      },
      "keywords": post.data.tags.join(", "),
      "wordCount": wordCount,
      "timeRequired": `PT${readingTime}M`
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://snazzie.space/" },
        { "@type": "ListItem", "position": 2, "name": "Articles", "item": "https://snazzie.space/articles/" },
        { "@type": "ListItem", "position": 3, "name": post.data.title }
      ]
    })} />
    <style>
      .prose h2, .prose h3, .prose h4 { scroll-margin-top: 5rem; }
    </style>
  </head>
  <body class="bg-background text-foreground antialiased">
    <header id="sticky-header" class="sticky top-0 z-40 bg-background/90 backdrop-blur border-b border-white/5 -translate-y-full transition-transform duration-200">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center gap-3">
        <a href="/articles/" class="text-sm text-white/50 hover:text-white transition-colors shrink-0">&larr; Articles</a>
        <span class="text-white/20 shrink-0 hidden sm:inline">&middot;</span>
        <span class="text-sm font-medium text-white truncate flex-1 min-w-0 hidden sm:block">{post.data.title}</span>

        {hasAudio && (
          <div class="flex items-center gap-2 shrink-0 ml-auto">
            <button
              id="s-play-btn"
              aria-label="Play article audio"
              class="w-7 h-7 flex items-center justify-center rounded-full bg-white text-black hover:bg-white/90 active:scale-95 transition-all duration-150"
            >
              <svg id="s-icon-play" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3 translate-x-px">
                <path d="M8 5v14l11-7z"/>
              </svg>
              <svg id="s-icon-pause" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3 hidden">
                <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
              </svg>
            </button>

            <div class="relative hidden sm:block" id="s-track" style="width:180px;height:36px">
              <canvas id="s-waveform" class="absolute inset-0 w-full h-full"></canvas>
              <input id="s-seek" type="range" min="0" max="100" value="0" step="0.1"
                class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" />
            </div>

            <div class="flex items-center gap-0.5 text-[11px] text-white/30 tabular-nums">
              <span id="s-current">0:00</span>
              <span class="text-white/20">/</span>
              <span id="s-duration">0:00</span>
            </div>

            <input id="s-volume" type="range" min="0" max="1" value="0.5" step="0.05"
              aria-label="Volume" class="hidden sm:block w-14 h-0.5 accent-white/40 cursor-pointer" />
          </div>
        )}
      </div>
    </header>

    <main class="min-h-screen pt-10 pb-24">
      <div class="px-4 sm:px-6 lg:px-8">
        <div class={`mx-auto ${hasToc ? 'xl:flex xl:gap-16 xl:items-start xl:max-w-[1200px] max-w-3xl' : 'max-w-3xl'}`}>

          {hasToc && (
            <aside class="hidden xl:block xl:w-52 xl:shrink-0">
              <nav class="sticky top-24" aria-label="Table of contents">
                <p class="text-[10px] font-semibold uppercase tracking-widest text-white/25 mb-4">On this page</p>
                <ul class="space-y-1">
                  {tocHeadings.map(h => (
                    <li>
                      <a
                        href={`#${h.slug}`}
                        data-toc-link={h.slug}
                        class="block text-sm text-white/40 hover:text-white/70 transition-colors leading-snug py-0.5 border-l border-transparent hover:border-white/20 pl-3 -ml-3"
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </aside>
          )}

          <article class={`min-w-0 w-full ${hasToc ? 'mx-auto xl:mx-0' : ''}`}>

        <nav aria-label="Breadcrumb" class="mb-8">
          <a href="/articles/" class="inline-flex items-center gap-1.5 text-sm text-white/50 hover:text-white transition-colors">
            &larr; All articles
          </a>
        </nav>

        <header id="article-header" class="mb-10">
          <div class="flex items-center gap-3 text-sm text-white/50 mb-4">
            <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
            <span>&middot;</span>
            <span>{readingTime} min read</span>
            <span>&middot;</span>
            <button id="mdx-toggle" class="font-mono hover:text-white transition-colors">see raw script</button>
          </div>
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-white leading-tight">
            {post.data.title}
          </h1>
          <p class="mt-4 text-lg text-white/60">{post.data.excerpt}</p>
          <p class="mt-4 text-sm text-white/40">
            Published by <a href="/" class="text-white/60 hover:text-white transition-colors">Aaron Cooper</a>
          </p>
          {post.data.tags.length > 0 && (
            <div class="mt-6">
              <TagList tags={post.data.tags} />
            </div>
          )}
        </header>

        {hasAudio && (
          <div id="body-audio-player" class="mb-10 rounded-2xl border border-white/[0.08] bg-white/[0.03] backdrop-blur-sm overflow-hidden transition-opacity duration-300">
            <div class="px-5 pt-5 pb-5">
              <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5 text-white/30">
                    <path d="M13.5 4.06c0-1.336-1.616-2.005-2.56-1.06l-4.5 4.5H4.508c-1.141 0-2.318.664-2.66 1.905A9.76 9.76 0 001.5 12c0 .898.121 1.768.35 2.595.341 1.24 1.518 1.905 2.659 1.905h1.93l4.5 4.5c.945.945 2.561.276 2.561-1.06V4.06zM18.584 5.106a.75.75 0 011.06 0c3.808 3.807 3.808 9.98 0 13.788a.75.75 0 11-1.06-1.06 8.25 8.25 0 000-11.668.75.75 0 010-1.06z"/>
                    <path d="M15.932 7.757a.75.75 0 011.061 0 6 6 0 010 8.486.75.75 0 01-1.06-1.061 4.5 4.5 0 000-6.364.75.75 0 010-1.061z"/>
                  </svg>
                  <span class="text-xs font-medium text-white/30 uppercase tracking-widest">Listen to article</span>
                </div>
                <div class="flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3 text-white/25">
                    <path d="M13.5 4.06c0-1.336-1.616-2.005-2.56-1.06l-4.5 4.5H4.508c-1.141 0-2.318.664-2.66 1.905A9.76 9.76 0 001.5 12c0 .898.121 1.768.35 2.595.341 1.24 1.518 1.905 2.659 1.905h1.93l4.5 4.5c.945.945 2.561.276 2.561-1.06V4.06z"/>
                  </svg>
                  <input id="audio-volume" type="range" min="0" max="1" value="0.5" step="0.05"
                    aria-label="Volume" class="w-20 h-1 accent-white/50 cursor-pointer" />
                </div>
              </div>
              <div class="flex items-center gap-3">
                <button id="audio-play-btn" aria-label="Play article audio"
                  class="flex-shrink-0 w-9 h-9 flex items-center justify-center rounded-full bg-white text-black hover:bg-white/90 active:scale-95 transition-all duration-150 shadow-lg shadow-white/10">
                  <svg id="icon-play" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5 translate-x-px">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                  <svg id="icon-pause" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5 hidden">
                    <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
                  </svg>
                </button>
                <div class="relative cursor-pointer flex-1 min-w-0" id="audio-track" style="height:36px">
                  <canvas id="audio-waveform" class="absolute inset-0 w-full h-full"></canvas>
                  <input id="audio-seek" type="range" min="0" max="100" value="0" step="0.1"
                    class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" />
                </div>
                <div class="flex-shrink-0 flex items-center gap-1 text-[11px] text-white/30 tabular-nums">
                  <span id="audio-current">0:00</span>
                  <span>/</span>
                  <span id="audio-duration">0:00</span>
                </div>
              </div>
            </div>
            <audio id="article-audio" preload="metadata" src={audioPath}
              data-waveform={JSON.stringify(waveformData)}></audio>
          </div>
        )}

        {post.data.heroImage && (
          <div class="aspect-[16/9] rounded-xl overflow-hidden mb-10 border border-white/10">
            <img
              src={post.data.heroImage}
              alt={`Cover image for ${post.data.title}`}
              width="1200"
              height="675"
              class="w-full h-full object-cover"
            />
          </div>
        )}

        <div id="article-content">
          <div class="prose prose-invert prose-base max-w-none
            prose-headings:font-semibold prose-headings:tracking-tight
            prose-a:text-white prose-a:underline prose-a:underline-offset-4 prose-a:hover:text-white/80
            prose-strong:text-white
            prose-code:text-white/80 prose-code:bg-white/5 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:before:content-none prose-code:after:content-none
            prose-pre:bg-white/5 prose-pre:border prose-pre:border-white/10 prose-pre:rounded-xl
            prose-blockquote:border-white/20 prose-blockquote:text-white/60
            prose-li:marker:text-white/30
            prose-hr:border-white/10
          ">
            <Content />
          </div>
        </div>

        <!-- Ad: replace slot with a real data-ad-slot from your AdSense dashboard -->
        <AdUnit class="my-12" slot="3853068378" />

        <pre
          id="raw-script"
          class="hidden text-xs text-white/50 bg-white/[0.03] border border-white/[0.08] rounded-xl p-5 overflow-x-auto whitespace-pre-wrap break-words font-mono leading-relaxed"
        >{buildDisplayScript(post.body ?? '')}</pre>

        <nav class="mt-16 pt-8 border-t border-white/10" aria-label="Article navigation">
          <a href="/articles/" class="text-sm text-white/50 hover:text-white transition-colors">
            &larr; All articles
          </a>
        </nav>

          </article>
        </div>
      </div>
    </main>

    <script is:inline>
      (function () {
        var stickyHeader = document.getElementById('sticky-header');
        var articleHeader = document.getElementById('article-header');
        var bodyPlayer = document.getElementById('body-audio-player');
        if (!stickyHeader || !articleHeader) return;
        new IntersectionObserver(function (entries) {
          var visible = entries[0].isIntersecting;
          stickyHeader.classList.toggle('-translate-y-full', visible);
          stickyHeader.classList.toggle('translate-y-0', !visible);
          if (bodyPlayer) bodyPlayer.style.opacity = visible ? '1' : '0.2';
          if (!visible && window.__redrawStickyWaveform) window.__redrawStickyWaveform();
        }, { threshold: 0 }).observe(articleHeader);
      })();
    </script>
    <script is:inline>
      (function () {
        var btn     = document.getElementById('mdx-toggle');
        var content = document.getElementById('article-content');
        var raw     = document.getElementById('raw-script');
        if (!btn || !content || !raw) return;
        var showing = false;
        btn.addEventListener('click', function () {
          showing = !showing;
          content.classList.toggle('hidden', showing);
          raw.classList.toggle('hidden', !showing);
          btn.textContent = showing ? 'see rendered' : 'see raw script';
        });
      })();
    </script>
    <script is:inline>
      document.querySelectorAll('.prose a[href^="http"]').forEach(function (a) {
        a.setAttribute('target', '_blank');
        a.setAttribute('rel', 'noopener noreferrer');
      });
    </script>
    <script is:inline>
      (function () {
        var audio = document.getElementById('article-audio');
        if (!audio) return;

        var DPR = window.devicePixelRatio || 1;
        var playPct = 0;
        var peaks = [];
        try { peaks = JSON.parse(audio.dataset.waveform || '[]'); } catch(e) {}

        function fmt(s) {
          if (!isFinite(s)) return '0:00';
          var m = Math.floor(s / 60), sec = Math.floor(s % 60);
          return m + ':' + (sec < 10 ? '0' : '') + sec;
        }

        function drawCanvas(canvas) {
          if (!canvas) return;
          var ctx = canvas.getContext('2d');
          var W = canvas.width, H = canvas.height;
          ctx.clearRect(0, 0, W, H);
          if (!peaks.length) return;
          var n = peaks.length, gap = Math.round(DPR * 1.5);
          var barW = Math.max(1, (W - gap * (n - 1)) / n);
          var cx = Math.floor(playPct * W);
          for (var i = 0; i < n; i++) {
            var barH = Math.max(DPR * 2, peaks[i] * H * 0.92);
            var x = i * (barW + gap);
            var played = (x + barW) <= cx, head = x <= cx && cx < (x + barW);
            ctx.fillStyle = played ? 'rgba(255,255,255,0.85)' : head ? 'rgba(255,255,255,0.95)' : 'rgba(255,255,255,' + (0.12 + peaks[i] * 0.12) + ')';
            var y = (H - barH) / 2;
            ctx.beginPath(); ctx.roundRect(x, y, barW, barH, Math.min(barW / 2, DPR * 2)); ctx.fill();
          }
        }

        function resizeCanvas(canvas) {
          if (!canvas) return;
          canvas.width  = canvas.offsetWidth  * DPR;
          canvas.height = canvas.offsetHeight * DPR;
          drawCanvas(canvas);
        }

        var bodyCanvas  = document.getElementById('audio-waveform');
        var stickyCanvas = document.getElementById('s-waveform');

        function updateUI() {
          playPct = audio.duration ? audio.currentTime / audio.duration : 0;
          var pct100 = playPct * 100;
          var cur = fmt(audio.currentTime);
          var seek = document.getElementById('audio-seek');
          var sCur = document.getElementById('audio-current');
          if (seek)  seek.value = pct100;
          if (sCur)  sCur.textContent = cur;
          var sSeek = document.getElementById('s-seek');
          var sSCur = document.getElementById('s-current');
          if (sSeek) sSeek.value = pct100;
          if (sSCur) sSCur.textContent = cur;
          drawCanvas(bodyCanvas);
          drawCanvas(stickyCanvas);
        }

        function setPlayState(playing) {
          var ip = document.getElementById('icon-play'),   ipu = document.getElementById('icon-pause');
          var sp = document.getElementById('s-icon-play'), spu = document.getElementById('s-icon-pause');
          if (ip)  ip.classList.toggle('hidden', playing);
          if (ipu) ipu.classList.toggle('hidden', !playing);
          if (sp)  sp.classList.toggle('hidden', playing);
          if (spu) spu.classList.toggle('hidden', !playing);
        }

        function setDuration() {
          var d = fmt(audio.duration);
          var el = document.getElementById('audio-duration');
          var sel = document.getElementById('s-duration');
          if (el)  el.textContent = d;
          if (sel) sel.textContent = d;
        }

        var volume = document.getElementById('audio-volume');
        var sVolume = document.getElementById('s-volume');
        audio.volume = 0.5;
        if (volume)  volume.addEventListener('input', function () { audio.volume = volume.value; if (sVolume) sVolume.value = volume.value; });
        if (sVolume) sVolume.addEventListener('input', function () { audio.volume = sVolume.value; if (volume) volume.value = sVolume.value; });

        var btn  = document.getElementById('audio-play-btn');
        var sBtn = document.getElementById('s-play-btn');
        function togglePlay() { if (audio.paused) audio.play(); else audio.pause(); }
        if (btn)  btn.addEventListener('click', togglePlay);
        if (sBtn) sBtn.addEventListener('click', togglePlay);

        var seek  = document.getElementById('audio-seek');
        var sSeekEl = document.getElementById('s-seek');
        function seekTo(val) { if (audio.duration) { audio.currentTime = (val / 100) * audio.duration; updateUI(); } }
        if (seek)    seek.addEventListener('input',    function () { seekTo(seek.value); });
        if (sSeekEl) sSeekEl.addEventListener('input', function () { seekTo(sSeekEl.value); });

        audio.addEventListener('play',         function () { setPlayState(true); });
        audio.addEventListener('pause',        function () { setPlayState(false); });
        audio.addEventListener('ended',        function () { setPlayState(false); });
        audio.addEventListener('timeupdate',   updateUI);
        audio.addEventListener('loadedmetadata', setDuration);
        if (audio.readyState >= 1 && audio.duration) setDuration();

        window.__redrawStickyWaveform = function () {
          resizeCanvas(stickyCanvas);
          drawCanvas(stickyCanvas);
        };

        window.addEventListener('resize', function () {
          resizeCanvas(bodyCanvas);
          resizeCanvas(stickyCanvas);
        });
        resizeCanvas(bodyCanvas);
        requestAnimationFrame(function () { resizeCanvas(stickyCanvas); });
      })();
    </script>
    <script is:inline>
      (function () {
        // Heading anchor link icons (show on hover, click copies anchor to URL)
        var linkSvg = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:0.85em;height:0.85em;display:inline-block;vertical-align:middle"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>';
        document.querySelectorAll('.prose h2, .prose h3').forEach(function (h) {
          if (!h.id) return;
          h.style.position = 'relative';
          var a = document.createElement('a');
          a.href = '#' + h.id;
          a.setAttribute('aria-label', 'Link to this section');
          a.innerHTML = linkSvg;
          a.style.cssText = 'position:absolute;right:0;top:50%;transform:translateY(-50%);opacity:0;transition:opacity 0.15s;color:rgba(255,255,255,0.3);padding:0.15em 0.25em;';
          a.addEventListener('click', function (e) {
            e.preventDefault();
            history.pushState(null, '', '#' + h.id);
            h.scrollIntoView({ behavior: 'smooth' });
          });
          h.addEventListener('mouseenter', function () { a.style.opacity = '1'; });
          h.addEventListener('mouseleave', function () { a.style.opacity = '0'; });
          h.appendChild(a);
        });

        // TOC active state via IntersectionObserver
        var tocLinks = document.querySelectorAll('[data-toc-link]');
        if (!tocLinks.length) return;
        var activeClass = ['text-white', 'border-l', 'border-white/40', 'pl-3', '-ml-3'];
        var inactiveClass = ['text-white/40', 'border-l', 'border-transparent', 'pl-3', '-ml-3'];
        function setActive(slug) {
          tocLinks.forEach(function (link) {
            var isActive = link.getAttribute('data-toc-link') === slug;
            activeClass.forEach(function (c) { link.classList.toggle(c, isActive); });
            inactiveClass.forEach(function (c) {
              if (!isActive) link.classList.add(c);
              else link.classList.remove('text-white/40', 'border-transparent');
            });
          });
        }
        var headingEls = Array.from(document.querySelectorAll('.prose h2[id]'));
        if (!headingEls.length) return;
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) setActive(entry.target.id);
          });
        }, { rootMargin: '-10% 0px -80% 0px' });
        headingEls.forEach(function (h) { io.observe(h); });
      })();
    </script>
    <script is:inline>
      (function () {
        document.querySelectorAll('.sample-play').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var src = btn.getAttribute('data-src');
            if (!src) return;
            new Audio(src).play();
          });
        });
      })();
    </script>
  </body>
</html>
