---
import '@/styles/global.css';
import { getCollection } from 'astro:content';
import ArticleCard from '@/components/articles/ArticleCard.astro';
import TagList from '@/components/articles/TagList.astro';
import { LunarArticles } from '@/components/LunarArticles';

const PAGE_SIZE = 12;

const allPosts = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featured = allPosts.find((p) => p.data.featured) ?? null;
const posts = allPosts.filter((p) => !p.data.featured);
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Articles — Aaron Cooper</title>
    <meta name="description" content="Technical articles and project breakdowns by Aaron Cooper." />
    <link rel="canonical" href="https://snazzie.space/articles/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Aaron Cooper — Articles" href="/rss.xml" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://snazzie.space/" },
        { "@type": "ListItem", "position": 2, "name": "Articles" }
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Articles",
      "description": "Technical articles and project breakdowns by Aaron Cooper.",
      "url": "https://snazzie.space/articles/",
      "isPartOf": { "@type": "WebSite", "name": "Aaron Cooper", "url": "https://snazzie.space" }
    })} />
  </head>
  <body class="bg-background text-foreground antialiased">
    <header class="pointer-events-none fixed inset-x-0 top-0 z-50 flex justify-center pt-4 px-4">
      <nav class="pointer-events-auto flex items-center gap-1 rounded-full border border-border bg-card/80 px-2 py-1.5 backdrop-blur-md w-full max-w-2xl">
        <div class="flex items-center gap-2 px-3 text-sm font-semibold text-foreground shrink-0">
          <a href="/" aria-label="Aaron, home" class="flex items-center gap-2">
            <span class="size-2 rounded-full bg-foreground" aria-hidden="true"></span>
            Aaron
          </a>
          <span class="text-muted-foreground font-normal" aria-hidden="true">/</span>
          <h1 class="font-semibold">Articles</h1>
        </div>
        <a href="/rss.xml" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-foreground transition-colors shrink-0 px-1" aria-label="RSS Feed">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 11a9 9 0 0 1 9 9" /><path d="M4 4a16 16 0 0 1 16 16" /><circle cx="5" cy="19" r="1" />
          </svg>
        </a>
        <div class="flex-1 px-1">
          <label for="article-search" class="sr-only">Search articles</label>
          <input
            id="article-search"
            type="search"
            placeholder="Search articles..."
            class="w-full px-3 py-1 rounded-full bg-white/5 border border-white/10 text-foreground text-sm placeholder:text-muted-foreground focus:outline-none focus:border-white/20 transition-colors"
          />
        </div>
      </nav>
    </header>

    <main class="min-h-screen pt-20 pb-24">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

        {featured && (
          <a href={`/articles/${featured.id}/`} class="group block mb-10 rounded-2xl border border-white/[0.08] bg-white/[0.03] hover:bg-white/[0.06] transition-colors p-6 sm:p-8" aria-label={featured.data.title}>
            <div class="flex items-center gap-2 mb-4">
              <span class="text-[10px] font-semibold uppercase tracking-widest text-white/40 border border-white/10 rounded-full px-2.5 py-0.5">Featured</span>
              <time class="text-xs text-white/30" datetime={featured.data.date.toISOString()}>
                {featured.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </div>
            <h2 class="text-xl sm:text-2xl font-bold text-white group-hover:text-white/80 transition-colors leading-snug mb-3">
              {featured.data.title}
            </h2>
            <p class="text-sm sm:text-base text-white/60 leading-relaxed mb-4 max-w-2xl">
              {featured.data.excerpt}
            </p>
            <ul class="flex flex-wrap gap-1.5" aria-label="Tags">
              {featured.data.tags.map((tag) => (
                <li>
                  <span class="inline-block px-2.5 py-0.5 text-xs rounded-full bg-white/5 border border-white/10 text-white/60">
                    {tag}
                  </span>
                </li>
              ))}
            </ul>
          </a>
        )}

        {posts.length === 0 && !featured && (
          <p class="text-white/40">No articles yet. Check back soon.</p>
        )}

        {posts.length > 0 && (
          <div id="article-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map((post, i) => (
              <div
                class:list={["article-card", { hidden: i >= PAGE_SIZE }]}
                data-index={i}
                data-search-title={post.data.title.toLowerCase()}
                data-search-excerpt={post.data.excerpt.toLowerCase()}
                data-search-tags={post.data.tags.join(' ').toLowerCase()}
              >
                <ArticleCard
                  title={post.data.title}
                  excerpt={post.data.excerpt}
                  date={post.data.date}
                  tags={post.data.tags}
                  slug={post.id}
                  heroImage={post.data.heroImage}
                />
              </div>
            ))}
          </div>
        )}
        <p id="no-results" class="text-white/40 hidden mt-8" role="status">No articles match your search.</p>

        {posts.length > PAGE_SIZE && (
          <div class="mt-12 text-center">
            <button
              id="load-more"
              class="px-6 py-2.5 text-sm rounded-xl bg-white/5 border border-white/10 text-white/60 hover:bg-white/10 hover:text-white transition-colors cursor-pointer"
            >
              Load more
            </button>
          </div>
        )}

      </div>
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <LunarArticles client:idle />
      </div>
    </main>

    <script is:inline define:vars={{ PAGE_SIZE }}>
      (function () {
        var input = document.getElementById('article-search');
        var grid = document.getElementById('article-grid');
        var noResults = document.getElementById('no-results');
        var loadMore = document.getElementById('load-more');
        if (!grid) return;
        var cards = grid.querySelectorAll('.article-card');
        var shown = PAGE_SIZE;

        if (loadMore) {
          loadMore.addEventListener('click', function () {
            var next = Math.min(shown + PAGE_SIZE, cards.length);
            for (var i = shown; i < next; i++) cards[i].classList.remove('hidden');
            shown = next;
            if (shown >= cards.length) loadMore.parentElement.classList.add('hidden');
          });
        }

        if (input) {
          input.addEventListener('input', function () {
            var q = this.value.toLowerCase().trim();
            var visible = 0;
            for (var i = 0; i < cards.length; i++) {
              var card = cards[i];
              if (!q) {
                card.style.display = i < shown ? '' : 'none';
                if (i < shown) { card.classList.remove('hidden'); visible++; }
              } else {
                var match = (card.getAttribute('data-search-title') || '').includes(q)
                  || (card.getAttribute('data-search-excerpt') || '').includes(q)
                  || (card.getAttribute('data-search-tags') || '').includes(q);
                if (match) card.classList.remove('hidden');
                card.style.display = match ? '' : 'none';
                if (match) visible++;
              }
            }
            if (noResults) noResults.classList.toggle('hidden', visible > 0 || !q);
            if (loadMore) loadMore.parentElement.classList.toggle('hidden', !!q || shown >= cards.length);
          });
        }
      })();
    </script>
  </body>
</html>
