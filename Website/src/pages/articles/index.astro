---
import '@/styles/global.css';
import { getCollection } from 'astro:content';
import ArticleCard from '@/components/articles/ArticleCard.astro';
import { LunarArticles } from '@/components/LunarArticles';

const PAGE_SIZE = 12;

const posts = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Articles — Aaron Cooper</title>
    <meta name="description" content="Technical articles and project breakdowns by Aaron Cooper." />
    <link rel="canonical" href="https://snazzie.space/articles/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Aaron Cooper — Articles" href="/rss.xml" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://snazzie.space/" },
        { "@type": "ListItem", "position": 2, "name": "Articles" }
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Articles",
      "description": "Technical articles and project breakdowns by Aaron Cooper.",
      "url": "https://snazzie.space/articles/",
      "isPartOf": { "@type": "WebSite", "name": "Aaron Cooper", "url": "https://snazzie.space" }
    })} />
  </head>
  <body class="bg-background text-foreground antialiased">
    <main class="min-h-screen pt-20 pb-24">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

        <nav aria-label="Breadcrumb" class="mb-10">
          <a href="/" class="inline-flex items-center gap-1.5 text-sm text-white/50 hover:text-white transition-colors">
            &larr; Home
          </a>
        </nav>

        <div class="mb-12">
          <div class="flex items-center gap-3">
            <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">Articles</h1>
            <a href="/rss.xml" target="_blank" rel="noopener noreferrer" class="text-white/30 hover:text-white/60 transition-colors" aria-label="RSS Feed">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 11a9 9 0 0 1 9 9" /><path d="M4 4a16 16 0 0 1 16 16" /><circle cx="5" cy="19" r="1" />
              </svg>
            </a>
          </div>
          <p class="mt-3 text-white/60 max-w-xl">Technical deep-dives and project breakdowns.</p>
          <div class="mt-6">
            <label for="article-search" class="sr-only">Search articles</label>
            <input
              id="article-search"
              type="search"
              placeholder="Search articles..."
              class="w-full sm:w-72 px-4 py-2 rounded-xl bg-white/5 border border-white/10 text-white text-sm placeholder:text-white/30 focus:outline-none focus:border-white/20 transition-colors"
            />
          </div>
        </div>

        {posts.length === 0 ? (
          <p class="text-white/40">No articles yet. Check back soon.</p>
        ) : (
          <div id="article-grid" class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map((post, i) => (
              <div
                class:list={["article-card", { hidden: i >= PAGE_SIZE }]}
                data-index={i}
                data-search-title={post.data.title.toLowerCase()}
                data-search-excerpt={post.data.excerpt.toLowerCase()}
                data-search-tags={post.data.tags.join(' ').toLowerCase()}
              >
                <ArticleCard
                  title={post.data.title}
                  excerpt={post.data.excerpt}
                  date={post.data.date}
                  tags={post.data.tags}
                  slug={post.id}
                  heroImage={post.data.heroImage}
                />
              </div>
            ))}
          </div>
          <p id="no-results" class="text-white/40 hidden mt-8" role="status">No articles match your search.</p>
        )}

        {posts.length > PAGE_SIZE && (
          <div class="mt-12 text-center">
            <button
              id="load-more"
              class="px-6 py-2.5 text-sm rounded-xl bg-white/5 border border-white/10 text-white/60 hover:bg-white/10 hover:text-white transition-colors cursor-pointer"
            >
              Load more
            </button>
          </div>
        )}

      </div>
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <LunarArticles client:idle />
      </div>
    </main>

    <script is:inline define:vars={{ PAGE_SIZE }}>
      (function () {
        var input = document.getElementById('article-search');
        var grid = document.getElementById('article-grid');
        var noResults = document.getElementById('no-results');
        var loadMore = document.getElementById('load-more');
        if (!grid) return;
        var cards = grid.querySelectorAll('.article-card');
        var shown = PAGE_SIZE;

        if (loadMore) {
          loadMore.addEventListener('click', function () {
            var next = Math.min(shown + PAGE_SIZE, cards.length);
            for (var i = shown; i < next; i++) cards[i].classList.remove('hidden');
            shown = next;
            if (shown >= cards.length) loadMore.parentElement.classList.add('hidden');
          });
        }

        if (input) {
          input.addEventListener('input', function () {
            var q = this.value.toLowerCase().trim();
            var visible = 0;
            for (var i = 0; i < cards.length; i++) {
              var card = cards[i];
              if (!q) {
                card.style.display = i < shown ? '' : 'none';
                if (i < shown) { card.classList.remove('hidden'); visible++; }
              } else {
                var match = (card.getAttribute('data-search-title') || '').includes(q)
                  || (card.getAttribute('data-search-excerpt') || '').includes(q)
                  || (card.getAttribute('data-search-tags') || '').includes(q);
                card.style.display = match ? '' : 'none';
                if (match) visible++;
              }
            }
            if (noResults) noResults.classList.toggle('hidden', visible > 0 || !q);
            if (loadMore) loadMore.parentElement.classList.toggle('hidden', !!q || shown >= cards.length);
          });
        }
      })();
    </script>
  </body>
</html>
