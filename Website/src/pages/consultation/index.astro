---
import ConsultationLayout from '@/layouts/ConsultationLayout.astro';
import Hero from '@/components/consultation/Hero.astro';
import Statement from '@/components/consultation/Statement.astro';
import WireColumns from '@/components/consultation/WireColumns.astro';
import BuildFlow from '@/components/consultation/BuildFlow.astro';
import Work from '@/components/consultation/Work.astro';
import Comparison from '@/components/consultation/Comparison.astro';
import Pricing from '@/components/consultation/Pricing.astro';
import Process from '@/components/consultation/Process.astro';
import Faq from '@/components/consultation/Faq.astro';
import Closing from '@/components/consultation/Closing.astro';

// Structured data: who is behind this and what is offered.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Snazzie',
  description:
    'Freelance software engineer building bespoke websites, mobile apps and full products for individuals and small businesses in the UK.',
  areaServed: 'GB',
  url: 'https://snazzie.space/consultation/',
  email: 'info@snazzie.space',
  priceRange: 'From £1500',
  serviceType: ['Web development', 'Mobile app development', 'Product development'],
  image: 'https://snazzie.space/images/avatar.webp',
  sameAs: ['https://linkedin.com/in/cooper-a-m/', 'https://snazzie.space/'],
  founder: { '@type': 'Person', name: 'Aaron (Snazzie)', jobTitle: 'Software Engineer' },
  knowsAbout: [
    'Search engine optimisation',
    'AI search discoverability',
    'UK GDPR compliance',
    'Web hosting and domains',
    'Web performance',
  ],
};
---

<ConsultationLayout
  title="Freelance Web Developer & App Builder (UK) | Snazzie"
  description="Bespoke, hand-built websites, mobile apps and products for individuals and small businesses. From £1500, owned by you outright, with optional monthly care."
  path="/consultation/"
  schema={serviceSchema}
>
  <!-- hero, statement and the build story share ONE wireframe wall (#snz-wbg, booted + animated by buildflow.ts) -->
  <div id="snz-wallzone" style="position:relative;background:var(--bg1)">
    <!-- out-of-flow layer holding a viewport-tall sticky wall behind everything in the zone -->
    <div style="position:absolute;inset:0;z-index:0;pointer-events:none">
      <div id="snz-wbg" aria-hidden="true" style="position:sticky;top:var(--snz-nav-h,56px);height:calc(100vh - var(--snz-nav-h,56px));display:flex;gap:18px;padding:0 14px;align-items:flex-start;opacity:0.55;overflow:hidden;will-change:transform">
        <div style="position:absolute;inset:0;background:linear-gradient(to bottom,var(--bg1) 0%,transparent 12%,transparent 88%,var(--bg1) 100%);z-index:1;pointer-events:none"></div>
        <WireColumns />
      </div>
    </div>
    <Hero />
    <Statement />
    <BuildFlow />
  </div>
  <Work />
  <Comparison />
  <Pricing />
  <Process />
  <Faq />
  <Closing />
</ConsultationLayout>
