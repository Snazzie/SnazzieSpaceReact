---
import '@/styles/global.css';
import BaseHead from '@/components/BaseHead.astro';

const ICONS: Record<string, string> = {
  globe:
    '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 2.5 15 0 18M12 3c-2.5 2.5-2.5 15 0 18"/>',
  phone:
    '<rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M10.5 18.5h3"/>',
  server:
    '<rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 7.5h.01M7 16.5h.01"/>',
  cloud:
    '<path d="M7 18a4 4 0 0 1-.5-7.97A5.5 5.5 0 0 1 17 9.5a3.5 3.5 0 0 1 .5 6.98"/><path d="M7 18h10"/>',
  compass:
    '<circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5z"/>',
  spark:
    '<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6.5 6.5l2.5 2.5M15 15l2.5 2.5M17.5 6.5 15 9M9 15l-2.5 2.5"/>',
};

const services = [
  {
    title: 'Bespoke websites',
    body: 'Truly custom sites hand-coded from scratch — no WordPress, no builders. A unique, free-forming design built only for you.',
    icon: 'globe',
  },
  {
    title: 'Cross-platform apps',
    body: 'iOS and Android from one codebase. Native where it counts, shipped to the App Store and Google Play.',
    icon: 'phone',
  },
  {
    title: 'APIs & backend',
    body: 'Typed, tested services with the data layer and auth behind them. Built to scale without surprises.',
    icon: 'server',
  },
  {
    title: 'Cloud & infrastructure',
    body: 'Edge workers, CI/CD, and infrastructure-as-code. Deploys that are boring on purpose.',
    icon: 'cloud',
  },
  {
    title: 'Architecture review',
    body: 'Pressure-test a system before you scale. A clear written assessment of risks, bottlenecks, and what to fix first.',
    icon: 'compass',
  },
  {
    title: 'AI agents',
    body: 'LLM-powered features wired into real products — tool use, retrieval, and evaluation, not demos.',
    icon: 'spark',
  },
];

const websiteBuild = [
  'Hand-coded from scratch — no WordPress or page builders',
  'A unique, one-of-a-kind design made only for you',
  'Engineered for top-tier performance, accessibility and SEO',
  'UK GDPR compliant — privacy-first analytics and cookie consent',
  'Cost-optimised hosting — no padded add-ons or fake security fees',
  'Mobile and tablet responsive',
  'Set up with analytics from day one',
  'Deployed live on your own domain',
];

const scores = [
  { label: 'Performance', value: '95+', pct: 95 },
  { label: 'Accessibility', value: '100', pct: 100 },
  { label: 'SEO', value: '100', pct: 100 },
];
// Circumference for the gauge ring (r = 20).
const GAUGE_C = 2 * Math.PI * 20;

const websiteCare = [
  'Web content and copy updates',
  'Analytics tracking and reporting',
  'Ongoing SEO optimisation',
  'GDPR and cookie-consent upkeep',
  'Security, hosting and uptime kept healthy',
];

const steps = [
  {
    title: 'Get in touch',
    body: 'Send me an email with a brief outline of the work. I reply to discuss it and let you know if it is something I can take on.',
  },
  {
    title: 'Discovery call',
    body: 'If we go ahead, we have an initial 30-minute call to talk through the work, what I will need from you, and any examples or designs you want to use as influence.',
  },
  {
    title: 'Deposit',
    body: 'A deposit, based on the scope we estimate from our initial chats, secures your slot and covers the design work. It is credited in full against the final fee once we proceed to build.',
  },
  {
    title: 'Mock-ups',
    body: 'I come back with solution mock-ups and we work together — up to five rounds of iterations — until we land on a final design you are happy with.',
  },
  {
    title: 'Estimate & fee',
    body: 'Once the design is agreed, you get a delivery-date estimate and a fee. With that signed off, work begins.',
  },
];

const stats = [
  { value: 'Full-stack', label: 'web · mobile · cloud' },
  { value: 'From £700', label: 'bespoke websites' },
  { value: '5 rounds', label: 'design iterations' },
];

const LINKEDIN = 'https://linkedin.com/in/cooper-a-m/';

const navLinks = [
  { href: '#services', label: 'Services' },
  { href: '#pricing', label: 'Pricing' },
  { href: '#process', label: 'Process' },
  { href: '/consultation/tos/', label: 'Terms' },
];
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <BaseHead
      title="Work with me — Snazzie"
      description="A generalist builder who picks the right technology for the problem — websites, apps, backend and cloud infrastructure. Websites from £700 with optional monthly care."
      path="/consultation/"
    />
  </head>
  <body class="relative overflow-x-hidden bg-background text-foreground antialiased">
    <!-- Ambient background -->
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
      <div class="bg-grid absolute inset-0"></div>
      <div class="aurora aurora-a absolute -top-40 left-1/2 size-[42rem] -translate-x-1/2 rounded-full"></div>
      <div class="aurora aurora-b absolute top-[30%] -left-40 size-[34rem] rounded-full"></div>
      <div class="aurora aurora-c absolute bottom-0 -right-40 size-[38rem] rounded-full"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_30%,var(--background)_85%)]"></div>
    </div>

    <header class="pointer-events-none fixed inset-x-0 top-0 z-50 flex justify-center pt-4 px-4">
      <nav class="pointer-events-auto flex items-center gap-1 rounded-full border border-white/10 bg-background/60 px-2 py-1.5 backdrop-blur-xl shadow-[0_8px_30px_rgba(0,0,0,0.3)] w-full max-w-2xl">
        <div class="flex items-center gap-2 px-3 text-sm font-semibold text-foreground shrink-0">
          <a href="/" aria-label="Snazzie, home" class="flex items-center gap-2">
            <span class="size-2 rounded-full bg-gradient-to-br from-sky-400 to-violet-500" aria-hidden="true"></span>
            Snazzie
          </a>
        </div>
        <div class="ml-auto flex items-center gap-0.5">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="rounded-full px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-white/10 hover:text-foreground"
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </nav>
    </header>

    <main>
      <!-- Hero -->
      <section class="relative mx-auto max-w-4xl px-6 pb-20 pt-40 text-center sm:pt-48">
        <p data-reveal class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-3.5 py-1.5 text-xs font-medium text-muted-foreground backdrop-blur">
          <span class="relative flex size-2">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-75 motion-reduce:hidden"></span>
            <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
          </span>
          Available for work
        </p>

        <h1 data-reveal class="mt-6 text-balance text-5xl font-bold leading-[1.05] tracking-tight sm:text-6xl md:text-7xl">
          The right tool
          <br class="hidden sm:block" />
          <span class="bg-gradient-to-r from-sky-300 via-violet-300 to-fuchsia-300 bg-clip-text text-transparent">
            for the problem
          </span>
        </h1>

        <p data-reveal class="mx-auto mt-6 max-w-xl text-balance text-lg text-muted-foreground leading-relaxed">
          I am a generalist builder, not a one-trick specialist. Tell me the
          problem and I pick the technology that fits — a simple website, a full
          app, the backend and infrastructure beneath it, or whatever the job
          actually needs.
        </p>

        <div data-reveal class="mt-9 flex flex-wrap items-center justify-center gap-3">
          <a
            href={LINKEDIN}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative inline-flex items-center gap-2 overflow-hidden rounded-full bg-foreground px-6 py-3 text-sm font-semibold text-background transition-transform hover:-translate-y-0.5"
          >
            <span class="sheen absolute inset-0"></span>
            Get in touch on LinkedIn
            <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a
            href="mailto:info@snazzie.space"
            class="inline-flex items-center gap-2 rounded-full border border-white/12 bg-white/[0.04] px-6 py-3 text-sm font-semibold text-foreground backdrop-blur transition-colors hover:bg-white/[0.08]"
          >
            Email me
          </a>
        </div>

        <p data-reveal class="mt-6 inline-flex items-center gap-2 rounded-full border border-white/8 bg-white/[0.03] px-3.5 py-1.5 text-xs text-muted-foreground">
          For individuals &amp; small businesses
        </p>

        <dl data-reveal class="mx-auto mt-14 grid max-w-2xl grid-cols-3 gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/[0.04]">
          {
            stats.map((s) => (
              <div class="bg-background/40 px-4 py-5 backdrop-blur">
                <dt class="text-lg font-bold tracking-tight text-foreground sm:text-xl">{s.value}</dt>
                <dd class="mt-1 text-xs text-muted-foreground">{s.label}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <!-- Services -->
      <section id="services" class="mx-auto max-w-6xl scroll-mt-24 px-6 py-16">
        <div data-reveal class="mb-12 text-center">
          <span class="text-xs font-semibold uppercase tracking-[0.28em] text-muted-foreground">Capabilities</span>
          <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">What I build</h2>
          <p class="mt-3 text-muted-foreground">Whatever the problem needs. A few of the usual shapes.</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            services.map((s) => (
              <article data-reveal class="card-glow group relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] p-6 transition-all duration-300 hover:-translate-y-1 hover:border-white/20">
                <div class="mb-4 inline-flex size-11 items-center justify-center rounded-xl border border-white/10 bg-white/[0.04] text-foreground/80 transition-colors group-hover:text-foreground">
                  <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[s.icon]} />
                </div>
                <h3 class="text-base font-semibold text-foreground">{s.title}</h3>
                <p class="mt-2 text-sm text-muted-foreground leading-relaxed">{s.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <!-- Pricing -->
      <section id="pricing" class="mx-auto max-w-3xl scroll-mt-24 px-6 py-16">
        <div data-reveal class="mb-12 text-center">
          <span class="text-xs font-semibold uppercase tracking-[0.28em] text-muted-foreground">Pricing</span>
          <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">A simple place to start</h2>
          <p class="mt-3 text-muted-foreground">
            Need a website? Here is the easy entry point. Everything bigger is scoped to the problem.
          </p>
        </div>

        <div data-reveal class="gradient-border rounded-3xl p-px">
          <div class="rounded-[calc(1.5rem-1px)] bg-background/80 p-6 backdrop-blur-xl sm:p-8">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <div class="flex items-center gap-3">
                <span class="inline-flex size-10 items-center justify-center rounded-xl border border-white/10 bg-white/[0.05] text-foreground/80">
                  <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS.globe} />
                </span>
                <h3 class="text-xl font-semibold text-foreground">Bespoke website</h3>
              </div>
              <div class="flex items-baseline gap-1.5">
                <span class="bg-gradient-to-r from-sky-300 to-violet-300 bg-clip-text text-3xl font-bold tracking-tight text-transparent">From £700</span>
                <span class="text-sm text-muted-foreground">one-off</span>
              </div>
            </div>
            <p class="mt-4 text-sm text-muted-foreground leading-relaxed">
              A truly custom, one-of-a-kind site — hand-coded from a blank page,
              not assembled from a template. No WordPress, no website builders.
              Free-forming design built around your business, fast and yours to own.
            </p>

            <div class="mt-5 grid grid-cols-3 gap-3">
              {
                scores.map((sc) => (
                  <div class="flex flex-col items-center gap-2.5 rounded-xl border border-emerald-400/15 bg-emerald-400/[0.03] px-2 py-4 text-center">
                    <div class="relative size-[52px]">
                      <svg viewBox="0 0 48 48" class="size-full -rotate-90" aria-hidden="true">
                        <circle cx="24" cy="24" r="20" fill="none" stroke="currentColor" stroke-width="4" class="text-emerald-400/15" />
                        <circle
                          cx="24"
                          cy="24"
                          r="20"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="4"
                          stroke-linecap="round"
                          class="gauge-ring text-emerald-400"
                          style={`stroke-dasharray:${GAUGE_C}px;--target-offset:${GAUGE_C * (1 - sc.pct / 100)}px;`}
                        />
                      </svg>
                      <span class="absolute inset-0 flex items-center justify-center text-sm font-bold text-emerald-300">{sc.value}</span>
                    </div>
                    <span class="text-[11px] font-medium uppercase tracking-wide text-muted-foreground">{sc.label}</span>
                  </div>
                ))
              }
            </div>
            <p class="mt-3 text-center text-[11px] text-muted-foreground">Lighthouse targets every build is engineered to hit.</p>

            <ul class="mt-5 grid gap-2.5 border-t border-white/10 pt-5 sm:grid-cols-2">
              {
                websiteBuild.map((f) => (
                  <li class="flex items-start gap-2.5 text-sm text-muted-foreground">
                    <svg viewBox="0 0 24 24" class="mt-0.5 size-4 shrink-0 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m20 6-11 11-5-5"/></svg>
                    {f}
                  </li>
                ))
              }
            </ul>

            <div class="mt-6 rounded-2xl border border-white/10 bg-white/[0.03] p-5">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h4 class="text-base font-semibold text-foreground">Monthly care</h4>
                <div class="flex items-baseline gap-1.5">
                  <span class="text-xl font-bold tracking-tight text-foreground">from £40</span>
                  <span class="text-sm text-muted-foreground">/ month · optional</span>
                </div>
              </div>
              <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
                Keep the site current and growing without lifting a finger.
              </p>
              <ul class="mt-3 grid gap-2.5 sm:grid-cols-2">
                {
                  websiteCare.map((f) => (
                    <li class="flex items-start gap-2.5 text-sm text-muted-foreground">
                      <svg viewBox="0 0 24 24" class="mt-0.5 size-4 shrink-0 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m20 6-11 11-5-5"/></svg>
                      {f}
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>

        <p data-reveal class="mt-6 text-center text-sm text-muted-foreground leading-relaxed">
          Apps, backend services, infrastructure, or anything more involved are quoted to scope —{' '}
          <a href={LINKEDIN} target="_blank" rel="noopener noreferrer" class="text-foreground underline underline-offset-4 hover:opacity-80 transition-opacity">tell me what you need</a>.
        </p>
        <p data-reveal class="mt-3 text-center text-xs text-muted-foreground">
          Care plan is optional and can be cancelled anytime. Third-party costs (domains, hosting, paid assets) are paid to the provider directly at cost — no markup, no padded packages, no fake security fees.
        </p>
      </section>

      <!-- Enterprise / VC -->
      <section class="mx-auto max-w-3xl px-6 py-12">
        <div data-reveal class="relative overflow-hidden rounded-3xl border border-white/10 bg-white/[0.03] p-6 sm:p-8">
          <div aria-hidden="true" class="pointer-events-none absolute -right-20 -top-20 size-56 rounded-full bg-violet-500/10 blur-3xl"></div>
          <div class="relative flex flex-col items-start justify-between gap-5 sm:flex-row sm:items-center">
            <div>
              <h2 class="text-xl font-semibold text-foreground">Enterprise or VC-backed?</h2>
              <p class="mt-2 max-w-md text-sm text-muted-foreground leading-relaxed">
                Larger teams, funded startups, and ongoing or advisory engagements work differently — scoped to fit, not off this page. Let's talk about what you need.
              </p>
            </div>
            <a
              href={LINKEDIN}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex shrink-0 items-center gap-2 rounded-full border border-white/12 bg-white/[0.05] px-5 py-2.5 text-sm font-semibold text-foreground backdrop-blur transition-colors hover:bg-white/[0.1]"
            >
              Get in touch
            </a>
          </div>
        </div>
      </section>

      <!-- Process -->
      <section id="process" class="mx-auto max-w-3xl scroll-mt-24 px-6 py-16">
        <div data-reveal class="mb-12 text-center">
          <span class="text-xs font-semibold uppercase tracking-[0.28em] text-muted-foreground">Process</span>
          <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">How it works</h2>
          <p class="mt-3 text-muted-foreground">From first email to final design, no guesswork.</p>
        </div>
        <ol class="relative space-y-4 before:absolute before:bottom-6 before:left-[1.4rem] before:top-6 before:w-px before:bg-gradient-to-b before:from-sky-400/40 before:via-violet-400/30 before:to-transparent">
          {
            steps.map((step, i) => (
              <li data-reveal class="relative flex gap-5 rounded-2xl border border-white/10 bg-white/[0.03] p-6 backdrop-blur transition-colors hover:border-white/20">
                <span class="relative z-10 flex size-9 shrink-0 items-center justify-center rounded-full border border-white/15 bg-background text-sm font-bold text-foreground shadow-[0_0_0_4px_var(--background)]">
                  {i + 1}
                </span>
                <div>
                  <h3 class="text-base font-semibold text-foreground">{step.title}</h3>
                  <p class="mt-1.5 text-sm text-muted-foreground leading-relaxed">{step.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- CTA -->
      <section class="mx-auto max-w-4xl px-6 py-16">
        <div data-reveal class="relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-b from-white/[0.06] to-white/[0.02] p-10 text-center sm:p-14">
          <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-24 mx-auto size-72 rounded-full bg-sky-500/10 blur-3xl"></div>
          <h2 class="relative text-3xl font-bold tracking-tight sm:text-4xl">Got a project in mind?</h2>
          <p class="relative mx-auto mt-4 max-w-md text-muted-foreground leading-relaxed">
            Tell me what you are building and where it is stuck. I will come back
            with a clear scope and price.
          </p>
          <div class="relative mt-8 flex flex-wrap items-center justify-center gap-3">
            <a
              href={LINKEDIN}
              target="_blank"
              rel="noopener noreferrer"
              class="group relative inline-flex items-center gap-2 overflow-hidden rounded-full bg-foreground px-6 py-3 text-sm font-semibold text-background transition-transform hover:-translate-y-0.5"
            >
              <span class="sheen absolute inset-0"></span>
              Get in touch on LinkedIn
              <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a
              href="mailto:info@snazzie.space"
              class="inline-flex items-center gap-2 rounded-full border border-white/12 bg-white/[0.04] px-6 py-3 text-sm font-semibold text-foreground backdrop-blur transition-colors hover:bg-white/[0.08]"
            >
              Email me
            </a>
          </div>
          <p class="relative mt-6 text-xs text-muted-foreground">
            All consulting and contract work is subject to my{' '}
            <a href="/consultation/tos/" class="underline underline-offset-4 transition-colors hover:text-foreground">terms of service</a>.
          </p>
        </div>
      </section>
    </main>

    <footer class="mx-auto max-w-5xl px-6 py-12">
      <div class="flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 text-sm text-muted-foreground sm:flex-row">
        <span>Work with me · <a href="/" class="text-foreground underline underline-offset-2 hover:opacity-80 transition-opacity">Snazzie</a></span>
        <nav class="flex items-center gap-5">
          <a href="/consultation/tos/" class="transition-colors hover:text-foreground">Terms</a>
          <a href="mailto:info@snazzie.space" class="transition-colors hover:text-foreground">Contact</a>
        </nav>
      </div>
    </footer>

    <script>
      // Reveal-on-scroll. Respects reduced motion by showing everything up front.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = document.querySelectorAll('[data-reveal]');
      if (reduce || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('reveal-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('reveal-in');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 },
        );
        els.forEach((el) => io.observe(el));
      }

      // Cursor-tracked glow on capability cards.
      if (!reduce) {
        document.querySelectorAll<HTMLElement>('.card-glow').forEach((card) => {
          card.addEventListener('pointermove', (e) => {
            const r = card.getBoundingClientRect();
            card.style.setProperty('--mx', `${e.clientX - r.left}px`);
            card.style.setProperty('--my', `${e.clientY - r.top}px`);
          });
        });
      }
    </script>

    <style is:global>
      @keyframes auroraFloat {
        0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
        50% { transform: translate3d(0, -24px, 0) scale(1.08); }
      }
      @keyframes sheenSweep {
        0% { transform: translateX(-130%) skewX(-20deg); }
        60%, 100% { transform: translateX(260%) skewX(-20deg); }
      }
      .aurora {
        filter: blur(80px);
        opacity: 0.5;
        will-change: transform;
        animation: auroraFloat 14s ease-in-out infinite;
      }
      .aurora-a { background: radial-gradient(circle at center, rgba(56,189,248,0.5), transparent 70%); }
      .aurora-b { background: radial-gradient(circle at center, rgba(139,92,246,0.45), transparent 70%); animation-delay: -4s; }
      .aurora-c { background: radial-gradient(circle at center, rgba(217,70,239,0.4), transparent 70%); animation-delay: -8s; }
      .bg-grid {
        background-image:
