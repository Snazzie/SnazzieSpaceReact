---
import '@/styles/global.css';
import BaseHead from '@/components/BaseHead.astro';

const services = [
  {
    title: 'Web apps & sites',
    body: 'Production React front-ends and marketing sites — fast, accessible, and built to last. From greenfield to rescue.',
  },
  {
    title: 'Cross-platform apps',
    body: 'iOS and Android from one codebase with React Native / Expo. Native modules where it counts, shipped to the stores.',
  },
  {
    title: 'APIs & backend services',
    body: 'Typed, tested APIs and services with the data layer and auth to back them. Built to scale without surprises.',
  },
  {
    title: 'Cloud architecture & DevOps',
    body: 'Cloudflare, edge workers, CI/CD, and infrastructure-as-code. Deploys that are boring on purpose.',
  },
  {
    title: 'Architecture & infra review',
    body: 'Pressure-test your system before you scale. A clear written assessment of risks, bottlenecks, and what to fix first.',
  },
  {
    title: 'AI agents',
    body: 'LLM-powered features and agents wired into real products — tool use, retrieval, and evaluation, not demos.',
  },
];

const packages = [
  {
    name: 'Website',
    price: 'From £500',
    unit: '4-page site',
    blurb:
      'A clean, fast, mobile-friendly website built for your business. Four pages to start, more added at a flat per-page rate.',
    features: [
      '4 pages designed and built',
      'Mobile and tablet responsive',
      'Contact form and basic SEO',
      'Deployed live on your domain',
    ],
    featured: true,
  },
  {
    name: 'Care plan',
    price: '£40',
    unit: 'per month',
    blurb:
      'Keep your site current without lifting a finger. Hosting stays healthy and your content stays up to date.',
    features: [
      'Content and copy updates',
      'Image and page swaps',
      'Security and dependency updates',
      'Uptime monitoring',
    ],
    featured: false,
  },
  {
    name: 'Custom build',
    price: "Let's talk",
    unit: 'scoped per project',
    blurb:
      'Web apps, mobile apps, APIs, or AI features. Anything beyond a brochure site is quoted to scope.',
    features: [
      'Full-stack web or mobile apps',
      'APIs and backend services',
      'Cloud architecture and DevOps',
      'AI agents and integrations',
    ],
    featured: false,
  },
];

const engagements = [
  {
    title: 'Project',
    blurb:
      'Fixed scope, scoped per project. Take a product from zero to shipped, or deliver a defined piece of work end to end.',
  },
  {
    title: 'Advisory / fractional',
    blurb:
      'Ongoing technical guidance, architecture reviews, or fractional hands-on time. Available by the day or on retainer.',
  },
  {
    title: 'Contract',
    blurb:
      'Embedded with your team for a defined period. Senior full-stack capacity across web, mobile, backend and cloud.',
  },
];

const steps = [
  {
    title: 'Scope',
    body: 'We talk through the problem, constraints, and what success looks like. You get a written proposal with scope, timeline, and price.',
  },
  {
    title: 'Build',
    body: 'Work ships in small, reviewable increments. You see progress continuously — no big-bang reveal at the end.',
  },
  {
    title: 'Hand over',
    body: 'Tested, documented deliverables you own. Optional ongoing support or advisory if you want it.',
  },
];

const LINKEDIN = 'https://linkedin.com/in/cooper-a-m/';

const navLinks = [
  { href: '#services', label: 'Services' },
  { href: '#pricing', label: 'Pricing' },
  { href: '#how', label: 'How it works' },
  { href: '/consultation/tos/', label: 'Terms' },
];
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <BaseHead
      title="Consulting — Snazzie"
      description="Full-stack software consulting and contract work across web, mobile, backend and cloud. Scoped per project, advisory, or embedded with your team."
      path="/consultation/"
    />
  </head>
  <body class="bg-background text-foreground antialiased">
    <header class="pointer-events-none fixed inset-x-0 top-0 z-50 flex justify-center pt-4 px-4">
      <nav class="pointer-events-auto flex items-center gap-1 rounded-full border border-border bg-card/80 px-2 py-1.5 backdrop-blur-md w-full max-w-2xl">
        <div class="flex items-center gap-2 px-3 text-sm font-semibold text-foreground shrink-0">
          <a href="/" aria-label="Snazzie, home" class="flex items-center gap-2">
            <span class="size-2 rounded-full bg-foreground" aria-hidden="true"></span>
            Snazzie
          </a>
        </div>
        <div class="ml-auto flex items-center gap-0.5">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="rounded-full px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-white/10 hover:text-foreground"
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </nav>
    </header>

    <main>
      <!-- Hero -->
      <section class="mx-auto max-w-3xl px-6 pb-16 pt-36 text-center">
        <p class="flex items-center justify-center gap-2 text-xs font-medium uppercase tracking-[0.28em] text-muted-foreground">
          <span class="relative flex size-2">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-75 motion-reduce:hidden"></span>
            <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
          </span>
          Available for work
        </p>
        <h1 class="mt-4 text-balance text-4xl font-bold tracking-tight sm:text-5xl">
          Full-stack consulting that ships
        </h1>
        <p class="mx-auto mt-5 max-w-xl text-balance text-lg text-muted-foreground leading-relaxed">
          One engineer across web, mobile, backend and cloud. Take a product
          from zero to shipped, or pressure-test your architecture before you
          scale. Scoped per project, advisory, or embedded with your team.
        </p>
        <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
          <a
            href={LINKEDIN}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-md border border-border bg-foreground px-5 py-2.5 text-sm font-medium text-background transition-transform hover:-translate-y-0.5"
          >
            Get in touch on LinkedIn
          </a>
          <a
            href="mailto:info@snazzie.space"
            class="inline-flex items-center gap-2 rounded-md border border-border bg-card px-5 py-2.5 text-sm font-medium text-foreground transition-colors hover:bg-white/[0.06]"
          >
            Email me
          </a>
        </div>
      </section>

      <!-- Services -->
      <section id="services" class="mx-auto max-w-5xl scroll-mt-24 px-6 py-12">
        <div class="mb-10 text-center">
          <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">What I do</h2>
          <p class="mt-3 text-muted-foreground">Full stack, end to end. One hire covers it.</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            services.map((s) => (
              <div class="rounded-2xl border border-border bg-card p-6 transition-colors hover:border-zinc-500">
                <h3 class="text-base font-semibold text-foreground">{s.title}</h3>
                <p class="mt-2 text-sm text-muted-foreground leading-relaxed">{s.body}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Pricing -->
      <section id="pricing" class="mx-auto max-w-5xl scroll-mt-24 px-6 py-12">
        <div class="mb-10 text-center">
          <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Pricing</h2>
          <p class="mt-3 text-muted-foreground">Clear starting points. No surprises.</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
          {
            packages.map((pkg) => (
              <div
                class={`flex flex-col rounded-2xl border p-6 ${
                  pkg.featured
                    ? 'border-zinc-400 bg-card ring-1 ring-white/10'
                    : 'border-border bg-card'
                }`}
              >
                <h3 class="text-lg font-semibold text-foreground">{pkg.name}</h3>
                <div class="mt-2 flex items-baseline gap-1.5">
                  <span class="text-2xl font-bold tracking-tight text-foreground">{pkg.price}</span>
                  <span class="text-sm text-muted-foreground">{pkg.unit}</span>
                </div>
                <p class="mt-3 text-sm text-muted-foreground leading-relaxed">{pkg.blurb}</p>
                <ul class="mt-4 space-y-2 border-t border-border pt-4">
                  {pkg.features.map((f) => (
                    <li class="flex items-start gap-2 text-sm text-muted-foreground">
                      <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-foreground/60" aria-hidden="true" />
                      {f}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <p class="mt-6 text-center text-xs text-muted-foreground">
          Additional pages charged at a flat per-page rate. The £40/month care plan is optional and can be cancelled anytime. Prices exclude third-party costs (domains, hosting, paid assets).
        </p>
      </section>

      <!-- Engagements -->
      <section id="engagements" class="mx-auto max-w-5xl scroll-mt-24 px-6 py-12">
        <div class="mb-10 text-center">
          <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Ways to work together</h2>
          <p class="mt-3 text-muted-foreground">Pick the shape that fits the problem.</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
          {
            engagements.map((e) => (
              <div class="rounded-2xl border border-border bg-card p-6">
                <h3 class="text-lg font-semibold text-foreground">{e.title}</h3>
                <p class="mt-2 text-sm text-muted-foreground leading-relaxed">{e.blurb}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- How it works -->
      <section id="how" class="mx-auto max-w-3xl scroll-mt-24 px-6 py-12">
        <div class="mb-10 text-center">
          <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">How it works</h2>
        </div>
        <ol class="space-y-4">
          {
            steps.map((step, i) => (
              <li class="flex gap-4 rounded-2xl border border-border bg-card p-6">
                <span class="flex size-8 shrink-0 items-center justify-center rounded-full border border-border text-sm font-semibold text-foreground">
                  {i + 1}
                </span>
                <div>
                  <h3 class="text-base font-semibold text-foreground">{step.title}</h3>
                  <p class="mt-1 text-sm text-muted-foreground leading-relaxed">{step.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- CTA -->
      <section class="mx-auto max-w-3xl px-6 py-12">
        <div class="rounded-2xl border border-border bg-card p-8 text-center sm:p-10">
          <h2 class="text-2xl font-bold tracking-tight">Got a project in mind?</h2>
          <p class="mx-auto mt-3 max-w-md text-muted-foreground leading-relaxed">
            Tell me what you are building and where it is stuck. I will come back
            with a clear scope and price.
          </p>
          <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
            <a
              href={LINKEDIN}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-md border border-border bg-foreground px-5 py-2.5 text-sm font-medium text-background transition-transform hover:-translate-y-0.5"
            >
              Get in touch on LinkedIn
            </a>
          </div>
          <p class="mt-5 text-xs text-muted-foreground">
            All consulting and contract work is subject to my{' '}
            <a
              href="/consultation/tos/"
              class="underline underline-offset-2 transition-colors hover:text-foreground"
            >
              terms of service
            </a>
            .
          </p>
        </div>
      </section>
    </main>

    <footer class="mx-auto max-w-5xl px-6 py-12">
      <div class="flex flex-col items-center justify-between gap-4 border-t border-border pt-8 text-sm text-muted-foreground sm:flex-row">
        <span>Consulting · <a href="/" class="text-foreground underline underline-offset-2 hover:opacity-80 transition-opacity">Snazzie</a></span>
        <nav class="flex items-center gap-5">
          <a href="/consultation/tos/" class="transition-colors hover:text-foreground">Terms</a>
          <a href="mailto:info@snazzie.space" class="transition-colors hover:text-foreground">Contact</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
