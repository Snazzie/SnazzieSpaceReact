---
import ConsultationLayout from '@/layouts/ConsultationLayout.astro';
import Closing from '@/components/consultation/Closing.astro';
import FindYourFit from '@/components/consultation/FindYourFit.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';

const covers = [
  'Mobile apps (iOS & Android)',
  'Web products, from scratch',
  'The backend & database behind it',
  'App-store submission & release',
  'Payments, accounts & onboarding',
  'AI features baked in where useful',
];

const steps = [
  { n: '01', title: 'Discovery call', body: 'Talk through the idea, who it’s for, and what "done" looks like.' },
  { n: '02', title: 'Scope & quote', body: 'A written breakdown of what gets built and a fixed or staged price, before any code.' },
  { n: '03', title: 'Build in the open', body: 'Regular check-ins as it comes together, not a black box until launch day.' },
  { n: '04', title: 'Launch & handover', body: 'Shipped to the store or the web, source and accounts handed to you.' },
];

const fits = [
  'A founder with an idea and no in-house engineer yet',
  'An existing business that wants an app or portal, not just a website',
  'A concept that needs a working prototype before it can be pitched or tested',
  'Someone who has been quoted by an agency and wants a second, direct opinion',
];

const faqs = [
  {
    q: 'What does it cost?',
    a: 'There is no catalogue price because apps vary too much for one. A small single-screen tool and a multi-user product with payments are both "an app" and a week apart in build time. You get a fixed or staged number after the discovery call, in writing, before anything is built.',
  },
  {
    q: 'Do I own the code and accounts?',
    a: 'Yes. App-store, hosting and service accounts are set up in your name from the start, and the source is handed over on launch. Nothing is licensed back to you or held on a platform I control.',
  },
  {
    q: 'What if the scope changes partway through?',
    a: 'Normal for a first build. Small adjustments are absorbed; anything that meaningfully grows the scope gets a written add-on quote before I build it, so the price never moves without you agreeing first.',
  },
  {
    q: 'Can you work with an idea that is not fully formed yet?',
    a: 'That is what the discovery call is for. Part of the job is turning a rough idea into a scoped, buildable plan, not just taking a finished spec and coding it.',
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Mobile app and product development',
  provider: { '@type': 'Person', name: 'Aaron (Snazzie)' },
  areaServed: 'GB',
  url: 'https://snazzie.space/consulting/services/apps/',
};

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Consulting', href: '/consulting/' },
  { name: 'Services', href: '/consulting/#snz-services' },
  { name: 'Apps' },
];
---
<ConsultationLayout
  title="Mobile App & Product Development | Snazzie"
  description="Turn an idea into a real app or product. Scoped and priced after a call, built and handed over to you outright."
  path="/consulting/services/apps/"
  schema={serviceSchema}
>
  <section class="pt-14 pb-16 px-14 border-b border-[rgba(var(--line-rgb),0.08)] max-[760px]:pt-10 max-[760px]:px-[22px]">
    <div class="max-w-[1100px] mx-auto">
      <Breadcrumbs items={crumbs} class="mb-5" />
      <a href="/consulting/#snz-services" class="inline-flex items-center mb-6 font-['JetBrains_Mono'] font-semibold text-[12px] text-[var(--ink5)] no-underline border border-[rgba(var(--line-rgb),0.2)] py-[9px] px-[14px] hover:text-[var(--ink)] hover:border-[rgba(var(--line-rgb),0.4)] transition-colors">← All services</a>
      <div class="font-['JetBrains_Mono'] font-semibold text-[11px] tracking-[0.2em] text-[var(--accent-vis)] mb-[18px]">FOUNDERS & IDEAS</div>
      <h1 class="snz-display m-0 mb-5 font-['Archivo'] font-extrabold text-[60px] leading-[0.98] tracking-[-0.035em] max-w-[720px]">Turn your idea into an app</h1>
      <p class="m-0 max-w-[560px] font-['JetBrains_Mono'] font-normal text-[15px] leading-[1.7] text-[var(--ink3)]">Mobile apps and products built from scratch, end to end. Every idea is a different shape, so this is scoped and priced with you before anything is built — not squeezed into a fixed package.</p>
      <span class="snz-magwrap inline-block mt-8"><a data-mag href="/consulting/find-your-fit/?s=apps" class="inline-block font-['JetBrains_Mono'] font-bold text-[12.5px] tracking-[0.04em] bg-[var(--accent)] text-[var(--ink)] py-[14px] px-[22px] no-underline" style="transition:transform .3s cubic-bezier(.2,.8,.2,1)">FIND YOUR FIT →</a></span>
    </div>
  </section>

  <section class="py-24 px-14 border-b border-[rgba(var(--line-rgb),0.08)] max-[760px]:py-16 max-[760px]:px-[22px]">
    <div class="max-w-[1100px] mx-auto">
      <div class="font-['JetBrains_Mono'] font-semibold text-[11px] tracking-[0.2em] text-[var(--accent-vis)] mb-[18px]">WHAT'S COVERED</div>
      <div class="grid grid-cols-3 gap-px bg-[rgba(var(--line-rgb),0.08)] border border-[rgba(var(--line-rgb),0.08)] mb-[54px] max-[900px]:grid-cols-2 max-[560px]:grid-cols-1">
        {covers.map((c, i) => (
          <div class="snz-card bg-[var(--bg0)] py-[26px] px-[24px] flex items-center gap-3">
            <span class="w-[7px] h-[7px] flex-none bg-[var(--accent)]" style="box-shadow:0 0 10px var(--accent)"></span>
            <span class="font-['Archivo'] font-bold text-[15px] tracking-[-0.01em]">{c}</span>
          </div>
        ))}
      </div>

      <div class="font-['JetBrains_Mono'] font-semibold text-[11px] tracking-[0.2em] text-[var(--accent-vis)] mb-[18px]">HOW PRICING WORKS</div>
      <div class="grid grid-cols-4 gap-6 max-[900px]:grid-cols-2 max-[560px]:grid-cols-1">
        {steps.map((s) => (
          <div class="border border-[rgba(var(--line-rgb),0.12)] p-6 bg-[var(--bg2)] flex flex-col">
            <div class="font-['JetBrains_Mono'] font-bold text-[13px] text-[var(--accent-vis)] mb-3">{s.n}</div>
            <h3 class="m-0 mb-2 font-['Archivo'] font-extrabold text-[17px] tracking-[-0.015em]">{s.title}</h3>
            <p class="m-0 font-['JetBrains_Mono'] font-normal text-[12.5px] leading-[1.6] text-[var(--ink3)]">{s.body}</p>
          </div>
        ))}
      </div>

      <div class="border border-[rgba(var(--line-rgb),0.1)] p-[22px] bg-[var(--bg0)] mt-6">
        <p class="m-0 font-['JetBrains_Mono'] font-normal text-[12px] leading-[1.6] text-[var(--ink5)]">No fixed catalogue price, because two apps called "simple" can be a week apart in build time. You get a real number once we've talked, not a guess.</p>
      </div>
    </div>
  </section>

  <!-- WHO THIS FITS -->
  <section class="py-20 px-14 border-b border-[rgba(var(--line-rgb),0.08)] max-[760px]:py-14 max-[760px]:px-[22px]">
    <div class="max-w-[1100px] mx-auto">
      <div class="font-['JetBrains_Mono'] font-semibold text-[11px] tracking-[0.2em] text-[var(--accent-vis)] mb-4">WHO THIS FITS</div>
      <h2 class="m-0 mb-11 font-['Archivo'] font-extrabold text-[38px] leading-[1.02] tracking-[-0.03em] max-[760px]:text-[28px]">Built for the early stage</h2>
      <div class="grid grid-cols-2 gap-x-14 max-[640px]:grid-cols-1">
        {fits.map((f) => (
          <div class="flex items-start gap-3 py-[13px] border-t border-[rgba(var(--line-rgb),0.08)] font-['JetBrains_Mono'] font-medium text-[14px] leading-[1.5] text-[var(--ink1)]">
            <span class="text-[var(--accent-vis)] mt-px">✓</span> {f}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 px-14 border-b border-[rgba(var(--line-rgb),0.08)] max-[760px]:py-14 max-[760px]:px-[22px]">
    <div class="max-w-[1100px] mx-auto">
      <div class="font-['JetBrains_Mono'] font-semibold text-[11px] tracking-[0.2em] text-[var(--accent-vis)] mb-4">COMMON QUESTIONS</div>
      <h2 class="m-0 mb-11 font-['Archivo'] font-extrabold text-[38px] leading-[1.02] tracking-[-0.03em] max-[760px]:text-[28px]">Before you get in touch</h2>
      <div class="border-t border-[rgba(var(--line-rgb),0.12)]">
        {faqs.map((f) => (
          <details class="group py-5 border-b border-[rgba(var(--line-rgb),0.1)]">
            <summary class="cursor-pointer list-none flex items-center justify-between gap-4 font-['Archivo'] font-bold text-[17px] tracking-[-0.01em]">
              {f.q}
              <span class="text-[var(--accent-vis)] transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 mb-0 max-w-[720px] font-['JetBrains_Mono'] font-normal text-[13.5px] leading-[1.7] text-[var(--ink3)]">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- RELATED SERVICES -->
  <section class="py-16 px-14 border-b border-[rgba(var(--line-rgb),0.08)] max-[760px]:py-12 max-[760px]:px-[22px]">
    <div class="max-w-[1100px] mx-auto">
      <div class="font-['JetBrains_Mono'] font-semibold text-[11px] tracking-[0.2em] text-[var(--accent-vis)] mb-4">OTHER SERVICES</div>
      <div class="flex gap-8 flex-wrap">
        <a href="/consulting/services/websites/" class="font-['JetBrains_Mono'] font-bold text-[13px] tracking-[0.02em] text-[var(--ink1)] no-underline border-b border-[rgba(var(--line-rgb),0.3)] pb-0.5 hover:text-[var(--accent-vis)] hover:border-[var(--accent-vis)]">Website design & build →</a>
        <a href="/consulting/services/consulting/" class="font-['JetBrains_Mono'] font-bold text-[13px] tracking-[0.02em] text-[var(--ink1)] no-underline border-b border-[rgba(var(--line-rgb),0.3)] pb-0.5 hover:text-[var(--accent-vis)] hover:border-[var(--accent-vis)]">Engineering advisory & consulting →</a>
      </div>
    </div>
  </section>

  <FindYourFit start="apps" />

  <Closing />
</ConsultationLayout>
