---
import ConsultationLayout from '@/layouts/ConsultationLayout.astro';
import Closing from '@/components/consultation/Closing.astro';

const metrics = [
  { value: '95+', label: 'FAST', tag: 'PERFORMANCE' },
  { value: '100', label: 'EASY TO USE', tag: 'ACCESSIBILITY' },
  { value: '100', label: 'FOUND ON GOOGLE', tag: 'SEO' },
];

const launchReady = [
  'Domain & DNS set up',
  'Hosting with free SSL (HTTPS)',
  'UK GDPR & cookie consent',
  'SEO from the first line of code',
  'AI-search ready (ChatGPT & co.)',
  'Analytics from day one',
  'Accessibility & speed checks',
];

const careFeatures = [
  'Web content & copy updates',
  'Analytics tracking & reporting',
  'Ongoing SEO optimisation',
  'Legal obligations upkeep (GDPR & cookie-consent)',
  'Hosting & uptime kept healthy',
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Web development',
  provider: { '@type': 'Person', name: 'Aaron (Snazzie)' },
  areaServed: 'GB',
  offers: { '@type': 'Offer', priceCurrency: 'GBP', price: '1500', priceSpecification: { '@type': 'PriceSpecification', minPrice: '1500' } },
  url: 'https://snazzie.space/consulting/services/websites/',
};
---
<ConsultationLayout
  title="Bespoke Websites From £1500 | Snazzie"
  description="Hand-built websites for small businesses, from £1500. Launch-ready, SEO-first, and yours to own outright, with optional monthly care."
  path="/consulting/services/websites/"
  schema={serviceSchema}
>
  <section class="pt-14 pb-16 px-14 border-b border-[rgba(var(--line-rgb),0.08)] max-[760px]:pt-10 max-[760px]:px-[22px]">
    <div class="max-w-[1100px] mx-auto">
      <a href="/consulting/#snz-services" class="inline-block mb-6 font-['JetBrains_Mono'] font-semibold text-[12px] text-[var(--ink5)] no-underline">← All services</a>
      <div class="font-['JetBrains_Mono'] font-semibold text-[11px] tracking-[0.2em] text-[var(--accent-vis)] mb-[18px]">SMALL BUSINESS</div>
      <h1 class="snz-display m-0 mb-5 font-['Archivo'] font-extrabold text-[60px] leading-[0.98] tracking-[-0.035em] max-w-[720px]">A website for your business</h1>
      <p class="m-0 max-w-[560px] font-['JetBrains_Mono'] font-normal text-[15px] leading-[1.7] text-[var(--ink3)]">Hand-built from a blank page, designed around your business, and yours to own outright. No page builders, no templates, no monthly platform fees.</p>
    </div>
  </section>

  <section class="py-24 px-14 border-b border-[rgba(var(--line-rgb),0.08)] max-[760px]:py-16 max-[760px]:px-[22px]">
    <div class="max-w-[1100px] mx-auto">
      <div class="grid grid-cols-[1.4fr_1fr] gap-6 max-[900px]:grid-cols-1">
        <!-- bespoke -->
        <div class="border border-[rgba(var(--line-rgb),0.12)] p-10 bg-[var(--bg2)] flex flex-col">
          <div class="flex items-baseline justify-between flex-wrap gap-2.5">
            <h2 class="m-0 font-['Archivo'] font-extrabold text-[30px] tracking-[-0.025em]">Bespoke website</h2>
            <div class="font-['Archivo'] font-bold text-[28px] text-[var(--accent-vis)]">From £1500 <span class="font-['JetBrains_Mono'] font-medium text-[12px] text-[var(--ink5)]">one-off</span></div>
          </div>
          <p class="mt-[18px] mb-7 max-w-[480px] font-['JetBrains_Mono'] font-normal text-[14px] leading-[1.65] text-[var(--ink3)]">The price is purely development — your domain and any hosting are paid separately, at cost.</p>
          <div class="grid grid-cols-3 gap-[1px] bg-[rgba(var(--line-rgb),0.1)] border border-[rgba(var(--line-rgb),0.1)] mb-7">
            {metrics.map((m) => (
              <div class="bg-[var(--bg2)] py-[18px] px-5">
                <div class="font-['Archivo'] font-extrabold text-[30px] text-[var(--accent-vis)]">{m.value}</div>
                <div class="font-['JetBrains_Mono'] font-medium text-[11px] text-[var(--ink5)] mt-1">{m.label}</div>
                <div class="font-['JetBrains_Mono'] font-normal text-[9px] tracking-[0.08em] text-[var(--ink6,var(--ink5))] opacity-60 mt-0.5">{m.tag}</div>
              </div>
            ))}
          </div>
          <span class="snz-magwrap mt-auto self-start"><a data-mag href="mailto:consulting@snazzie.space" class="inline-block font-['JetBrains_Mono'] font-bold text-[12.5px] tracking-[0.04em] bg-[var(--accent)] text-[var(--ink)] py-[14px] px-[22px] no-underline" style="transition:transform .3s cubic-bezier(.2,.8,.2,1)">START A WEBSITE →</a></span>
        </div>
        <!-- care -->
        <div class="flex flex-col gap-6">
          <div class="border border-[rgba(var(--line-rgb),0.12)] p-8 bg-[var(--bg2)] flex-1">
            <div class="flex items-baseline justify-between gap-2.5 mb-1.5">
              <h3 class="m-0 font-['Archivo'] font-bold text-[20px] tracking-[-0.01em]">Monthly care</h3>
              <span class="font-['Archivo'] font-bold text-[18px] text-[var(--ink0)]">From £40<span class="font-['JetBrains_Mono'] font-medium text-[11px] text-[var(--ink5)]">/mo</span></span>
            </div>
            <div class="font-['JetBrains_Mono'] font-medium text-[11px] text-[var(--accent-vis)] mb-[18px]">OPTIONAL · CANCEL ANYTIME</div>
            <p class="mt-0 mb-[18px] font-['JetBrains_Mono'] font-normal text-[13px] leading-[1.6] text-[var(--ink3)]">Keep the site current and growing without lifting a finger.</p>
            <div class="flex flex-col gap-[9px]">
              {careFeatures.map((f) => (
                <div class="font-['JetBrains_Mono'] font-normal text-[12.5px] text-[var(--ink1)]"><span class="text-[var(--accent-vis)]">·</span> {f}</div>
              ))}
            </div>
          </div>
          <div class="border border-[rgba(var(--line-rgb),0.1)] p-[22px] bg-[var(--bg0)]">
            <p class="m-0 font-['JetBrains_Mono'] font-normal text-[12px] leading-[1.6] text-[var(--ink5)]">Domains and hosting are paid straight to the providers — no markup, no padded packages, no fake security fees.</p>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-6 mt-6 items-stretch max-[900px]:grid-cols-1">
        <!-- worked example -->
        <div class="border border-[rgba(var(--line-rgb),0.12)] bg-[var(--bg2)] p-7 flex flex-col">
          <div class="font-['JetBrains_Mono'] font-semibold text-[11px] tracking-[.18em] text-[var(--accent-vis)] mb-3">FOR EXAMPLE</div>
          <h3 class="mt-0 mb-2 font-['Archivo'] font-extrabold text-[19px] tracking-[-0.02em]">A typical small-business site</h3>
          <p class="mt-0 mb-4 font-['JetBrains_Mono'] font-normal text-[12.5px] leading-[1.6] text-[var(--ink3)]">A five-page site: home, about, services, gallery and contact. Hand-built and honestly priced, no surprises later.</p>
          <div class="flex flex-col gap-[1px] bg-[rgba(var(--line-rgb),0.1)] border border-[rgba(var(--line-rgb),0.1)] mt-auto">
            <div class="flex items-baseline justify-between gap-3 bg-[var(--bg2)] py-[10px] px-4">
              <span class="font-['JetBrains_Mono'] text-[12px] text-[var(--ink1)]">Build</span>
              <span class="font-['Archivo'] font-bold text-[15px] text-[var(--accent-vis)]">from £1500</span>
            </div>
            <div class="flex items-baseline justify-between gap-3 bg-[var(--bg2)] py-[10px] px-4">
              <span class="font-['JetBrains_Mono'] text-[12px] text-[var(--ink1)]">Domain</span>
              <span class="font-['JetBrains_Mono'] font-medium text-[12px] text-[var(--ink3)]">~£12/yr</span>
            </div>
            <div class="flex items-baseline justify-between gap-3 bg-[var(--bg2)] py-[10px] px-4">
              <span class="font-['JetBrains_Mono'] text-[12px] text-[var(--ink1)]">Hosting</span>
              <span class="font-['JetBrains_Mono'] font-medium text-[12px] text-[var(--ink3)]">often £0</span>
            </div>
            <div class="flex items-baseline justify-between gap-3 py-[10px] px-4" style="background:linear-gradient(90deg,rgba(var(--accent-rgb),.1),var(--bg2))">
              <span class="font-['JetBrains_Mono'] font-semibold text-[11px] tracking-[.06em] text-[var(--ink0)]">YOU OWN IT</span>
              <span class="font-['JetBrains_Mono'] font-semibold text-[12px] text-[var(--accent-vis)]">outright</span>
            </div>
          </div>
        </div>

        <!-- launch-ready -->
        <div class="border border-[var(--accent)] p-7 flex flex-col" style="background:linear-gradient(90deg,rgba(var(--accent-rgb),.1),var(--bg0))">
          <h3 class="mt-0 mb-2 font-['Archivo'] font-extrabold text-[19px] tracking-[-0.02em]">Launch-ready. Nothing forgotten.</h3>
          <p class="mt-0 mb-4 font-['JetBrains_Mono'] font-normal text-[12.5px] leading-[1.6] text-[var(--ink3)]">Handled as part of every build, so you go live secure, compliant, and easy to find — on Google and in AI chats.</p>
          <div class="flex flex-col gap-[7px] mt-auto">
            {launchReady.map((f) => (
              <span class="inline-flex items-center gap-2 font-['JetBrains_Mono'] font-medium text-[12px] text-[var(--ink1)]"><span class="text-[var(--accent-vis)]">✓</span> {f}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <Closing />
</ConsultationLayout>
