---
import ConsultationLayout from '@/layouts/ConsultationLayout.astro';
import Closing from '@/components/consultation/Closing.astro';
import FindYourFit from '@/components/consultation/FindYourFit.astro';
import BuilderTradeoff from '@/components/consultation/BuilderTradeoff.astro';

const metrics = [
  { value: '95+', label: 'PERFORMANCE', tag: 'FAST' },
  { value: '100', label: 'ACCESSIBILITY', tag: 'EASY TO USE' },
  { value: '100', label: 'SEO', tag: 'GOOGLE, BING & AI CHAT' },
];

const launchReady = [
  'Domain & DNS set up',
  'Secure from the beginning: free SSL (HTTPS)',
  'UK GDPR & cookie consent',
  'Search engine optimisation from the first line of code',
  'Crawler optimisation: XML sitemap & robots.txt, submitted to search engines',
  'Google Business Profile & Maps listing',
  'AI-search ready (ChatGPT & co.)',
  'Analytics from day one',
  'Accessibility & speed checks',
  'Business email set up (you@yourbusiness.co.uk)',
  'Documentation: the tools and platforms used, and how to edit it yourself',
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Web development',
  provider: { '@type': 'Person', name: 'Aaron (Snazzie)' },
  areaServed: 'GB',
  offers: { '@type': 'Offer', priceCurrency: 'GBP', price: '1500', priceSpecification: { '@type': 'PriceSpecification', minPrice: '1500' } },
  url: 'https://snazzie.space/consulting/services/websites/',
};
---
<ConsultationLayout
  title="Get Your Business Found Online From £1500 | Snazzie"
  description="Website, SEO and Google Maps for small businesses, from £1500. Your whole online presence built and optimised so customers find you, and yours to own outright."
  path="/consulting/services/websites/"
  schema={serviceSchema}
>
  <!-- HERO -->
  <section class="pt-14 pb-14 px-14 border-b border-[rgba(var(--line-rgb),0.08)] max-[760px]:pt-10 max-[760px]:px-[22px]">
    <div class="max-w-[1100px] mx-auto">
      <a href="/consulting/#snz-services" class="inline-block mb-6 font-['JetBrains_Mono'] font-semibold text-[12px] text-[var(--ink5)] no-underline">← All services</a>
      <div class="font-['JetBrains_Mono'] font-semibold text-[11px] tracking-[0.2em] text-[var(--accent-vis)] mb-[18px]">SMALL BUSINESS</div>
      <h1 class="snz-display m-0 mb-5 font-['Archivo'] font-extrabold text-[64px] leading-[0.96] tracking-[-0.035em] max-w-[760px] max-[760px]:text-[42px]">Get your business found online</h1>
      <p class="m-0 max-w-[600px] font-['JetBrains_Mono'] font-normal text-[15px] leading-[1.7] text-[var(--ink3)]">Website, SEO and Google Maps in one package: your whole online presence hand-built and optimised so customers find you, and yours to own outright. No page builders, no templates: just clean, fast code built around your business.</p>

      <!-- trust stats -->
      <div class="mt-11 flex flex-wrap gap-x-14 gap-y-6">
        {metrics.map((m) => (
          <div>
            <div class="font-['Archivo'] font-extrabold text-[40px] leading-none text-[var(--accent-vis)] tracking-[-0.03em]">{m.value}</div>
            <div class="font-['JetBrains_Mono'] font-semibold text-[11px] tracking-[.06em] text-[var(--ink1)] mt-2">{m.label}</div>
            <div class="font-['JetBrains_Mono'] font-normal text-[10px] tracking-[0.1em] text-[var(--ink5)] mt-0.5">{m.tag}</div>
          </div>
        ))}
      </div>
      <div class="mt-4 font-['JetBrains_Mono'] font-normal text-[10px] tracking-[0.1em] text-[var(--ink5)]">MEASURED ON GOOGLE LIGHTHOUSE</div>

      <!-- hero CTA -->
      <div class="mt-10 flex items-center gap-6 flex-wrap">
        <span class="snz-magwrap"><a data-mag href="/consulting/find-your-fit/?s=websites" class="inline-block font-['JetBrains_Mono'] font-bold text-[12.5px] tracking-[0.04em] bg-[var(--accent)] text-[var(--ink)] py-[14px] px-[22px] no-underline" style="transition:transform .3s cubic-bezier(.2,.8,.2,1)">FIND YOUR FIT →</a></span>
        <span class="font-['JetBrains_Mono'] font-normal text-[12.5px] text-[var(--ink5)]">From £1500, one-off. Yours to own outright.</span>
      </div>
    </div>
  </section>

  <!-- WHAT'S INCLUDED -->
  <section class="py-20 px-14 border-b border-[rgba(var(--line-rgb),0.08)] max-[760px]:py-14 max-[760px]:px-[22px]">
    <div class="max-w-[1100px] mx-auto">
      <div class="font-['JetBrains_Mono'] font-semibold text-[11px] tracking-[0.2em] text-[var(--accent-vis)] mb-4">WHAT'S INCLUDED</div>
      <h2 class="m-0 mb-4 font-['Archivo'] font-extrabold text-[38px] leading-[1.02] tracking-[-0.03em] max-[760px]:text-[28px]">Launch-ready. Nothing forgotten.</h2>
      <p class="m-0 mb-11 max-w-[600px] font-['JetBrains_Mono'] font-normal text-[14px] leading-[1.7] text-[var(--ink3)]">Handled as part of every build, so you go live secure, compliant, and easy to find: on Google, Google Maps, and in AI chats.</p>
      <div class="grid grid-cols-2 gap-x-14 max-[640px]:grid-cols-1">
        {launchReady.map((f) => (
          <div class="flex items-start gap-3 py-[13px] border-t border-[rgba(var(--line-rgb),0.08)] font-['JetBrains_Mono'] font-medium text-[14px] leading-[1.5] text-[var(--ink1)]">
            <span class="text-[var(--accent-vis)] mt-px">✓</span> {f}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- STATIC OR DYNAMIC: product education, self-select before price -->
  <section class="py-20 px-14 border-b border-[rgba(var(--line-rgb),0.08)] max-[760px]:py-14 max-[760px]:px-[22px]">
    <div class="max-w-[1100px] mx-auto">
      <div class="font-['JetBrains_Mono'] font-semibold text-[11px] tracking-[0.2em] text-[var(--accent-vis)] mb-4">WHICH ONE DO YOU NEED?</div>
      <h2 class="m-0 mb-4 font-['Archivo'] font-extrabold text-[38px] leading-[1.02] tracking-[-0.03em] max-[760px]:text-[28px]">Static or dynamic</h2>
      <p class="m-0 mb-11 max-w-[600px] font-['JetBrains_Mono'] font-normal text-[14px] leading-[1.7] text-[var(--ink3)]">The difference is how your content changes: updated live by you, or updated through development. That decides your build price and hosting cost.</p>
      <div class="grid grid-cols-2 border-t border-[rgba(var(--line-rgb),0.12)] max-[760px]:grid-cols-1">
        <div class="py-8 pr-12 border-r border-[rgba(var(--line-rgb),0.12)] max-[760px]:pr-0 max-[760px]:border-r-0">
          <h3 class="m-0 mb-2 font-['Archivo'] font-extrabold text-[22px] tracking-[-0.02em]">Static website</h3>
          <p class="mt-0 mb-4 font-['JetBrains_Mono'] font-normal text-[13px] leading-[1.65] text-[var(--ink3)]">Content updates through development: when it changes, I update it.</p>
          <ul class="list-none m-0 mb-5 p-0 flex flex-col gap-[8px]">
            {[
              'Fast, lightweight pages that show your business off',
              'Hosted free, always',
              'What most businesses need',
            ].map((f) => (
              <li class="flex items-start gap-3 font-['JetBrains_Mono'] font-normal text-[12.5px] leading-[1.5] text-[var(--ink1)]"><span class="text-[var(--accent-vis)] mt-px">✓</span> {f}</li>
            ))}
          </ul>
          <div class="flex gap-8">
            <div>
              <div class="font-['JetBrains_Mono'] text-[11px] tracking-[.06em] text-[var(--ink5)] mb-1">BUILD</div>
              <div class="font-['Archivo'] font-bold text-[19px] text-[var(--accent-vis)]">from £1500</div>
            </div>
            <div class="border-l border-[rgba(var(--line-rgb),0.12)] pl-8">
              <div class="font-['JetBrains_Mono'] text-[11px] tracking-[.06em] text-[var(--ink5)] mb-1">HOSTING</div>
              <div class="font-['Archivo'] font-bold text-[19px] text-[var(--accent-vis)]">always free</div>
            </div>
          </div>
        </div>
        <div class="py-8 pl-12 max-[760px]:pl-0 max-[760px]:border-t max-[760px]:border-[rgba(var(--line-rgb),0.12)]">
          <h3 class="m-0 mb-2 font-['Archivo'] font-extrabold text-[22px] tracking-[-0.02em]">Dynamic website</h3>
          <p class="mt-0 mb-4 font-['JetBrains_Mono'] font-normal text-[13px] leading-[1.65] text-[var(--ink3)]">Content updates live: I design the site, you edit the content.</p>
          <ul class="list-none m-0 mb-5 p-0 flex flex-col gap-[8px]">
            {[
              'Edit text and images yourself; layout stays as designed',
              'Logins, bookings and databases, if you need them',
              'Built on what your site actually has to do',
            ].map((f) => (
              <li class="flex items-start gap-3 font-['JetBrains_Mono'] font-normal text-[12.5px] leading-[1.5] text-[var(--ink1)]"><span class="text-[var(--accent-vis)] mt-px">✓</span> {f}</li>
            ))}
          </ul>
          <div class="flex gap-8">
            <div>
              <div class="font-['JetBrains_Mono'] text-[11px] tracking-[.06em] text-[var(--ink5)] mb-1">BUILD</div>
              <div class="font-['Archivo'] font-bold text-[19px] text-[var(--accent-vis)]">from £2500</div>
            </div>
            <div class="border-l border-[rgba(var(--line-rgb),0.12)] pl-8">
              <div class="font-['JetBrains_Mono'] text-[11px] tracking-[.06em] text-[var(--ink5)] mb-1">HOSTING</div>
              <div class="font-['Archivo'] font-bold text-[19px] text-[var(--accent-vis)]">from £0</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BUILDER VS CUSTOM -->
  <section class="py-20 px-14 border-b border-[rgba(var(--line-rgb),0.08)] max-[760px]:py-14 max-[760px]:px-[22px]">
    <div class="max-w-[1100px] mx-auto">
      <div class="font-['JetBrains_Mono'] font-semibold text-[11px] tracking-[0.2em] text-[var(--accent-vis)] mb-4">BUILDER OR BUILT FROM SCRATCH</div>
      <h2 class="m-0 mb-4 font-['Archivo'] font-extrabold text-[38px] leading-[1.02] tracking-[-0.03em] max-[760px]:text-[28px]">Why not just use a website builder?</h2>
      <p class="m-0 mb-11 max-w-[600px] font-['JetBrains_Mono'] font-normal text-[14px] leading-[1.7] text-[var(--ink3)]">Builders are quick and fully in your hands. The trade is what you give up on speed, search and ownership.</p>
      <BuilderTradeoff />
    </div>
  </section>

  <!-- SPEED CHECK: compare a competitor's real Lighthouse score -->
  <section class="py-20 px-14 border-b border-[rgba(var(--line-rgb),0.08)] max-[760px]:py-14 max-[760px]:px-[22px]" style="background:linear-gradient(90deg,rgba(var(--accent-rgb),.08),var(--bg0))">
    <div class="max-w-[1100px] mx-auto">
      <div class="font-['JetBrains_Mono'] font-semibold text-[11px] tracking-[0.2em] text-[var(--accent-vis)] mb-4">SEE FOR YOURSELF</div>
      <h2 class="m-0 mb-4 font-['Archivo'] font-extrabold text-[38px] leading-[1.02] tracking-[-0.03em] max-[760px]:text-[28px]">Check a rival's site speed</h2>
      <p class="m-0 mb-8 max-w-[620px] font-['JetBrains_Mono'] font-normal text-[14px] leading-[1.7] text-[var(--ink3)]">My builds score 95+ on Google's own test. Paste a competitor's site, or your current one, and run it through Google PageSpeed Insights. Most builder and WordPress sites come back slow.</p>
      <form id="snz-psi" class="flex gap-3 max-w-[620px] flex-wrap max-[520px]:flex-col">
        <input id="snz-psi-url" type="text" inputmode="url" autocomplete="off" placeholder="competitor.co.uk" class="flex-1 min-w-[220px] font-['JetBrains_Mono'] text-[14px] text-[var(--ink0)] bg-[var(--bg1)] border border-[rgba(var(--line-rgb),0.14)] py-[13px] px-4 outline-none focus:border-[var(--accent)]" />
        <button type="submit" class="snz-magwrap font-['JetBrains_Mono'] font-bold text-[12.5px] tracking-[0.04em] bg-[var(--accent)] text-[var(--ink)] py-[13px] px-[22px] border-0 cursor-pointer whitespace-nowrap">CHECK THEIR SCORE →</button>
      </form>
      <p class="mt-4 font-['JetBrains_Mono'] font-normal text-[11.5px] text-[var(--ink5)]">Opens Google PageSpeed Insights in a new tab. Independent, and nothing to do with me.</p>
    </div>
  </section>
  <script is:inline>
    (() => {
      const form = document.getElementById('snz-psi');
      if (!form) return;
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        let v = document.getElementById('snz-psi-url').value.trim();
        if (!v) return;
        if (!/^https?:\/\//i.test(v)) v = 'https://' + v;
        window.open('https://pagespeed.web.dev/analysis?url=' + encodeURIComponent(v), '_blank', 'noopener');
      });
    })();
  </script>

  <!-- WHAT HOSTING USUALLY COSTS: why free static hosting matters -->
  <section class="py-20 px-14 border-b border-[rgba(var(--line-rgb),0.08)] max-[760px]:py-14 max-[760px]:px-[22px]">
    <div class="max-w-[1100px] mx-auto">
      <div class="font-['JetBrains_Mono'] font-semibold text-[11px] tracking-[0.2em] text-[var(--accent-vis)] mb-4">WHAT HOSTING USUALLY COSTS</div>
      <h2 class="m-0 mb-4 font-['Archivo'] font-extrabold text-[38px] leading-[1.02] tracking-[-0.03em] max-[760px]:text-[28px]">Builders keep charging. I don't.</h2>
      <p class="m-0 mb-8 max-w-[600px] font-['JetBrains_Mono'] font-normal text-[14px] leading-[1.7] text-[var(--ink3)]">WordPress and builder sites keep charging every month, for as long as the site is live. A static site from me is hosted free, so that column stays at zero.</p>
      <div class="overflow-x-auto border border-[rgba(var(--line-rgb),0.12)]">
        <table class="w-full border-collapse font-['JetBrains_Mono'] text-[13px] min-w-[460px]">
          <thead>
            <tr class="text-left text-[var(--ink5)]">
              <th class="font-medium text-[11px] tracking-[.06em] py-3 px-5 border-b border-[rgba(var(--line-rgb),0.12)]">PLATFORM</th>
              <th class="font-medium text-[11px] tracking-[.06em] py-3 px-5 border-b border-l border-[rgba(var(--line-rgb),0.1)]">TYPICAL / MONTH</th>
              <th class="font-medium text-[11px] tracking-[.06em] py-3 px-5 border-b border-l border-[rgba(var(--line-rgb),0.1)]">OVER 3 YEARS</th>
            </tr>
          </thead>
          <tbody>
            {[
              { p: 'Managed WordPress (WP Engine & co.)', mo: '£20 to £25', yr: '~£800' },
              { p: 'Shared WordPress host (at renewal)', mo: '£10 to £15', yr: '~£450' },
              { p: 'Wix Premium', mo: '£10 to £22', yr: '~£580' },
              { p: 'Squarespace', mo: '£12 to £30', yr: '~£750' },
            ].map((r) => (
              <tr class="text-[var(--ink2)]">
                <td class="py-3 px-5 border-b border-[rgba(var(--line-rgb),0.08)]">{r.p}</td>
                <td class="py-3 px-5 border-b border-l border-[rgba(var(--line-rgb),0.08)] text-[var(--ink0)] font-medium">{r.mo}</td>
                <td class="py-3 px-5 border-b border-l border-[rgba(var(--line-rgb),0.08)] text-[var(--ink0)] font-medium">{r.yr}</td>
              </tr>
            ))}
            <tr style="background:linear-gradient(90deg,rgba(var(--accent-rgb),.12),var(--bg0))">
              <td class="py-3 px-5 font-['Archivo'] font-extrabold text-[14px] text-[var(--ink0)]">Static site from me</td>
              <td class="py-3 px-5 border-l border-[rgba(var(--line-rgb),0.1)] font-['Archivo'] font-bold text-[var(--accent-vis)]">£0</td>
              <td class="py-3 px-5 border-l border-[rgba(var(--line-rgb),0.1)] font-['Archivo'] font-bold text-[var(--accent-vis)]">£0</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mt-4 font-['JetBrains_Mono'] font-normal text-[11.5px] leading-[1.6] text-[var(--ink5)]">Typical figures, for comparison. Most hosts advertise a low intro rate, then renew higher, so the real cost is what you pay year after year.</p>
      <p class="mt-2 font-['JetBrains_Mono'] font-normal text-[11.5px] leading-[1.6] text-[var(--ink5)]">Many also mark up your domain: cheap the first year, then renewed well above cost. Yours is registered in your own account at the going rate, around £12 a year, with no markup from me.</p>
    </div>
  </section>

  <!-- NO MONTHLY MAINTENANCE FEE: why it's unnecessary -->
  <section class="py-20 px-14 border-b border-[rgba(var(--line-rgb),0.08)] max-[760px]:py-14 max-[760px]:px-[22px]">
    <div class="max-w-[1100px] mx-auto">
      <div class="font-['JetBrains_Mono'] font-semibold text-[11px] tracking-[0.2em] text-[var(--accent-vis)] mb-4">NO MONTHLY MAINTENANCE FEE</div>
      <h2 class="m-0 mb-4 font-['Archivo'] font-extrabold text-[38px] leading-[1.02] tracking-[-0.03em] max-[760px]:text-[28px]">Why you don't pay me every month</h2>
      <p class="m-0 mb-11 max-w-[640px] font-['JetBrains_Mono'] font-normal text-[14px] leading-[1.7] text-[var(--ink3)]">Most agencies bill a monthly maintenance fee. On a site built like this, there is simply nothing for it to cover, so I don't charge one. A small-business site rarely changes month to month, so paying only when you actually need something works out cheaper than a standing fee for work that mostly isn't happening.</p>
      <div class="grid grid-cols-3 gap-x-12 border-t border-[rgba(var(--line-rgb),0.12)] max-[760px]:grid-cols-1">
        <div class="py-6 border-r border-[rgba(var(--line-rgb),0.12)] pr-10 max-[760px]:border-r-0 max-[760px]:pr-0">
          <h3 class="m-0 mb-2 font-['Archivo'] font-extrabold text-[17px] tracking-[-0.01em]">Nothing to keep updating</h3>
          <p class="m-0 font-['JetBrains_Mono'] font-normal text-[13px] leading-[1.65] text-[var(--ink3)]">No bloated plugins, no CMS to patch every month. Hand-built code has no moving parts sitting there waiting to break, so there is no update treadmill to bill you for.</p>
        </div>
        <div class="py-6 border-r border-[rgba(var(--line-rgb),0.12)] px-10 max-[760px]:border-r-0 max-[760px]:px-0 max-[760px]:border-t max-[760px]:border-[rgba(var(--line-rgb),0.12)]">
          <h3 class="m-0 mb-2 font-['Archivo'] font-extrabold text-[17px] tracking-[-0.01em]">Secure from the get-go</h3>
          <p class="m-0 font-['JetBrains_Mono'] font-normal text-[13px] leading-[1.65] text-[var(--ink3)]">HTTPS from day one and almost no attack surface: no login, no plugin, no database to break into. Security you would normally pay a monthly plan for is just how it's built.</p>
        </div>
        <div class="py-6 pl-10 max-[760px]:pl-0 max-[760px]:border-t max-[760px]:border-[rgba(var(--line-rgb),0.12)]">
          <h3 class="m-0 mb-2 font-['Archivo'] font-extrabold text-[17px] tracking-[-0.01em]">No manufactured upsell</h3>
          <p class="m-0 font-['JetBrains_Mono'] font-normal text-[13px] leading-[1.65] text-[var(--ink3)]">A maintenance retainer exists to create recurring revenue, not because your site needs it. You pay only when you actually want something changed, and nothing the rest of the time.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section class="py-20 px-14 border-b border-[rgba(var(--line-rgb),0.08)] max-[760px]:py-14 max-[760px]:px-[22px]">
    <div class="max-w-[1100px] mx-auto">
      <div class="font-['JetBrains_Mono'] font-semibold text-[11px] tracking-[0.2em] text-[var(--accent-vis)] mb-4">PRICING</div>
      <h2 class="m-0 mb-11 font-['Archivo'] font-extrabold text-[38px] leading-[1.02] tracking-[-0.03em] max-[760px]:text-[28px]">Simple, honest pricing</h2>

      <div class="grid grid-cols-2 border-t border-[rgba(var(--line-rgb),0.12)] max-[760px]:grid-cols-1">
        <!-- bespoke plan -->
        <div class="py-9 pr-12 border-r border-[rgba(var(--line-rgb),0.12)] flex flex-col max-[760px]:pr-0 max-[760px]:border-r-0">
          <h3 class="m-0 font-['Archivo'] font-extrabold text-[24px] tracking-[-0.02em]">Bespoke website</h3>
          <div class="mt-4 mb-1 font-['Archivo'] font-bold text-[40px] text-[var(--accent-vis)] tracking-[-0.03em]">From £1500 <span class="font-['JetBrains_Mono'] font-medium text-[13px] text-[var(--ink5)]">one-off</span></div>
          <p class="mt-4 mb-4 max-w-[440px] font-['JetBrains_Mono'] font-normal text-[13.5px] leading-[1.7] text-[var(--ink3)]">Purely development: hand-built from a blank page, designed around your business.</p>
          <ul class="list-none m-0 mb-7 p-0 max-w-[440px] flex flex-col gap-[9px]">
            {[
              'Up to six pages included, then £200 per additional page',
              'Up to five rounds of design changes until you love it',
              'Domain and hosting paid separately, at cost',
            ].map((f) => (
              <li class="flex items-start gap-3 font-['JetBrains_Mono'] font-normal text-[13px] leading-[1.5] text-[var(--ink1)]"><span class="text-[var(--accent-vis)] mt-px">✓</span> {f}</li>
            ))}
          </ul>
          <span class="snz-magwrap mt-auto self-start"><a data-mag href="/consulting/find-your-fit/?s=websites" class="inline-block font-['JetBrains_Mono'] font-bold text-[12.5px] tracking-[0.04em] bg-[var(--accent)] text-[var(--ink)] py-[14px] px-[22px] no-underline" style="transition:transform .3s cubic-bezier(.2,.8,.2,1)">FIND YOUR FIT →</a></span>
        </div>
        <!-- pay-as-you-go changes -->
        <div class="py-9 pl-12 flex flex-col max-[760px]:pl-0 max-[760px]:border-t max-[760px]:border-[rgba(var(--line-rgb),0.12)]">
          <div class="flex items-baseline justify-between gap-3">
            <h3 class="m-0 font-['Archivo'] font-extrabold text-[24px] tracking-[-0.02em]">Changes when you need them</h3>
            <span class="font-['JetBrains_Mono'] font-medium text-[10px] tracking-[.1em] text-[var(--accent-vis)]">PAY AS YOU GO</span>
          </div>
          <div class="mt-4 mb-1 font-['Archivo'] font-bold text-[40px] text-[var(--accent-vis)] tracking-[-0.03em]">From £20 <span class="font-['JetBrains_Mono'] font-medium text-[13px] text-[var(--ink5)]">per change</span></div>
          <p class="mt-4 mb-5 max-w-[440px] font-['JetBrains_Mono'] font-normal text-[13.5px] leading-[1.7] text-[var(--ink3)]">No monthly fees. You only pay when you want something changed, priced by how big the job is. The rest of the time the site just runs, hosted free, nothing to pay.</p>
          <div class="border-t border-[rgba(var(--line-rgb),0.12)]">
            {[
              { t: 'Simple content change', p: '£20' },
              { t: 'SEO optimisation revisit', p: 'from £100' },
              { t: 'Large page or redesign', p: 'from £200 per page' },
            ].map((c) => (
