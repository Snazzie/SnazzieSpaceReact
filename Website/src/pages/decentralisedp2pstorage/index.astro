				</div>
			</div>
		</div>
	</section>

	<section class="border-b border-hair">
		<div class={`${wrap} grid grid-cols-2 sm:grid-cols-4`}>
			<div class="py-7.5 px-6.5 border-r border-hair">
				<div class="font-mono text-3xl font-bold text-signal leading-none">1 KiB</div>
				<div class="font-mono text-[11px] uppercase tracking-wide text-muted mt-2">Merkle proof leaf</div>
			</div>
			<div class="py-7.5 px-6.5 border-r border-hair">
				<div class="font-mono text-3xl font-bold text-slash leading-none">2.0×</div>
				<div class="font-mono text-[11px] uppercase tracking-wide text-muted mt-2">max slashing multiplier</div>
			</div>
