---
import Layout from "../../layouts/DecentralisedP2PLayout.astro";
import FeeSankey from "../../components/decentralisedp2pstorage/FeeSankey.tsx";

// Provider asks (supply): min price to store a shard. Ascending.
const asks = [
	{ price: 42, qty: 6, rep: "A" },
	{ price: 48, qty: 9, rep: "A" },
	{ price: 55, qty: 14, rep: "B" },
	{ price: 63, qty: 11, rep: "B" },
	{ price: 70, qty: 7, rep: "C" },
];
// Client bids (demand): max price willing to pay. Descending.
const bids = [
	{ price: 60, qty: 12 },
	{ price: 55, qty: 10 },
	{ price: 50, qty: 8 },
	{ price: 44, qty: 15 },
	{ price: 38, qty: 5 },
];
const maxQty = Math.max(...asks.map((a) => a.qty), ...bids.map((b) => b.qty));
const clearing = 55; // where top bid meets cheapest acceptable ask

// Provider scoring — mirrors keeper/matcher.go penaltyBPFromStats (basis points, integer).
const ratioBP = (good, bad) => (good + bad === 0 ? 10000 : Math.round((good * 10000) / (good + bad)));
function scoreProvider(p) {
	const deal = ratioBP(p.completed, p.slashed);
	const proof = ratioBP(p.pass, p.fail);
	const hasAudit = p.aOk + p.aFail > 0;
	const audit = hasAudit ? ratioBP(p.aOk, p.aFail) : null;
	const parts = hasAudit ? [deal, proof, audit] : [deal, proof];
	const reputationBP = Math.round(parts.reduce((a, b) => a + b, 0) / parts.length);
	const penaltyBP = 20000 - reputationBP; // 10000..20000
	const multiplier = penaltyBP / 10000; // 1.0x .. 2.0x
	const effective = Math.round(p.ask * multiplier);
	return { ...p, deal, proof, audit, reputationBP, penaltyBP, multiplier, effective };
}
const providers = [
	{ name: "alpha", completed: 48, slashed: 0, pass: 120, fail: 0, aOk: 30, aFail: 0, ask: 52 },
	{ name: "bravo", completed: 40, slashed: 2, pass: 90, fail: 6, aOk: 20, aFail: 1, ask: 48 },
	{ name: "charlie", completed: 20, slashed: 8, pass: 40, fail: 15, aOk: 0, aFail: 0, ask: 42 },
	{ name: "delta", completed: 5, slashed: 12, pass: 10, fail: 25, aOk: 2, aFail: 9, ask: 40 },
].map(scoreProvider).sort((a, b) => a.effective - b.effective);
const tier = (bp) => (bp >= 9500 ? "ok" : bp >= 8000 ? "mid" : "bad");
const tierBorder = { ok: "border-verify", mid: "border-warn", bad: "border-slash" };
const tierFill = { ok: "bg-verify", mid: "bg-warn", bad: "bg-slash" };
const tierMult = { ok: "text-verify bg-verify-soft", mid: "text-warn bg-warn-soft", bad: "text-slash bg-slash-soft" };

const idx = (n) => String(n).padStart(2, "0");

const plainIcons = [
	// Upload — file
	'<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4"/>',
	// Split — shredded strips
	'<rect x="5" y="3" width="14" height="7" rx="1"/><path d="M7 13v7M10 13v7M13 13v7M16 13v7"/>',
	// Match — scattered nodes
	'<circle cx="12" cy="12" r="2.3" fill="currentColor" stroke="none"/><circle cx="5" cy="5" r="1.9"/><circle cx="19" cy="5" r="1.9"/><circle cx="5" cy="19" r="1.9"/><circle cx="19" cy="19" r="1.9"/><path d="M10.4 10.4 6.4 6.4M13.6 10.4l4-4M10.4 13.6l-4 4M13.6 13.6l4 4"/>',
	// Prove — shield check
	'<path d="M12 3l7 3v5c0 4.6-3.1 7.8-7 9-3.9-1.2-7-4.4-7-9V6z"/><path d="M8.7 12l2.3 2.3 4.3-4.6"/>',
	// Slash — stacked deposit
	'<ellipse cx="12" cy="6.5" rx="7" ry="2.6"/><path d="M5 6.5v5c0 1.4 3.1 2.6 7 2.6s7-1.2 7-2.6v-5"/><path d="M5 11.5v5c0 1.4 3.1 2.6 7 2.6s7-1.2 7-2.6v-5"/>',
	// Retrieve — file check
	'<path d="M6 3h8l4 4v14H6z"/><path d="M8.7 13.5l2.3 2.3 4.3-4.6"/>',
];
const plain = [
	{ tag: "Upload", t: "You have a file", d: "A photo, a backup, anything — stored somewhere that won't lose it or read it." },
	{ tag: "Split", t: "It gets shredded", d: "Chopped into pieces and copied — like shredding a letter and photocopying each strip." },
	{ tag: "Match", t: "Pieces spread out", d: "Each piece goes to a different stranger's computer. No one holds the whole thing." },
	{ tag: "Prove", t: "They must prove it", d: "The network quizzes each host: prove you still hold piece #4 — or get fined." },
	{ tag: "Slash", t: "Money keeps them honest", d: "Hosts post a deposit to join. Lose data or lie, and it's taken away automatically." },
	{ tag: "Retrieve", t: "You get it back, whole", d: "Enough copies survive to rebuild your file — checked to be byte-identical." },
].map((x, i) => ({ ...x, icon: plainIcons[i], ok: i >= 3 }));

const payouts = [
	{ t: "Provider", d: "The bulk — streamed as they keep proving they hold your data. Their pay for the service.", tag: "≈97.5% + collateral back", tone: "verify" },
	{ t: "Keeper / protocol", d: "A small cut funds the matcher and auditor — the machinery that pairs deals and catches cheaters.", tag: "capped fee (≤10%), on by default", tone: "warn" },
	{ t: "The chain", d: "Tiny gas fee per transaction, paid to whoever runs the blockchain. Standard, unavoidable, external.", tag: "network gas", tone: "hair" },
];

const economicsNotes = [
	{ t: "Cheaters pay you", d: "If a provider loses your data, their collateral for that deal is handed straight to you — not the protocol. You're compensated, automatically." },
	{ t: "No skimming on failure", d: "The keeper's cut only applies to completed deals. A failed deal refunds the client in full — the protocol earns nothing from your loss." },
	{ t: "Every token accounted for", d: "The contract can't mint or hide funds. What you pay in always equals provider + fee + collateral out — provable on-chain." },
];

const contractNotes = [
	{ t: "No counterparty risk", d: "Payment sits escrowed in the contract, not with the client or a middleman. It only moves per rules anyone can read in advance — nobody can freeze it, spend it, or quietly change the terms." },
	{ t: "Enforcement is automatic", d: "Slashing, refunds and payouts fire the instant a proof fails or a deal completes. No support ticket, no arbitrator, no waiting on a company's goodwill." },
	{ t: "Every rule is public", d: "The contract code and every past deal, payment and slash are on-chain and auditable by anyone — not a private ledger you have to take on faith." },
];

const marketNotes = [
	{ t: "No admin price", d: "There is no oracle or operator setting rates. Price emerges from what providers offer and clients accept." },
	{ t: "Reputation tilts the book", d: "Asks are ranked by an effective price — a weak proof/completion record ranks a provider as if pricier, so reliability wins deals." },
	{ t: "Match = a deal", d: "When a bid covers the cheapest eligible ask, the keeper pairs them by price-time priority and opens the on-chain deal." },
];

const scoringNotes = [
	{ t: "New providers aren't punished", d: "No history scores neutral (1.0×) — a clean slate, not a penalty. Honest veterans still outrank them once they build a record." },
	{ t: "Audits fold in when earned", d: "Retrieval-audit reliability only counts once a provider has real audit history, so an absent signal never helps or hurts." },
	{ t: "Slashing scars the score", d: "A failed proof or timeout burns stake and drops deal/proof ratios — raising the price multiplier on every future bid." },
];

const slaNotes = [
	{ t: "Judged against your own commitment", d: "A provider commits to a minimum uptime and is scored against that number, not a universal 100% — realistic for home hardware, priced accordingly." },
	{ t: "Provable, not just voted", d: "Every challenge leaves an on-chain artifact: a valid proof, or its absence. A member who reports 'miss' against a proof that's on-chain is provably lying — discarded, and their own stake is at risk." },
	{ t: "Slash pays the people watching", d: "A breach slashes collateral proportional to the shortfall. Most goes to the wronged client, a cut funds the protocol, and a bounty pays the keepers who caught it — policing your peers is worth something." },
];

const tech = [
	{ t: "Solidity smart contracts", d: "PaymentToken, StorageMarket order book, DealManager lifecycle, ProofVerifier and ReputationRegistry run on-chain. The chain is the source of truth for deals, payments, and slashing." },
	{ t: "Embedded IPFS (boxo / bitswap)", d: "Each actor runs an in-process bitswap node — no DHT. Shards move directly between clients and providers over content-addressed transfers." },
	{ t: "Merkle challenge–response proofs", d: "Files are chunked at 1 KiB; each leaf is keccak256(index || chunk). Providers prove they still hold a shard by answering random Merkle challenges, or get slashed." },
	{ t: "Erasure-coded shards + anti-affinity", d: "A file splits into S shards × R copies — you choose S and R to dial durability up or down. On-chain anti-affinity spreads pieces across distinct providers so no single node can hold a whole stripe." },
	{ t: "Go off-chain stack", d: "Clients, providers, and keepers are Go daemons. A keeper matches bids to asks by price + reputation and audits providers with challenges and timeouts." },
	{ t: "Provider staking + slashing", d: "Providers stake to participate. Failed proofs (SlashedFailedProof) or missed deadlines (SlashedTimeout) burn stake and drop reputation — cheating costs money." },
];

const features = [
	{ t: "Trustless by proof", d: "You never trust a provider's word. Every stored shard is provably held or the provider is slashed on-chain." },
	{ t: "Survives cheaters", d: "Retrieval reconstructs the file from surviving honest copies and verifies it byte-for-byte, even when nodes go offline or corrupt data." },
	{ t: "Reputation-ranked matching", d: "The keeper ranks bids by price and reputation, so reliable providers win more deals over time." },
	{ t: "Real cross-node demo", d: "make demo spins up a 9-node market (7 honest + 2 cheaters) in containers with real cross-container bitswap." },
	{ t: "One-command local run", d: "make demo-local runs the whole 20-provider market as goroutines in a single process — no Docker needed." },
	{ t: "Live distribution view", d: "A React UI shows shards distribute, cheaters turn red, and balances + reputation update in real time." },
];

const useCases = [
	{ t: "Censorship-resistant storage", d: "No central operator can pull your data. Content lives across independent, economically-bonded providers." },
	{ t: "Verifiable archival", d: "Prove data is still held over time via periodic Merkle challenges — useful for compliance and long-term backups." },
	{ t: "Storage marketplaces", d: "A working reference for a token-priced order book where supply and demand for storage meet on-chain." },
	{ t: "Research + teaching", d: "A minimal, readable end-to-end model of proofs-of-storage, slashing, and erasure coding to learn or build from." },
];

const shareSteps = [
	{ t: "Encrypted in your browser", d: "The file is sealed with a key generated on your device (AES-GCM). The key is never uploaded — providers and gateways only ever hold ciphertext." },
	{ t: "A pointer, not a payload", d: "The link names the manifest, not the file. The recipient resolves it to a shard map, pulls the encrypted pieces peer-to-peer, and rebuilds locally." },
	{ t: "Verified before it opens", d: "The manifest carries the Merkle root. Every shard is checked against it as it arrives, so a tampered or missing piece is caught before anything is decrypted." },
	{ t: "Revoke by re-keying", d: "Rotate the key and republish the manifest; links you already shared resolve to shards they can no longer decrypt. Optional expiry can be baked into the deal." },
];

const toneBorder = { hair: "border-hair", verify: "border-verify", slash: "border-slash", warn: "border-warn", signal: "border-signal" };
const toneTag = {
	verify: "text-verify bg-verify-soft border-verify/20",
	warn: "text-warn bg-warn-soft border-warn/20",
	slash: "text-slash bg-slash-soft border-slash/20",
	hair: "text-ink bg-paper-soft border-hair",
};

const eyebrow = "font-mono text-xs font-semibold uppercase tracking-widest text-signal mb-3.5";
const h2 = "text-3xl sm:text-4xl font-semibold tracking-tight text-ink mb-3.5";
const lede = "text-muted max-w-xl mb-10 text-[17px] leading-relaxed";
const section = "py-20 sm:py-22 border-t border-dashed border-hair";
const wrap = "max-w-[1120px] mx-auto px-6";
const card = "border border-hair rounded-xl p-5";
const noteGrid = "grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4";

let sectionCount = 0;
const sec = (label) => `§${idx(++sectionCount)} — ${label}`;

const nav = [
	{ href: "#plain", label: "How it works" },
	{ href: "#market", label: "Market" },
	{ href: "#scoring", label: "Reputation" },
	{ href: "#sla", label: "SLA" },
	{ href: "#tech", label: "Tech" },
	{ href: "#share", label: "Share" },
];
