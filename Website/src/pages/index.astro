          "item": "https://snazzie.space/#stack"
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": "Projects",
          "item": "https://snazzie.space/#projects"
        },
        {
          "@type": "ListItem",
          "position": 5,
