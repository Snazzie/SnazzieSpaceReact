---
import { getImage } from "astro:assets";
import "@/styles/global.css";
import { CursorField } from "@/components/CursorField";
import { Nav } from "@/components/Nav";
import { Intro } from "@/components/Intro";
import { Career } from "@/components/Career";
import { TechStack } from "@/components/TechStack";
import { Projects } from "@/components/Projects";
import { GithubStats } from "@/components/GithubStats";
import { Traffic } from "@/components/Traffic";
import { HireMe } from "@/components/HireMe";
import { LatestArticles, type ArticleTeaser } from "@/components/LatestArticles";
import { getCollection } from 'astro:content';
import { github, type GithubProfile } from "@/data/github";
import { traffic, type TrafficData } from "@/data/traffic";

import raceiqImg from "@/assets/logos/raceiq.png";
import cloudcatImg from "@/assets/logos/cloudcat.png";
import btmImg from "@/assets/logos/btm.png";
import mediaImg from "@/assets/logos/mediaontauri.png";
import avatarImg from "@/assets/avatar.png";
import shotImg from "@/assets/smartdos-screenshot.png";
import darkthemehubImg from "@/assets/darkthemehub.png";
import vitalImg from "@/assets/vital.png";

const WORKER_BASE =
  (import.meta.env.PUBLIC_GITHUB_STATS_URL as string | undefined)?.replace(/\/ghstats$/, "") ??
  "https://snazzie-github-stats.snazzieops.workers.dev";

async function safeFetch<T>(url: string, fallback: T): Promise<T> {
  try {
    const res = await fetch(url);
    if (!res.ok) return fallback;
    return (await res.json()) as T;
  } catch {
    return fallback;
  }
}

const [githubProfile, trafficData] = await Promise.all([
  safeFetch<GithubProfile>(`${WORKER_BASE}/ghstats`, github),
  safeFetch<TrafficData>(`${WORKER_BASE}/analytics`, traffic),
]);

const rawArticles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const latestArticles: ArticleTeaser[] = rawArticles.map((p) => ({
  slug: p.id,
  title: p.data.title,
  excerpt: p.data.excerpt,
  date: p.data.date,
  tags: p.data.tags,
}));

// Astro-optimized webp variants, keyed by the raw URL used in the data files.
const opt = (src: ImageMetadata, width: number) =>
  getImage({ src, format: "webp", width });
const [raceiq, cloudcat, btm, media, avatar, shot, darkthemehub, vital] =
  await Promise.all([
    opt(raceiqImg, 256),
    opt(cloudcatImg, 256),
    opt(btmImg, 256),
    opt(mediaImg, 256),
    opt(avatarImg, 576),
    opt(shotImg, 1024),
    opt(darkthemehubImg, 256),
    opt(vitalImg, 256),
  ]);
const avatarUrl = "https://avatars.githubusercontent.com/u/19627023?v=4";
const images: Record<string, string> = {
  "/logos/raceiq.png": raceiq.src,
  "/logos/cloudcat.png": cloudcat.src,
  "/logos/btm.png": btm.src,
  "/logos/mediaontauri.png": media.src,
  [avatarUrl]: avatar.src,
  "https://raw.githubusercontent.com/Snazzie/smartdos/master/assets/screenshot.png":
    shot.src,
  "https://avatars2.githubusercontent.com/u/55282763?s=400&v=4": darkthemehub.src,
  "https://avatars.githubusercontent.com/u/98346237?s=200&v=4": vital.src,
};
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Aaron Cooper - Full-Stack Software Engineer | React, TypeScript</title>
    <meta
      name="description"
      content="Full-stack software engineer specializing in React, TypeScript, and cloud infrastructure. Building scalable applications with focus on performance and clean systems."
    />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://snazzie.space/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="profile" href="https://linkedin.com/in/cooper-a-m/" />
    <link rel="me" href="https://github.com/snazzie" />

    <meta property="og:title" content="Aaron Cooper - Full-Stack Software Engineer" />
    <meta property="og:description" content="React, TypeScript, Rust, and cloud infrastructure developer. Building scalable applications with focus on performance." />
    <meta property="og:url" content="https://snazzie.space/" />
    <meta property="og:image" content="https://avatars.githubusercontent.com/u/19627023?v=4" />
    <meta property="og:type" content="profile" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Aaron Cooper - Full-Stack Engineer" />
    <meta name="twitter:description" content="Building scalable applications with React, TypeScript, and cloud infrastructure." />
    <meta name="twitter:image" content="https://avatars.githubusercontent.com/u/19627023?v=4" />

    <meta name="theme-color" content="#0a0a0a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="apple-touch-icon" href="https://avatars.githubusercontent.com/u/19627023?v=4" />
    <link rel="manifest" href="/manifest.json" />

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Aaron Cooper",
      "alternateName": "Snazzie",
      "jobTitle": "Full-Stack Software Engineer",
      "url": "https://snazzie.space",
      "image": "https://avatars.githubusercontent.com/u/19627023?v=4",
      "sameAs": [
        "https://github.com/snazzie",
        "https://linkedin.com/in/cooper-a-m/"
      ],
      "knowsAbout": [
        "React",
        "TypeScript",
        "Rust",
        "Cloud Architecture",
        "Full-Stack Development",
        "Kubernetes",
        "Cloudflare Workers",
        "AI Agents"
      ]
    }
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Aaron Cooper - Full-Stack Software Engineer",
      "url": "https://snazzie.space",
      "description": "Full-stack software engineer specializing in React, TypeScript, and cloud infrastructure",
      "author": {
        "@type": "Person",
        "name": "Aaron Cooper"
      }
    }
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      "name": "Aaron Cooper - Portfolio",
      "url": "https://snazzie.space",
      "description": "Professional portfolio showcasing full-stack development projects and expertise",
      "author": {
        "@type": "Person",
        "name": "Aaron Cooper",
        "url": "https://snazzie.space"
      }
    }
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://snazzie.space/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Career",
          "item": "https://snazzie.space/#career"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Tech Stack",
          "item": "https://snazzie.space/#stack"
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": "Projects",
          "item": "https://snazzie.space/#projects"
        },
        {
          "@type": "ListItem",
          "position": 5,
          "name": "GitHub Stats",
          "item": "https://snazzie.space/#github"
        }
      ]
    }
    </script>
    <script is:inline>
      (function () {
        var h = window.innerHeight;
        document.documentElement.style.setProperty("--vh", h + "px");
        var lastW = window.innerWidth;
        window.addEventListener("resize", function () {
          if (window.innerWidth !== lastW) {
            lastW = window.innerWidth;
            document.documentElement.style.setProperty("--vh", window.innerHeight + "px");
          }
        });
      })();
    </script>
  </head>
  <body class="relative bg-background text-foreground antialiased [overflow-x:clip]">
    <CursorField client:idle />
    <Nav client:load role="navigation" aria-label="Main navigation" />
    <main role="main">
      <Intro client:visible avatarSrc={images[avatarUrl]} />
      <Career client:visible />
      <TechStack client:only="react" />
      <Projects client:visible images={images} />
      <GithubStats client:visible initialProfile={githubProfile} />
      <Traffic client:visible initialData={trafficData} />
      <HireMe client:visible />
      <LatestArticles articles={latestArticles} />
    </main>
  </body>
</html>
