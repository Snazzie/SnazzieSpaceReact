---
import "@/styles/global.css";
import { CursorField } from "@/components/CursorField";
import { Nav } from "@/components/Nav";
import { Intro } from "@/components/Intro";
import { Quote } from "@/components/Quote";
import { Career } from "@/components/Career";
import { TechStack } from "@/components/TechStack";
import { Projects } from "@/components/Projects";
import { GithubStats } from "@/components/GithubStats";
import { HireMe } from "@/components/HireMe";
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Snazzie</title>
    <meta
      name="description"
      content="Aaron (Snazzie), software developer. Projects: Lunar Portfolio, RaceIQ, CloudCat and more."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="relative bg-background text-foreground antialiased">
    <CursorField client:idle />
    <Nav client:load />
    <main>
      <Intro client:load />
      <Quote client:visible />
      <Career client:visible />
      <TechStack client:visible />
      <Projects client:visible />
      <GithubStats client:visible />
      <HireMe client:visible />
    </main>
  </body>
</html>
