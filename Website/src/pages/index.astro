    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Snazzie",
      "url": "https://snazzie.space",
      "logo": "https://snazzie.space/favicon.svg",
      "founder": {
        "@type": "Person",
        "name": "Aaron Cooper",
        "sameAs": ["https://github.com/snazzie", "https://linkedin.com/in/cooper-a-m/"]
