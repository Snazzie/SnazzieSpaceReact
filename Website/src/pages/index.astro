---
import { getImage } from "astro:assets";
import "@/styles/global.css";
import Footer from "@/components/Footer.astro";
import BaseHead from "@/components/BaseHead.astro";
import { Nav } from "@/components/Nav";
import { Intro } from "@/components/Intro";
import { Career } from "@/components/Career";
import { TechStack } from "@/components/TechStack";
import { Projects } from "@/components/Projects";
import { GithubStats } from "@/components/GithubStats";
import { Traffic } from "@/components/Traffic";
import { HireMe } from "@/components/HireMe";
import { LatestArticles, type ArticleTeaser } from "@/components/LatestArticles";
import { getCollection } from 'astro:content';
import { github, type GithubProfile } from "@/data/github";
import { traffic, type TrafficData } from "@/data/traffic";

import raceiqImg from "@/assets/logos/raceiq.png";
import cloudcatImg from "@/assets/logos/cloudcat.png";
import btmImg from "@/assets/logos/btm.png";
import mediaImg from "@/assets/logos/mediaontauri.png";
import avatarImg from "@/assets/avatar.webp";
import shotImg from "@/assets/smartdos-screenshot.png";
import darkthemehubImg from "@/assets/darkthemehub.png";
import vitalImg from "@/assets/vital.png";

const WORKER_BASE =
  (import.meta.env.PUBLIC_GITHUB_STATS_URL as string | undefined)?.replace(/\/ghstats$/, "") ??
  "https://snazzie-github-stats.snazzieops.workers.dev";

async function safeFetch<T>(url: string, fallback: T): Promise<T> {
  try {
    const res = await fetch(url);
    if (!res.ok) return fallback;
    return (await res.json()) as T;
  } catch {
    return fallback;
  }
}

const [githubProfile, trafficData] = await Promise.all([
  safeFetch<GithubProfile>(`${WORKER_BASE}/ghstats`, github),
  safeFetch<TrafficData>(`${WORKER_BASE}/analytics`, traffic),
]);

const allArticles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featured = allArticles.find((a) => a.data.featured);
const latest = allArticles.filter((a) => !a.data.featured).slice(0, featured ? 2 : 3);
const rawArticles = featured ? [featured, ...latest] : latest;

const latestArticles: ArticleTeaser[] = rawArticles.map((p) => ({
  slug: p.id,
  title: p.data.title,
  excerpt: p.data.excerpt,
  date: p.data.date.toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" }),
  tags: p.data.tags,
}));

// Astro-optimized webp variants, keyed by the raw URL used in the data files.
const opt = (src: ImageMetadata, width: number) =>
  getImage({ src, format: "webp", width });
const [raceiq, cloudcat, btm, media, avatar, shot, darkthemehub, vital] =
  await Promise.all([
    opt(raceiqImg, 256),
    opt(cloudcatImg, 256),
    opt(btmImg, 256),
    opt(mediaImg, 256),
    opt(avatarImg, 576),
    opt(shotImg, 1024),
    opt(darkthemehubImg, 256),
    opt(vitalImg, 256),
  ]);
const avatarUrl = "/images/avatar.webp";
const ogImage = `https://snazzie.space${avatar.src}`;
const images: Record<string, string> = {
  "/logos/raceiq.png": raceiq.src,
  "/logos/cloudcat.png": cloudcat.src,
  "/logos/btm.png": btm.src,
  "/logos/mediaontauri.png": media.src,
  [avatarUrl]: avatarImg.src,
  "https://raw.githubusercontent.com/Snazzie/smartdos/master/assets/screenshot.png":
    shot.src,
  "https://avatars2.githubusercontent.com/u/55282763?s=400&v=4": darkthemehub.src,
  "https://avatars.githubusercontent.com/u/98346237?s=200&v=4": vital.src,
};
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <BaseHead
      title="Aaron Cooper - Full-Stack Software Engineer | React, TypeScript"
      description="Full-stack software engineer specializing in React, TypeScript, and cloud infrastructure. Building scalable applications with focus on performance and clean systems."
      path="/"
      ogType="profile"
      image={ogImage}
      ogTitle="Aaron Cooper - Full-Stack Software Engineer"
      ogDescription="React, TypeScript, Rust, and cloud infrastructure developer. Building scalable applications with focus on performance."
      twitterTitle="Aaron Cooper - Full-Stack Engineer"
      twitterDescription="Building scalable applications with React, TypeScript, and cloud infrastructure."
    />
    <link rel="preload" as="image" href="/images/avatar.webp" fetchpriority="high" />
    <meta name="google-adsense-account" content="ca-pub-8304271204200662" />
    <link rel="profile" href="https://linkedin.com/in/cooper-a-m/" />
    <link rel="me" href="https://github.com/snazzie" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
