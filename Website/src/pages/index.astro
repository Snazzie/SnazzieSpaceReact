  </head>
  <body class="relative bg-background text-foreground antialiased [overflow-x:clip]">
    <Nav client:idle role="navigation" aria-label="Main navigation" />
    <main role="main">
      <Intro client:visible avatarSrc={images[avatarUrl]} />
      <Career client:visible />
      <TechStack client:visible />
      <Projects client:visible images={images} />
      <GithubStats client:visible initialProfile={githubProfile} />
      <Traffic client:visible initialData={trafficData} />
      <HireMe client:visible />
      <LatestArticles client:visible articles={latestArticles} />
    </main>

    <Footer />

    {/* After the page loads, proactively fetch every below-fold image into the
        HTTP cache during idle time, so slow-connection users don't hit an empty
        box when they scroll. Warming the off-DOM cache (not the live elements)
        survives React island hydration. Skipped under Save-Data. */}
    <script is:inline>
      (() => {
        if (navigator.connection && navigator.connection.saveData) return;
        const warm = () => {
          for (const img of document.querySelectorAll('img[loading="lazy"]')) {
            if (img.complete || (!img.src && !img.srcset)) continue;
            const pre = new Image();
            if (img.sizes) pre.sizes = img.sizes;
            if (img.srcset) pre.srcset = img.srcset;
            if (img.src) pre.src = img.src;
          }
        };
        const schedule = () =>
          "requestIdleCallback" in window
            ? requestIdleCallback(warm, { timeout: 3000 })
            : setTimeout(warm, 1200);
        if (document.readyState === "complete") schedule();
        else addEventListener("load", schedule, { once: true });
      })();
    </script>
  </body>
</html>
