---
import '@/styles/global.css';
import RadioStation from '@/components/RadioStation';
import { EPISODES, CAST } from '@/data/radio';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Snazzie FM — Radio</title>
    <meta name="description" content="Snazzie FM: absurdist radio conversations, GTA-style." />
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <div class="mx-auto max-w-4xl px-4 py-16">
      <div class="mb-8">
        <div class="text-[10px] font-semibold tracking-[3px] text-[#ff6b00] mb-2">📻 SNAZZIE FM</div>
        <h1 class="text-2xl font-bold text-white">The Radio</h1>
        <p class="mt-1 text-sm text-white/40">Fictional radio. Real diabolical energy.</p>
      </div>
      <RadioStation client:load episodes={EPISODES} cast={CAST} />
    </div>
  </body>
</html>
