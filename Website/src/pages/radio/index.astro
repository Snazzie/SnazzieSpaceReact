---
import '@/styles/global.css';
import RadioLanding from '@/components/RadioLanding';
import { EPISODES, MUSIC_TRACKS, CAST } from '@/data/radio';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Snazzie FM — 88.5 — All-Night Radio</title>
    <meta name="description" content="Snazzie FM 88.5: absurdist all-night call-in radio. Tune in to the show lineup, meet the talent, listen live." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Monoton&family=Bebas+Neue&family=VT323&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-background text-foreground">
    <RadioLanding client:load episodes={EPISODES} music={MUSIC_TRACKS} cast={CAST} />
  </body>
</html>
