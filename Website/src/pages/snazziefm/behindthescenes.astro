---
import '@/styles/global.css';
import RadioStation from '@/components/RadioStation';
import { EPISODES, ADS, CAST } from '@/data/radio';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Snazzie FM — Radio</title>
    <meta name="description" content="Snazzie FM: absurdist radio conversations, GTA-style." />
  <style>html,body{background:#0a0704;}</style>
  </head>
  <body class="h-screen overflow-hidden bg-background text-foreground flex flex-col">
    <RadioStation client:load episodes={EPISODES} ads={ADS} cast={CAST} />
  </body>
</html>
