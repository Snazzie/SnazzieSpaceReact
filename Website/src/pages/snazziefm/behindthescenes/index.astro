---
import '@/styles/global.css';
import BaseHead from '@/components/BaseHead.astro';
import Footer from '@/components/Footer.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Snazzie FM — Behind the Scenes"
      description="How Snazzie FM was built: the data model, TTS pipeline, audio engine, and scheduling system behind the fictional radio station."
      path="/snazziefm/behindthescenes/"
      image="/snazziefm/images/radio-card.png"
      twitterCard="summary_large_image"
    />
    <style>html,body{background:#0a0704;}</style>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://snazzie.space/" },
        { "@type": "ListItem", "position": 2, "name": "Snazzie FM", "item": "https://snazzie.space/snazziefm/" },
        { "@type": "ListItem", "position": 3, "name": "Behind the Scenes", "item": "https://snazzie.space/snazziefm/behindthescenes/" }
      ]
    })} />
  </head>
  <body class="min-h-screen bg-[#0a0704] text-foreground flex flex-col">
    <main class="flex-1 flex flex-col items-center justify-center px-6 py-24 gap-16">
      <div class="text-center">
        <nav aria-label="Breadcrumb" class="mb-3 flex items-center justify-center gap-2 text-xs text-white/40">
          <a href="/" class="hover:text-white/70 transition-colors">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/snazziefm/" class="hover:text-white/70 transition-colors">Snazzie FM</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page" class="text-white/70">Behind the Scenes</span>
        </nav>
        <p class="text-xs font-semibold uppercase tracking-widest text-white/30 mb-3">Snazzie FM</p>
        <h1 class="text-4xl font-bold text-white mb-4">Behind the Scenes</h1>
        <p class="text-white/50 max-w-md mx-auto text-sm leading-relaxed">
          A fictional radio station built on real engineering. See how it works, or explore the raw audio timeline.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 w-full max-w-2xl">
        <a
          href="/articles/how-snazziefm-works/"
          class="group flex flex-col gap-3 rounded-2xl border border-white/10 bg-white/[0.03] p-6 transition-all hover:border-white/20 hover:bg-white/[0.06]"
        >
          <div class="text-2xl">📖</div>
          <div>
            <div class="font-semibold text-white mb-1">Read the Article</div>
            <div class="text-sm text-white/40 leading-relaxed">
              How episodes are scripted, voiced, scheduled, and played back — the full stack.
            </div>
          </div>
          <div class="text-xs text-white/25 group-hover:text-white/40 transition-colors mt-auto pt-2">
            articles/how-snazziefm-works →
          </div>
        </a>

        <a
          href="/snazziefm/behindthescenes/timeline/"
          class="group flex flex-col gap-3 rounded-2xl border border-white/10 bg-white/[0.03] p-6 transition-all hover:border-white/20 hover:bg-white/[0.06]"
        >
          <div class="text-2xl">🎙️</div>
          <div>
            <div class="font-semibold text-white mb-1">Audio Timeline</div>
            <div class="text-sm text-white/40 leading-relaxed">
              The multitrack view — every speaker lane, timestamp, and clip laid out as it plays.
            </div>
          </div>
          <div class="text-xs text-white/25 group-hover:text-white/40 transition-colors mt-auto pt-2">
            behindthescenes/timeline →
          </div>
        </a>
      </div>

      <a href="/snazziefm/" class="text-xs text-white/20 hover:text-white/40 transition-colors">
        ← Back to Snazzie FM
      </a>
    </main>
    <Footer />
  </body>
</html>
