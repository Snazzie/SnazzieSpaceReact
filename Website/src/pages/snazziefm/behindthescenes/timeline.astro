---
import '@/styles/global.css';
import { RadioStation, EPISODES, ADS, CAST } from '@/projects/snazziefm';
import BaseHead from '@/components/BaseHead.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Snazzie FM — Audio Timeline"
      description="The multitrack audio timeline behind every Snazzie FM episode."
      path="/snazziefm/behindthescenes/timeline/"
      image="/snazziefm/images/radio-card.png"
      twitterCard="summary_large_image"
    />
  <style>html,body{background:#0a0704;}</style>
  </head>
  <body class="h-screen overflow-hidden bg-background text-foreground flex flex-col">
    <RadioStation client:idle episodes={EPISODES} ads={ADS} cast={CAST} />
  </body>
</html>
