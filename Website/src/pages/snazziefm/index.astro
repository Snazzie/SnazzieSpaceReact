---
import '@/styles/global.css';
import { RadioLanding, EPISODES, MUSIC_TRACKS, ADS, CAST } from '@/projects/snazziefm';
import BaseHead from '@/components/BaseHead.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Snazzie FM — All-Night Radio"
      description="Snazzie FM: absurdist all-night call-in radio. Tune in to the show lineup, meet the talent, listen live."
      path="/snazziefm/"
      image="/snazziefm/images/radio-card.png"
      twitterCard="summary_large_image"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Monoton&family=Bebas+Neue&family=VT323&display=swap"
      rel="stylesheet"
    />
  <style>html,body{background:#0a0704;}</style>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://snazzie.space/" },
        { "@type": "ListItem", "position": 2, "name": "Snazzie FM", "item": "https://snazzie.space/snazziefm/" }
      ]
    })} />
  </head>
  <body class="bg-background text-foreground">
    <RadioLanding client:load episodes={EPISODES} music={MUSIC_TRACKS} ads={ADS} cast={CAST} />
  </body>
</html>
