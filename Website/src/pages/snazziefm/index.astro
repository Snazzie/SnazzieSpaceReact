---
import '@/styles/global.css';
import RadioLanding from '@/components/RadioLanding';
import { EPISODES, MUSIC_TRACKS, CAST } from '@/data/radio';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Snazzie FM — All-Night Radio</title>
    <meta name="description" content="Snazzie FM: absurdist all-night call-in radio. Tune in to the show lineup, meet the talent, listen live." />
    <meta property="og:title" content="Snazzie FM — All-Night Radio" />
    <meta property="og:description" content="Snazzie FM: absurdist all-night call-in radio. Tune in to the show lineup, meet the talent, listen live." />
    <meta property="og:image" content="/images/radio/radio-card.png" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="/images/radio/radio-card.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Monoton&family=Bebas+Neue&family=VT323&display=swap"
      rel="stylesheet"
    />
  <style>html,body{background:#0a0704;}</style>
  </head>
  <body class="bg-background text-foreground">
    <RadioLanding client:load episodes={EPISODES} music={MUSIC_TRACKS} cast={CAST} />
  </body>
</html>
