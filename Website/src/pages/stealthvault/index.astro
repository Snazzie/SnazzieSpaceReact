---
import '@/styles/global.css';
import Consent from '@/components/Consent.astro';

const features = [
  {
    title: 'Encrypted at rest',
    body: 'Every photo and video is AES-encrypted on-device with a key wrapped by your passcode. The decryption key lives in memory only while the vault is unlocked, and is zeroed on lock.',
  },
  {
    title: 'Ad-blocking browser',
    body: 'A built-in WebView browser with two-layer ad and tracker blocking lets you import media straight from the web. History and bookmarks stay inside the encrypted vault.',
  },
  {
    title: 'Biometric unlock',
    body: 'Unlock with Face ID or fingerprint. Biometric data never leaves your device’s secure enclave, and a progressive lockout throttles failed passcode attempts.',
  },
  {
    title: 'Web portal',
    body: 'Spin up a local HTTP server and reach your vault from a laptop browser on the same Wi-Fi. PIN-gated, session-cookie auth — nothing routes through the internet.',
  },
  {
    title: 'Device-to-device sync',
    body: 'Move encrypted media between two devices over the local network with a 4-digit pairing code. Only the missing blobs transfer — no cloud, no servers.',
  },
  {
    title: 'Albums, tags & reels',
    body: 'Organize with albums and searchable tags, then browse a shuffled reels stream. Content-addressed storage de-dupes identical media automatically.',
  },
];

const navLinks = [
  { href: '#features', label: 'Features' },
  { href: '#get', label: 'Get the app' },
  { href: '/stealthvault/faq/', label: 'FAQ' },
  { href: '/stealthvault/privacy/', label: 'Privacy' },
  { href: '/stealthvault/terms/', label: 'Terms' },
];

// Play URL derives from the Android package id. The App Store numeric id is not
// minted until the first submission is accepted — left as a placeholder anchor
// until the listing goes live.
const PLAY_URL = 'https://play.google.com/store/apps/details?id=com.snazzie.stealthvault';
const APPSTORE_URL = '#';
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Consent />
    <title>StealthVault — Private encrypted media vault</title>
    <meta
      name="description"
      content="StealthVault is a private, encrypted-at-rest media vault with an ad-blocking browser, biometric unlock, a local web portal, and device-to-device sync. Nothing leaves your device."
    />
    <link rel="canonical" href="https://snazzie.space/stealthvault/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-black text-foreground antialiased">
    <!-- Own nav, linking to sub routes -->
    <header class="pointer-events-none fixed inset-x-0 top-0 z-50 flex justify-center pt-4 px-4">
      <nav
        class="pointer-events-auto flex items-center gap-1 rounded-full border border-white/10 bg-black/70 px-2 py-1.5 backdrop-blur-md w-full max-w-2xl"
      >
        <div class="flex items-center gap-2 px-3 text-sm font-semibold text-foreground shrink-0">
          <a href="/stealthvault/" aria-label="StealthVault, home" class="flex items-center gap-2">
            <span class="size-2 rounded-full bg-foreground" aria-hidden="true"></span>
            StealthVault
          </a>
        </div>
        <div class="ml-auto flex items-center gap-0.5">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="rounded-full px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-white/10 hover:text-foreground"
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </nav>
    </header>

    <main>
      <!-- Hero -->
      <section class="mx-auto max-w-3xl px-6 pb-20 pt-36 text-center">
        <img
          src="/images/stealthvault-icon.png"
          alt="StealthVault app icon"
          width="88"
          height="88"
          class="mx-auto mb-8 size-20 rounded-2xl border border-border shadow-lg"
        />
        <h1 class="text-balance text-4xl font-bold tracking-tight sm:text-5xl">
          Your media. Encrypted. On your device.
        </h1>
        <p class="mx-auto mt-5 max-w-xl text-balance text-lg text-muted-foreground leading-relaxed">
          StealthVault is a private, encrypted-at-rest media vault with a built-in ad-blocking
          browser, biometric unlock, a local web portal, and device-to-device sync. Nothing ever
          leaves your device unless you say so.
        </p>
        <div id="get" class="mt-9 flex scroll-mt-24 flex-wrap items-center justify-center gap-3">
          <a
            href={APPSTORE_URL}
            aria-label="Download on the App Store"
            class="inline-flex items-center gap-3 rounded-xl border border-white/15 bg-white/[0.04] px-5 py-3 transition-colors hover:bg-white/[0.08]"
          >
            <svg viewBox="0 0 384 512" class="size-7 fill-white" aria-hidden="true">
              <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C73.6 141.6 24 184.6 24 272c0 26.1 4.8 53.1 14.4 80.9 12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.1zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/>
            </svg>
            <span class="text-left">
              <span class="block text-[10px] uppercase tracking-wide text-muted-foreground">Download on the</span>
              <span class="block text-base font-semibold leading-tight text-foreground">App Store</span>
            </span>
          </a>
          <a
            href={PLAY_URL}
            target="_blank"
            rel="noopener"
            aria-label="Get it on Google Play"
            class="inline-flex items-center gap-3 rounded-xl border border-white/15 bg-white/[0.04] px-5 py-3 transition-colors hover:bg-white/[0.08]"
          >
            <svg viewBox="0 0 512 512" class="size-7" aria-hidden="true">
              <path fill="#00d3ff" d="M48 59.5C40.6 64.9 36 73.9 36 84.4v343.2c0 10.5 4.6 19.5 12 24.9l187-196.5L48 59.5z"/>
              <path fill="#ffce00" d="M349 256l-66-69.4-235 246.9c5.9 4.3 13.7 4.9 21.4.6L349 256z"/>
              <path fill="#00f076" d="M48 59.5l221.4 197.1L283 186.6 69.4 58.9C61.7 54.6 53.9 55.2 48 59.5z"/>
              <path fill="#f63449" d="M349 256l81.7-44.6c14.3-7.8 14.3-29 0-36.8L349 130l-66 69.6L349 256z"/>
            </svg>
            <span class="text-left">
              <span class="block text-[10px] uppercase tracking-wide text-muted-foreground">Get it on</span>
              <span class="block text-base font-semibold leading-tight text-foreground">Google Play</span>
            </span>
          </a>
        </div>
        <p class="mt-4 text-xs text-muted-foreground">iOS coming soon · Android available now</p>
      </section>

      <!-- Features -->
      <section id="features" class="mx-auto max-w-5xl scroll-mt-24 px-6 py-12">
        <div class="mb-10 text-center">
          <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Everything stays local</h2>
          <p class="mt-3 text-muted-foreground">Built for privacy from the first byte.</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            features.map((f) => (
              <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 transition-colors hover:border-white/20 hover:bg-white/[0.05]">
                <h3 class="text-base font-semibold text-foreground">{f.title}</h3>
                <p class="mt-2 text-sm text-muted-foreground leading-relaxed">{f.body}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Privacy summary -->
      <section id="privacy" class="mx-auto max-w-3xl scroll-mt-24 px-6 py-12">
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-8 sm:p-10">
          <h2 class="text-2xl font-bold tracking-tight">Privacy by design</h2>
          <p class="mt-4 text-muted-foreground leading-relaxed">
            Your vault content — photos, videos, albums, tags, and browsing data — is encrypted on
            your device and never transmitted to external servers. The web portal and device sync
            are opt-in, off by default, and run only over your local network.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href="/stealthvault/privacy/"
              class="text-sm font-semibold text-foreground underline underline-offset-4 transition-opacity hover:opacity-80"
            >
              Read the privacy policy →
            </a>
            <a
              href="/stealthvault/terms/"
              class="text-sm font-semibold text-foreground underline underline-offset-4 transition-opacity hover:opacity-80"
            >
              Read the terms of use →
            </a>
            <a
              href="/stealthvault/faq/"
              class="text-sm font-semibold text-foreground underline underline-offset-4 transition-opacity hover:opacity-80"
            >
              Security FAQ →
            </a>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer, also linking sub routes -->
    <footer class="mx-auto max-w-5xl px-6 py-12">
      <div
        class="flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 text-sm text-muted-foreground sm:flex-row"
      >
        <span>StealthVault · A <a href="/" class="text-foreground underline underline-offset-2 hover:opacity-80 transition-opacity">Snazzie</a> app</span>
        <nav class="flex items-center gap-5">
          <a href="/stealthvault/faq/" class="transition-colors hover:text-foreground">FAQ</a>
          <a href="/stealthvault/privacy/" class="transition-colors hover:text-foreground">Privacy</a>
          <a href="/stealthvault/terms/" class="transition-colors hover:text-foreground">Terms</a>
          <button type="button" data-cc="show-preferencesModal" class="cursor-pointer border-none bg-transparent p-0 text-inherit transition-colors hover:text-foreground">Cookie Preferences</button>
          <a href="mailto:acoop133@hotmail.com" class="transition-colors hover:text-foreground">Contact</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
