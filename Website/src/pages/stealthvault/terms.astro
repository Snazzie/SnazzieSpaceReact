---
import '@/styles/global.css';
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Terms of Use — StealthVault</title>
    <meta name="description" content="Terms of Use (EULA) for the StealthVault iOS and Android app." />
    <link rel="canonical" href="https://snazzie.space/stealthvault/terms/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex" />
  </head>
  <body class="bg-background text-foreground antialiased">
    <header class="pointer-events-none fixed inset-x-0 top-0 z-50 flex justify-center pt-4 px-4">
      <nav class="pointer-events-auto flex items-center gap-1 rounded-full border border-border bg-card/80 px-2 py-1.5 backdrop-blur-md w-full max-w-2xl">
        <div class="flex items-center gap-2 px-3 text-sm font-semibold text-foreground shrink-0">
          <a href="/stealthvault/" aria-label="StealthVault, home" class="flex items-center gap-2">
            <span class="size-2 rounded-full bg-foreground" aria-hidden="true"></span>
            StealthVault
          </a>
        </div>
        <div class="ml-auto flex items-center gap-0.5">
          <a href="/stealthvault/faq/" class="rounded-full px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-white/10 hover:text-foreground">FAQ</a>
          <a href="/stealthvault/privacy/" class="rounded-full px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-white/10 hover:text-foreground">Privacy</a>
          <a href="/stealthvault/terms/" class="rounded-full px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-white/10 hover:text-foreground">Terms</a>
        </div>
      </nav>
    </header>

    <main class="mx-auto max-w-2xl px-6 pb-24 pt-28">
      <div class="mb-8">
        <a href="/stealthvault/" class="text-sm text-muted-foreground hover:text-foreground transition-colors">← Back</a>
      </div>

      <h1 class="text-3xl font-bold tracking-tight mb-2">Terms of Use</h1>
      <p class="text-muted-foreground text-sm mb-10">StealthVault · Last updated June 15, 2026</p>

      <div class="prose prose-invert prose-sm max-w-none space-y-8 text-muted-foreground leading-relaxed">

        <section>
          <h2 class="text-lg font-semibold text-foreground mb-3">Agreement</h2>
          <p>
            By downloading or using StealthVault ("the app") you agree to these Terms of Use. If you do not agree, do not use the app. Apple's <a href="https://www.apple.com/legal/internet-services/itunes/dev/stdeula/" class="text-foreground underline underline-offset-2 hover:opacity-80 transition-opacity">Standard EULA</a> also applies to App Store distribution and is incorporated by reference.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-foreground mb-3">The Service</h2>
          <p>
            StealthVault is an on-device encrypted media vault. All content is stored locally on your device. You are solely responsible for the content you store and for keeping your passcode safe.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-foreground mb-3">Passcode &amp; Data Loss</h2>
          <p>
            Your content is encrypted with a key derived from your passcode. <strong class="text-foreground">If you forget your passcode, your data cannot be recovered</strong> — we do not hold keys or backups. You are responsible for any device backups.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-foreground mb-3">Acceptable Use</h2>
          <p>
            You agree not to use the app to store or distribute content that is illegal where you live. The app is a storage tool; you are responsible for your content.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-foreground mb-3">Subscriptions</h2>
          <ul class="list-disc list-inside space-y-1.5">
            <li>Some features require an auto-renewing subscription billed through your Apple or Google account.</li>
            <li>Subscriptions renew automatically unless cancelled at least 24 hours before the end of the current period.</li>
            <li>Manage or cancel anytime in your App Store / Google Play account settings.</li>
            <li>Payment is charged to your store account at confirmation of purchase. Restoring previous purchases is available in the app.</li>
          </ul>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-foreground mb-3">Disclaimer &amp; Limitation of Liability</h2>
          <p>
            The app is provided "as is" without warranties of any kind. To the maximum extent permitted by law, we are not liable for any loss of data or damages arising from use of the app.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-foreground mb-3">Changes</h2>
          <p>
            We may update these terms; continued use after changes constitutes acceptance.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-foreground mb-3">Contact</h2>
          <p>
            Questions? Email <a href="mailto:info@snazzie.space" class="text-foreground underline underline-offset-2 hover:opacity-80 transition-opacity">info@snazzie.space</a>.
          </p>
        </section>

      </div>
    </main>
  </body>
</html>
