---
import '@/styles/global.css';
import { WorthMyTime, WorthMyTimeTabs } from '@/projects/worthmytime';
import AdSenseLoader from '@/components/AdSenseLoader.astro';
import AdUnit from '@/components/AdUnit.astro';
import Consent from '@/components/Consent.astro';
import Footer from '@/components/Footer.astro';
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Consent />
    <title>Worth My Time — what a purchase really costs in work hours</title>
    <meta
      name="description"
      content="Turn your UK salary into a real take-home hourly rate (after Income Tax + National Insurance), then see how many hours of work any purchase actually costs you."
    />
    <link rel="canonical" href="https://snazzie.space/worthmytime/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:title" content="Worth My Time — what a purchase really costs in work hours" />
    <meta
      property="og:description"
      content="Money is stored hours. Turn your UK take-home pay into a real hourly rate and see how many hours of work any purchase actually costs."
    />
    <meta property="og:url" content="https://snazzie.space/worthmytime/" />
    <meta property="og:image" content="https://snazzie.space/wmt-og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Worth My Time — what a purchase really costs in work hours" />
    <meta
      name="twitter:description"
      content="Money is stored hours. Turn your UK take-home pay into a real hourly rate and see how many hours of work any purchase actually costs."
    />
    <meta name="twitter:image" content="https://snazzie.space/wmt-og.png" />
    <AdSenseLoader />
    <style is:global>
      @keyframes wmt-scroll-up {
        from { transform: translateY(0); }
        to { transform: translateY(-50%); }
      }
      @keyframes wmt-scroll-down {
        from { transform: translateY(-50%); }
        to { transform: translateY(0); }
      }
      @keyframes wmt-scroll-left {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
      }
      .wmt-marquee-up { animation: wmt-scroll-up 32s linear infinite; }
      .wmt-marquee-down { animation: wmt-scroll-down 32s linear infinite; }
      .wmt-marquee-left { animation: wmt-scroll-left 90s linear infinite; }
      .wmt-marquee-up:hover,
      .wmt-marquee-down:hover,
      .wmt-marquee-left:hover { animation-play-state: paused; }
      @media (prefers-reduced-motion: reduce) {
        .wmt-marquee-up, .wmt-marquee-down, .wmt-marquee-left { animation: none; }
      }
    </style>
  </head>
  <body class="bg-black text-foreground antialiased">
    <!-- Nav -->
    <header class="pointer-events-none fixed inset-x-0 top-0 z-50 flex justify-center pt-4 px-4">
      <nav
        class="pointer-events-auto flex items-center gap-1 rounded-full border border-white/10 bg-black/70 px-2 py-1.5 backdrop-blur-md w-full max-w-2xl"
      >
        <div class="flex items-center gap-2 px-2 sm:px-3 text-sm font-semibold text-foreground shrink-0">
          <a href="/worthmytime/" aria-label="Worth My Time, home" class="flex items-center gap-2">
            <span class="size-2 rounded-full bg-foreground" aria-hidden="true"></span>
            <span class="hidden sm:inline">Worth My Time</span>
          </a>
        </div>
        <div class="mx-auto">
          <WorthMyTimeTabs client:load />
        </div>
        <div class="ml-auto flex items-center gap-0.5">
          <a
            href="/"
            class="rounded-full px-2 sm:px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-white/10 hover:text-foreground"
          >
            Snazzie
          </a>
        </div>
      </nav>
    </header>

    <main>
      <!-- Hero + calculator (hero copy switches per tab, so it lives in the island) -->
      <section class="mx-auto max-w-[112rem] px-6 pb-16 pt-36">
        <WorthMyTime client:load />
      </section>

      <!-- Assumptions -->
      <section class="mx-auto max-w-3xl px-6 pb-20">
        <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-6 sm:p-8">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">
            The small print
          </h2>
          <ul class="mt-4 space-y-2 text-sm text-muted-foreground leading-relaxed">
            <li>
              · <strong class="text-foreground">Take-home mode</strong> uses the net figure you enter
              directly — already after tax, NI, pension, and any other deductions. Most accurate.
            </li>
            <li>
              · <strong class="text-foreground">Gross mode</strong> estimates take-home from your
              pre-tax pay using 2025/26 rest-of-UK Income Tax (£12,570 allowance, tapered above £100k;
              20/40/45% bands) and Class 1 employee National Insurance (8% then 2%). Scotland's bands
              aren't modelled; no pension or student-loan deductions.
            </li>
            <li>
              · Either way we annualise over a <strong class="text-foreground">52-week</strong> year and
              divide by the weekly hours you enter to get your true hourly rate.
            </li>
            <li>· A rough guide, not financial advice. Your payslip is the source of truth.</li>
          </ul>
        </div>
      </section>

      <!-- Ad: replace slot with a real data-ad-slot from your AdSense dashboard -->
      <AdUnit class="mx-auto max-w-3xl px-6 my-8" slot="3853068378" />
    </main>

    <Footer />
  </body>
</html>
